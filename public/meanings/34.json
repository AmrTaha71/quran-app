","m":"سقط على وجهه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"دابة الأرض","m":"الأرضة والمنسأة العصا وكان قد"},{"t":"مات قائما متوكئا على عصاه فلما","m":"مات قائما متوكئا على عصاه فلما قرضتها الأرضة خر وذلك بعد سنة والجن يعملون ولا يعلمون بموته فعلموا بذلك أنهم لو علموا الغيب لما لبثوا في العذاب المهين"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"دابّة الأرض","m":"الأرضة التي تأكل الخشب"},{"t":"تأكل منسأته","m":"تـَـأْرضُ عصَاه"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لِسَبَإٍ","m":"قَبِيلَةٍ بِاليَمَنِ سُمُّوا بِاسْمِ جَدِّهِمْ."},{"t":"آيَةٌ","m":"دَلَالَةٌ عَلَى قُدْرَتِنَا."},{"t":"جَنَّتَانِ","m":"بُسْتَانَانِ."},{"t":"بَلْدَةٌ طَيِّبَةٌ","m":"كَرِيمَةُ التُّرْبَةِ، طَيِّبَةُ الهَوَاءِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وسبأ اسم القبيلة","m":"وسبأ اسم القبيلة"},{"t":"لقد كان لسبإ","m":"والمعنى وكان من حديثهم أنا جعلنا بينهم وبين القرى وهي قرى الشام"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لِـسَـبإ","m":"حيّ بمأرب باليمن"},{"t":"آية","m":"على قدرتنا أو عبرة و عِظة"},{"t":"جنّـتان","m":"بستانان أو جماعتان من البساتين"},{"t":"بلدة طيّبة","m":"زكيّة مُستـَـلَذة"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَيْلَ الْعَرِمِ","m":"السَّيْلَ الجَارِفَ الشَّدِيدَ الَّذِي خَرَّبَ السَّدَّ، وَأَغْرَقَ البَسَاتِينَ."},{"t":"ذَوَاتَى","m":"صَاحِبَتَيْ."},{"t":"أُكُلٍ خَمْطٍ","m":"ثَمَرٍ مُرٍّ، كَرِيهِ الطَّعْمِ."},{"t":"وَأَثْلٍ","m":"شَجَرٍ مَعْرُوفٍ شَبِيهٍ بِالطَّرْفَاءِ، لَا ثَمَرَ لَهُ."},{"t":"سِدْرٍ","m":"شَجَرِ النَّبَقِ، كَثِيرِ الشَّوْكِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"سَيْلَ الْعَرِمِ","m":"جمع عرمة، وهي سكر لأرض مرتفعة. وقيل:عرم: مسنّاة. وقيل: اسم الجرذ الذي نقب السّكر."},{"t":"أُكُلٍ خَمْطٍ","m":"قال أبو عبيدة: الخمط: كل شجر ذي شوك «