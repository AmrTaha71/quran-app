 حدثت بعد الأمور أمور هو بالتاء والواو: التناول، من نشت تنوش، قال الشاعر:باتت تنوش الحوض نوشا من علا ... نوشا به تقطع أجواز الفلا ومن همز فعند سيبويه: قلب الواو المضمومة همزة. وقيل: هو من ناش وأناش، إذا بطؤ. والنّيش: الحركة في إبطاء، قال الشاعر:تمنّى نئيشا ... البيت وقال ثعلب «7» : التّناوش، بغير همز: التّناول من قرب، وبالهمز: من بعد."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"آمنا به","m":"أي بالبعث"},{"t":"التناوش","m":"التناول لما يريدون المعنى كيف يتناولون الإيمان والتوبة وقد تركوا ذلك في الدنيا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"التـّـناوُش","m":"تناوُل الإيمان و التـّـوبة"}]}]},{"ayah":53,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَيَقْذِفُونَ بِالْغَيْبِ","m":"يَرْمُونَ بِالظُّنُونِ الكَاذِبَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وقد كفروا به","m":"بالبعث"},{"t":"ويقذفون بالغيب","m":"أي يرمون بالظن"},{"t":"من مكان بعيد","m":"وهو بعدهم عن العلم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يقذفون بالغيْب","m":"يرجمون بالظّـنون"}]}]},{"ayah":54,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِأَشْيَاعِهِم","m":"أَمْثَالِهِمْ مِنْ كُفَّارِ الأُمَمِ السَّابِقَةِ."},{"t":"مُّرِيبٍ","m":"مُحْدِثٍ لِلرِّيبَةِ وَالقَلَقِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وبين ما يشتهون","m":"وهو الرجوع إلى الدنيا"},{"t":"بأشياعهم","m":"بمن كان على مذهبهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بأشياعهم","m":"بأمثالهم من الكفّار"}]}]}]