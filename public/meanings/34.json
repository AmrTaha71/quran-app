ريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَفْتَرَى","m":"أَخْتَلَقَ؟"},{"t":"جِنَّةٌ","m":"جُنُونٌ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"افترى على الله كذبا","m":"هذا قول المشركين بعضهم لبعض فرد عليهم بقوله"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"به جـِـنّة","m":"به جنون يوهِمه ما يقول"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"نَخْسِفْ بِهِمُ","m":"نُغَيِّبْهُمْ فيِ الأَرْضِ."},{"t":"كِسَفًا","m":"قِطَعًا مِنَ العَذَابِ."},{"t":"مُّنِيبٍ","m":"رَاجِعٍ إِلَى رَبِّهِ بِالتَّوْبَةِ وَالطَّاعَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ما بين أيديهم وما خلفهم","m":"وذلك أن الإنسان حيث ما نظر رأى السماء والأرض قدامه وخلفه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تخسف بهم الأرض","m":"نغيّب بهم الأرض كقارون"},{"t":"كسَفا من السّماء","m":"قطعا منها كأصحاب الأيكة"},{"t":"منيب","m":"راجـِع إلى ربّه بالتـّوبة و الطاعة"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَضْلًا","m":"نُبُوَّةً، وَعِلْمًا، وَكِتَابًا وَمُلْكًا."},{"t":"أَوِّبِي مَعَهُ","m":"سَبِّحِي مَعَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَوِّبِي مَعَهُ","m":"سبّحي. والتّأويب: سير النّهار، فكأنّ المعنى:سبّحي نهارك كلّه معه، كتأويب السائر نهاره كلّه. وقيل: أوّبي: سبّحي بلسان الحبشة  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فضلا","m":"وهو النبوة"},{"t":"أوبي","m":"رجعي"},{"t":"معه","m":"التسبيح"},{"t":"والطير","m":"منصوب عطفا على"},{"t":"آتينا","m":"والمعنى وسخرنا له الطير"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أوّبي معه","m":"سَبّحِي أو رَجّعي معه التسبيح"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَابِغَاتٍ","m":"دُرُوعًا تَامَّاتٍ وَاسِعَاتٍ."},{"t":"وَقَدِّرْ فِي السَّرْدِ","m":"قَدِّرِ المَسَامِيرَ فيِ حِلَقِ الدُّرُوعِ بِأَلَّا تَكُونَ الحِلَقُ صَغِيرَةً ضَعِيفَةً، وَلَا كَبِيرَةً ثَقِيلَةً."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"سابِغاتٍ","m":"أي دروعا واسعات طوالا."},{"t":"وَقَدِّرْ فِي السَّرْدِ","m":"أي نسج حلق الدّروع. ومنه قيل لصانع الدّروع: السّرّاد والزّرّاد، تبدل من السّين الزاي كما يقال: سراط وزراط  .والسّرد: الخرز أيضا. ويقال للإشفى مسرد ومسراد، والمعنى: لا تجعل مسمار الدّروع دقيقا فيقلق ولا غليظا فيقصم الحلق."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وقدر في السرد","m":"أي النسج أي اجعله على قدر الحاجة لا تجعل حلقه واسعة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"اعمل سابغات","m":"دُروعا واسعةً كاملة"},{"t":"قدّر في السّرد","m":"أَحْكِم صَنعتك في نسج الدّروع"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"غُدُوُّهَا شَهْرٌ","m":"جَرَيَانُهَا مِنْ أَوَّلِ النَّهَارِ إِلَى انْتِصَافِهِ مَسِيرَةُ شَهْرٍ بِالسَّيْرِ المُعْتَادِ."},{"t":"وَرَوَاحُهَا شَهْرٌ","m":"جَرَيَانُهَا مِنْ مُنْتَصَفِ النَّهَارِ إِلَى اللَّيْلِ مَسِيرَةُ شَهْرٍ بِالسِّيْرِ المُعْتَادِ."},{"t":"وَأَسَلْنَا","m":"أَذَبْنَا."},{"t":"عَيْنَ الْقِطْرِ","m":"عَيْنَ النُّحَاسِ، فَيَسِيلُ لَهُ النُّحَاسُ كَالمَاءِ."},{"t":"يَزِغْ","m":"يَعْدِلْ، وَيَمِلْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَسَلْنا","m":"أذبنا، من قولك: سال الشيء وأسلته أنا."},{"t":"عَيْنَ الْقِطْرِ","m":"النّحاس، بلغة خثعم  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غدوها شهر ورواحها شهر","m":"أي تسير في يوم مسيرة شهرين"},{"t":"القطر","m":"النحاس وهو الصفر"},{"t":"ومن يزغ منهم","m":"أي يعدل {عن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"غّدوّها شهر","m":"جَرْيها بالغداة مسيرة شهر"},{"t":"رواحها شهر","m":"جَرْيُها بالعشيّ كذلك"},{"t":"عين القِطر","m":"عين النّحاس