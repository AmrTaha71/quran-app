[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبَّحَ لِلَّهِ","m":"نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِهِ جَلَّ جَلَالُهُ وَمَجَّدَهُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سبّـح لله","m":"نزّهَه و مَجّـدَهُ تعالى و دلّ عليه"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَهْلِ الْكِتَابِ","m":"هُمْ يَهُودُ بَنِي النَّضِيرِ."},{"t":"لِأَوَّلِ الْحَشْرِ","m":"فِي أَوَّلِ إِخْرَاجٍ، وَإِجْلَاءٍ إِلَى الشَّامِ."},{"t":"لَمْ يَحْتَسِبُوا","m":"لَمْ يَخْطُرْ لَهُمْ بِبَالٍ."},{"t":"وَقَذَفَ","m":"أَلْقَى."},{"t":"الرُّعْبَ","m":"الخَوْفَ الشَّدِيدَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لِأَوَّلِ الْحَشْرِ","m":"أوّل من حشر وأخرج من داره، وهو الجلاء."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أخرج الذين كفروا","m":"يعني يهود بني النضير"},{"t":"لأول الحشر","m":"وهذا كان أول حشرهم والحشر الثاني إلى أرض الحشر يوم القيامة"},{"t":"يخربون بيوتهم","m":"حاصرهم النبي صلى الله عليه وسلم وأصحابه وقاتلوهم وكان المسلمون رذا ظهروا علي دار من دورهم هدموها ليتسع لهم مكان للقتال وكانوا ينقبون دورهم فيخرجون إلى ما يليها"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الذين كفروا","m":"هو يهود بني النضير  قرب المدينة"},{"t":"لأوّل الحَشر","m":"في أول إخراج و إجلاء إلى الشام"},{"t":"فأتاهم الله","m":"فأتاهم أمره و عقابه"},{"t":"لمْ يحتسِبوا","m":"لم يظنوا و لم يخطر لهم ببَال"},{"t":"قذف","m":"ألقى و أنزل إنزالا شديدا"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْجَلَاءَ","m":"الخُرُوجَ مِنْ دِيَارِهِمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الجلاء","m":"خروجهم من أوطانهم"},{"t":"لعذبهم","m":"بالقتل والسبي كما فعل بقريظة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الجَلاء","m":"الخروج من الوَطن"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"شَاقُّوا","m":"خَالَفُوا أَشَدَّ المُخَالَفَةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يُشَاقِّ اللَّهَ","m":"أي يعاديه."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"شاقّوا","m":"عادَوْا و عَصَوْا و حادّوا"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لِّينَةٍ","m":"نَخْلَةٍ، أَوْ نَوْعٍ مِنَ النَّخْلِ."},{"t":"أُصُولِهَا","m":"سَاقِهَا."},{"t":"وَلِيُخْزِيَ","m":"لِيُذِلَّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مِنْ لِينَةٍ","m":"أي نخلة بلغة الأوس  ، وجمعها: لين. وهي ألوان النّخل ما لم تكن العجوة أو البرني  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ما قطعتم من لينة","m":"لما نزل بهم رسول الله صلى الله عليه وسلم فتحصنوا أمر بقطع نخيلهم وإحراقها فجزعوا وقالوا أمن الصلاح عقر الشجر وقطع النخيل فوجد المسلمون في أنفسهم من ذلك فنزلت الاية واللينة ألوان النخل كلها رلا العجوة والبراني"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لِـينة","m":"نخلة . أو نخلة كريمة"},{"t":"على أصولها","m":"على سوقها"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَمَا أَفَاء اللَّهُ","m":"وَمَا رَدَّهُ اللهُ مِنْ أَمْوَالِ بَنِي النَّضِيرِ، وَالفَيْءُ: مَا أُخِذَ مِنْ أَمْوَالِ الكُفَّارِ بِحَقٍّ، مِنْ غَيْرِ قِتَالٍ، وَالغَنِيْمَةُ: مَا أُخِذَ بِقِتَالٍ."},{"t":"فَمَا أَوْجَفْتُمْ","m":"فَلَمْ تَرْكَبُوا لِتَحْصِيلِهِ."},{"t":"رِكَابٍ","m":"مَا يُرْكَبُ مِنَ الإِبِلِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَوْجَفْتُمْ","m":"من الإيجاف، وهو السّير السّريع."},{"t":"رِكابٍ","m":"هي الإبل خاصة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فما أوجفتم","m":"الإيجاف الإيضاع وهو الإسراع في السير"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"و ما أفاء الله","m":"و ما ردّ و ما أعادَ"},{"t":"فما أوْجَفتم عليه","m":"فما أجْرَيتم على تحصيله"},{"t":"ركاب","m":"ما يُركب ن الإبل خاصّة"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَلِذِي الْقُرْبَى","m":"لِأَصْحَابِ قَرَابَةِ النَّبِيِّ - صلى الله عليه وسلم -."},{"t":"وَالْيَتَامَى","m":"الأَطْفَالِ الفُقَرَاءِ الَّذِينَ مَاتَ آبَاؤُهُمْ."},{"t":"وَابْنِ السَّبِيلِ","m":"الغَرِيبِ المُسَافِرِ الَّذِي نَفِدَتْ نَفَقَتُهُ، وَانْقَطَعَ عَنْهُ مَالُهُ."},{"t":"دُولَةً","m":"مُلْكًا مُتَدَاوَلًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"دُولَةً بَيْنَ الْأَغْنِياءِ مِنْكُمْ","m":"يقال: دولة ودولة لغتان  . ويقال: الدّولة أي بالضّم في المال، وبالفتح في الحرب. ويقال: الدّولة، بالضم: اسم الشيء الذي يتداول بعينه، والدّولة، بالفتح: الفعل. والمعنى: لئلا يتداوله الأغنياء بينهم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كي لا يكون","m":"يعني الفيء"},{"t":"دولة","m":"المعنى لئلا يتداوله الأغنياء بينهم فيغلبون الفقراء عليه ثم وصف المستحقين للحق فقال"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"دُولة بين الأغنياء","m":"مِلكا مُتداولا بينهم خاصة"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَبَوَّؤُوا الدَّارَ","m":"اسْتَوْطَنُوا المَدِينَةَ."},{"t":"حَاجَةً","m":"حَسَدًا."},{"t":"مِّمَّا أُوتُوا","m":"مِمَّا أُعْطُوا مِنْ مَالِ الفَيْءِ وَغَيْرِهِ."},{"t":"خَصَاصَةٌ","m":"حَاجَةٌ، وَفَقْرٌ."},{"t":"يُوقَ","m":"يُكْفَ وَيُجَنَّبْ."},{"t":"شُحَّ نَفْسِهِ","m":"الشُّحُّ: بُخْلٌ بِالمَالِ مَعَ حِرْصٍ عَلَيْهِ، وَتَطَلُّعٍ لِمَا بِيَدِ غَيْرِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَبَوَّؤُا الدَّارَ","m":"أي لزموها واتّخذوها مسكنا."},{"t":"وَالْإِيمانَ","m":"أي تمكّنوا في الإيمان واستقرّ في قلوبهم."},{"t":"حاجَةً","m":"أي فقرا ومحنة، ومحبّة أ