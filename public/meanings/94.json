[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَلَمْ نَشْرَحْ","m":"قَدْ وَسَّعْنَا بِنُورِ الإِسْلَامِ بَعْدَ الحَيْرَةِ وَالضِّيقِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ألم نشرحْ","m":"ألم نـُـفـسِـحْ بالحكمة و النبوّة – قد أفـْـسَحْـنا"},{"t":"و التين و الزيتون","m":"(قسمٌ) بِمنْـبـَتـَيـْهما من الأرض المباركة"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَوَضَعْنَا","m":"حَطَطْنَا، وَغَفَرْنَا."},{"t":"وِزْرَكَ","m":"ذَنْبَكَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"وَضَعْنا","m":"خَـفـّـفـنا عنك و سَـهّـلنا عـليك"},{"t":"ِوزرك","m":"حِمْـلك \"أعباءَ النبوّة و الرّسالة\""},{"t":"فانصبْ","m":"فاجْتهِدْ و أتـْـبعْها بعِبادة أخرى"},{"t":"و طور سِنين","m":"جَبَلِ المُناجاة ِللكَلِيم عليه السلام"}]}]}]