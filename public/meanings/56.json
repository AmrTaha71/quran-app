ت القرآن","author":"حسنين محمد مخلوف","words":[{"t":"رُجّت الأرض","m":"زلزلتْ وحُرّكت تحريكا بشدة"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَبُسَّتِ","m":"فُتِّتَتْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بُسَّتِ الْجِبالُ بَسًّا","m":"فتّتت بلغة كنانة  كالدّقيق والسّويق المبسوس، أي المبلول. قال لصّ من غطفان وأراد أن يخبز، فخاف أن يعجل عن الخبز فبلّ الدّقيق وأكله عجينا قال:لا تخبزا خبزا وبسّا بسّا"}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وبست","m":"فتتت"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بُسّت الجبال","m":"فـتـّـتْ كالسّويق المَـلْـتوت"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"هَبَاءً مُّنبَثًّا","m":"غُبَارًا مُتَطَايِرًا فِي الجَوِّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"هَباءً مُنْبَثًّا","m":"أي ترابا منتشرا. والهباء المنبثّ: ما يتقطع من سنابك الخيل، وهو من الهبوة أي الغبار."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"هباءً منبثـّـا","m":"غبارًا متفرقا منتشِرا"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَزْوَاجًا","m":"أَصْنَافًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أزواجا","m":"أصنافا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كنتم أزواجا","m":"أصنافا"}]}]},{"ayah":8,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْمَيْمَنَةِ","m":"والْمَشْئَمَةِ [9] : من اليمين والشّمال. ويقال: أصحاب الميمنة: الذين يعطون كتبهم بأيمانهم. وأصحاب المشأمة: الذين يعطون كتبهم بشمائلهم. والعرب يسمّون اليد اليسرى: الشّؤمى، والجانب الأيسر  : الأشأم، ومنه اليمن والشّؤم، فاليمن كأنه ما جاء عن اليمين، والشّؤم: ما جاء عن الشّمال.ومنه اليمن والشّأم، لأنهما يمين الكعبة وشمالها. ويقال: أصحاب الميمنة:أصحاب اليمن على أنفسهم، أي كانوا ميامين على أنفسهم. وأصحاب المشأمة: أي أصحاب الشّؤم على أنفسهم لأنهم كانوا مشائيم على أنفسهم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فأصحاب الميمنة","m":"وهم الذين منزلتهم عن اليمين"},{"t":"ما أصحاب الميمنة","m":"وهذا تعظيم لشأنهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فأصحاب الميمنة","m":"اليُـمْن و البركة . أو ناحية اليمين"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمَشْأَمَةِ","m":"الشِّمَالِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وأصحاب المشأمة","m":"هم أصحاب الشمال"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أصحاب المشأمة","m":"الشؤم . أو ناحية الشمال"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالسَّابِقُونَ","m":"الَّذِينَ يَسْبِقُونَ إِلَى الخَيْرَاتِ، وَيُسَارِعُونَ لِلطَّاعَاتِ."},{"t":"السَّابِقُونَ","m":"الَّذِينَ يَسْبِقُونَ إِلَى المَنَازِلِ العَالِيَةِ فِي الجَنَّةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والسابقون","m":"إلى الإيمان من كل أمة"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"ثُلَّةٌ","m":"جَمَاعَةٌ كَثِيرَةٌ."},{"t":"الْأَوَّلِينَ","m":"صَدْرِ هَذِهِ الأُمَّةِ وَغَيْرِهِمْ مِنَ الأُمَمِ الأُخْرَى."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ثُلَّةٌ","m":"جماعة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ثلة","m":"أي جماعة من الأولين الذين كانوا من زمن آدم إلى نبينا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ثـلـّـة","m":"هم أمّة من الناس كثيرة"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْآخِرِينَ","m":"آخِرِ هَذِهِ الأُمَّةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وقليل من الآخرين","m":"أي من هذه الأمة وقيل جماعة من الأولين أصحاب نبينا وقيل من تابعهم فيكون الكل من هذه الأمة"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَّوْضُونَةٍ","m":"مَنْسُوجَةٍ بِالذَّهَبِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مَوْضُونَةٍ","m":"منسوجة بعضها على بعض، كما توضن الدّرع بعضها في بعض مضاعفة. وفي التفسير: موضونة: منسوجة باليواقيت والجواهر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"موضونة","m":"منسوجة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سُرُر موضونة","m":"منسوجة من الذهب بإحكام"}]}]},{"ayah":17,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وِلْدَانٌ مُّخَلَّدُونَ","m":"غِلْمَانٌ لِلْخِدْمَةِ لَا يَهْرَمُونَ، وَلَا يَمُوتُونَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وِلْدانٌ مُخَلَّدُونَ","m":"أي مبقون ولدانا لا يهرمون ولا يتغيّرون.ويقال: مُخَلَّدُونَ: مسوّرون، ويقال: مقرّطون، ويقال: محلّون، ويقال لجماعة الحليّ: الخلد."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ولدان مُخلّدون","m":"مُبْـقون على هيئة الولدان في البهاء"}]}]},{"ayah":18,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِأَكْوَابٍ","m":"أَقْدَاحٍ لَا عُرَى لَهَا، وَلَا خَرَاطِيمَ."},{"t":"وَأَبَارِيقَ","m":"أَوَانٍ لَهَا عُرًى، وَخَرَاطِيمُ."},{"t":"وَكَاسٍ","m":"خَمْرٍ، أَوْ قَدَحٍ فِيهِ خَمْرٌ."},{"t":"مِّن مَّعِينٍ","m":"خَمْرٍ جَارِيَةٍ فِي الجَنَّةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَكَأْسٍ مِنْ مَعِينٍ","m":"أي من خمر يجري من العيون."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بأكواب","m":"أقداح لا عُرى لها و لا خراطيم"},{"t":"أباريق","m":"أوان لها عُرى و خراطيم"},{"t":"كأس","m":"خمْر أو 