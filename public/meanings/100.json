[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالْعَادِيَاتِ ضَبْحًا","m":"قَسَمٌ بِالخَيْلِ الجَارِيَةِ فِي سَبِيلِ اللهِ، حِينَ يَظْهَرُ صَوْتُهَا مِنْ سُرْعَةِ عَدْوِهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالْعادِياتِ ضَبْحاً","m":"الخيل. والضّبح: صوت أنفاس الخيل إذا عدون ألم تر إلى الفرس إذا عدا يقول: أجّ أجّ  ، يقال: ضبح الفرس والثعلب وما أشبههما. والضبح والضّبع أيضا: ضرب من العدو."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وهي القيامة","m":"وهي القيامة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ضَبْـحًا","m":"هُوَ صَوْتُ أنـْـفاسِها إذا عَدَتْ"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَالْمُورِيَاتِ قَدْحًا","m":"فَالمُوقِدَاتِ بِحَوَافِرِهَا النَّارَ مِنْ شِدَّةِ عَدْوِهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَالْمُورِياتِ قَدْحاً","m":"الخيل توري النار بسنابكها إذا وقعت على الحجارة."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فالموريات قـَـدْحا","m":"المُـخْرجات النار بصكّ حَوافِرها"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَالْمُغِيرَاتِ صُبْحًا","m":"فَالخَيْلِ الَّتِي تُغِيرُ وَتُبَاغِتُ العَدُوَّ صَبَاحًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَالْمُغِيراتِ صُبْحاً","m":"من الغارة وكانوا يغيرون عند الصبح. والإغارة:كبس الحيّ وهم غارّون لا يعلمون. وقيل إنها كانت سريّة لرسول الله صلّى الله عليه وسلّم إلى بني كنانة فأبطأ عليه خبرها فنزل عليه الوحي بخبرها في «العاديات» .وعن عليّ  - رضي الله عنه- أنه كان يقول: العاديات هي الإبل ويذهب إلى وقعة بدر، وقال: «ما كان معنا يومئذ إلا فرس عليه المقداد بن الأسود  » ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فالمغيرات صُبْحا","m":"المباغِتات للعدوّ وَقـْـتَ الصّباح"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَأَثَرْنَ","m":"فَهَيَّجْنَ."},{"t":"نَقْعًا","m":"غُبَارًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فأثرن به","m":"أي بالوادي ولم يذكر وإنما جاز هذا لأن الغبار لا يثأر إلا من موضع والنقع الغبار"},{"t":"والفراش ما يتهافت في النار من","m":"والفراش ما يتهافت في النار من البعوض"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فأثرْنَ به نقـْعًـا","m":"هـيّـجْنَ في الصّـبْح غبارًا"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَوَسَطْنَ بِهِ جَمْعًا","m":"فَتَوَسَّطْنَ بِرُكْبَانِهِنَّ جُمُوعَ الأَعْدَاءِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والعهن الصوف","m":"والعهن الصوف"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فَوَسَطنَ به جَمْعا","m":"فـتـَـوَسّـــْطنَ  فيه مِنَ الأعداء"},{"t":"لكـَـنـُـودٌ","m":"لـَـكفورٌ جَحودٌ"},{"t":"لشديدٌ","m":"لقويّ مُجدّ في تحصيله مُتـهالكٌ عليه"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بُعْثِرَ","m":"أُثِيرَ، وَأُخْرِجَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بُـعْـثِـرَ","m":"أُثير و أُخْرج و نـُـثِرَ"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَحُصِّلَ","m":"اُسْتُخْرِجَ، وَأُبْرِزَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وحصل","m":"ميز ما فيها من الخير والشر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حُصِّـل","m":"جُمِعَ و اُظْهِر أو مُـيّـزَ"},{"t":"مَاهِـيَهْ","m":"ما هيَ – و الهاء للسّكت"}]}]}]