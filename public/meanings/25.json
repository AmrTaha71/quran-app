{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كانَ غَراماً","m":"أي هلاكا، ويقال: ملحّا، ويقال: عذابا ملازما، ومنه: فلان مغرم بالنساء إذا كان يحبّهن ويلازمهن، ومنه: الغريم: الذي عليه الدّين لأن الدّين لازم له. والغريم أيضا الذي له الدّين لأنه يلزم الذي عليه الدّين. وقال الحسن: كل غريم مفارقه غريمه إلا النار."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غراما","m":"هلاكا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كان غراما","m":"لازما أو ممتدّا ، كلزوم الغريم"}]}]},{"ayah":67,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَقْتُرُوا","m":"يُضِيِّقُوا فِي النَّفَقَةِ."},{"t":"قَوَامًا","m":"وَسَطًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لم يسرفوا","m":"الإسراف الإنفاق في معصية الله والإقتار منع حق الله"},{"t":"قواما","m":"عدلا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لم يقتروا","m":"لم يُضيّقوا تضييق الأشحّاء"},{"t":"قواما","m":"عدلا وسطا بين الطّرفين"}]}]},{"ayah":68,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَثَامًا","m":"عِقَابًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَثاماً","m":"عقوبة. والأثام: الإثم أيضا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أثاما","m":"عقوبة وأنشدوا والعقوق له أثام"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يلقى أثاما","m":"عقابا و جزاء في الآخرة"}]}]},{"ayah":69,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُهَانًا","m":"ذَلِيلًا حَقِيرًا."}]}]},{"ayah":71,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَتَابًا","m":"رُجُوعًا صَحِيحًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فإنه يتوب إلى الله متابا","m":"المعنى من أراد حقيقة التوبة فينبغي أن يريد الله بها ولا يخلطها بما يفسدها كما تقول من أراد التجارة فليتجر في البز"}]}]},{"ayah":72,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا يَشْهَدُونَ الزُّورَ","m":"لَا يَشْهَدُونَ بِالكَذِبِ، وَلَا يَحْضُرُونَ مَجَالِسَ الكَذِبِ."},{"t":"مَرُّوا بِاللَّغْوِ","m":"مَرُّوا بِأَهْلِ البَاطِلِ وَالكَلَامِ القَبِيحِ وَمَا لَا يَنْفَعُ."},{"t":"كِرَامًا","m":"مُعْرِضِينَ مُنْكِرِينَ يَتَنَزَّهُونَ عَنْهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بِاللَّغْوِ","m":"أي الباطل من الكلام."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الزور","m":"الكذب وقيل الشرك"},{"t":"واللغو أذى المشركين لهم","m":"واللغو أذى المشركين لهم"},{"t":"كراما","m":"حلماء"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مرّوا باللغو","m":"بما ينبغي أن يُلغى و يُطرح"},{"t":"مرّوا كراما","m":"مُكرمين أنفسهم بالإعراض عنه"}]}]},{"ayah":73,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَمْ يَخِرُّوا","m":"لَمْ يَقَعُوا سُجُودًا غَافِلِينَ، بَلْ سَجَدُوا مُطِيعِينَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لم يخروا","m":"لم يسقطوا و لم يقعوا"}]}]},{"ayah":74,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"قُرَّةَ أَعْيُنٍ","m":"تَقَرُّ بِهِمْ عُيُونُنَا، وَبِهِمْ نَانَسُ وَنَفْرَحُ."},{"t":"إِمَامًا","m":"قُدْوَةً يُقْتَدَى بِه فِي الخَيْرِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"قرّة أعين","m":"مسرّة و فرحا"},{"t":"إماما","m":"قدوة و حجّة أو أئمّة"}]}]},{"ayah":75,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْغُرْفَةَ","m":"أَعْلَى مَنَازِلِ الجَنَّةِ."},{"t":"وَسَلَامًا","m":"تَسْلِيمًا مِنَ المَلَائِكَةِ، وَسَلَامَةً مِنَ الآفَاتِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الغرفة","m":"غرف الجنة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يُجزون الغرفة","m":"أعلى منازل الجنّة و أفضلها"}]}]},{"ayah":77,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَا يَعْبَأُ","m":"مَا يَكْتَرِثُ بِكُمْ وَلَا يُبَالِي."},{"t":"دُعَاؤُكُمْ","m":"عِبَادَتُكُمْ وَسُؤَالُكُمْ إِيَّاهُ."},{"t":"لِزَامًا","m":"عَذَابًا مُلَازِمًا لَكُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ما يَعْبَؤُا بِكُمْ","m":"ما يبالي بكم."},{"t":"لِزاماً","m":"مصدر لازمته، أي خيرا يلزم كل عامل  مما عمل من خير أو شرّ. ويقال: لِزاماً: أي هلاكا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ما يعبأ بكم","m":"أي ما يصنع بعذابكم"},{"t":"لولا دعاؤكم","m":"ما تدعونه من شريك وولد"},{"t":"فسوف يكون","m":"يعني العذاب"},{"t":"لزاما","m":"أي لازما لكم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ما يعبأ بكم","m":"ما يكترث و ما يبالي بكم"},{"t":"دعاؤكم","m":"عبادتكم له تعالى"},{"t":"يكون لزاما","m":"يكون جزاء تكذيبكم عذابا دائما مُلازما لكم"}]}]}]