[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَلَمْ تَرَ","m":"أَلَمْ تَعْلَمْ؟"},{"t":"بِأَصْحَابِ الْفِيلِ","m":"وَهُمْ: أَبْرَهَةُ الحَبَشِيُّ، وَجَيْشُهُ الَّذِينَ أَرَادُوا تَدْمِيرَ الكَعْبَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ألم تر","m":"ألم تخبر و"},{"t":"بأصحاب الفيل","m":"قوم قصدوا نقض الكعبة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بأصحاب الفـيل","m":"وَقـَـعَت القصّة أوّل عام مولده صلى الله عليه و سلم"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَيْدَهُمْ","m":"تَدْبِيرَهُمْ وَسَعْيَهُمْ لِتَخْرِيبِ الكَعْبَةِ."},{"t":"تَضْلِيلٍ","m":"تَضْيِيعٍ، وَإِبْطَالٍ، وَخَسَارٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَيْدَهُمْ","m":"أي مكرهم، وحيلتهم."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يَجْعَلْ كَيْدَهمْ","m":"سَعْـيَهمْ لتخْريب الكَعْـبَة"},{"t":"تـَـضْـليل","m":"تـَـضييع و إبْطال و خَسار"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَبَابِيلَ","m":"جَمَاعَاتٍ مُتَتَابِعَةً."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَبابِيلَ","m":"جماعات في تفرقة، أي حلقة بعد حلقة، واحدها إبّالة وإبّول وإبّيل. ويقال: هو جمع لا واحد له."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"طَيْرًا أبابيل","m":"جماعاتٍ مُتفرّقة  مُتتابعة"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سِجِّيلٍ","m":"طِينٍ مُتَحَجِّرٍ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"سجيل","m":"في هود حجر وطين والعصف في سورة الرحمن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سِجّـيـل","m":"طين مُـتحجّر مُحْرَق (آجُرٍّ )"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَعَصْفٍ مَّاكُولٍ","m":"مُحَطَّمِينَ؛ كَأَوْرَاقِ الزَّرْعِ اليَابِسَةِ الَّتِي أَكَلَتْهَا البَهَائِمُ، ثُمَّ رَمَتْ بِهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَعَصْفٍ","m":"العصف والعصيفة: ورق الزّرع."},{"t":"مَأْكُولٍ","m":"يعني أخذ ما فيه من الحبّ فأكل وبقي هو لا حبّ فيه.وفي الخبر: «أنّ الحجر كان يصيب أحدهم على رأسه فيجوّفه حتى يخرج من أسفله فيصير كقشر الحنطة  وقشر الأرزّ المجوّف» ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الحُطمة","m":"جَهنّم . لِحَطْمِها كلّ ما يُـلْـقى فيها"},{"t":"كَعَصْفٍ مأكول","m":"كَـتِـبْـنِ أكَلـتـْه الدّوابّ فراثـَتـْـه"}]}]}]