[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الأَنفَالِ","m":"الْغَنَائِمِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْأَنْفالِ","m":"الغنائم، واحدها نفل. والنّفل: الزّيادة. والأنفال مما زاده الله تعالى لهذه الأمّة في الحلال لأنه كان محرّما على من كان قبلهم، وبهذا سمّيت النافلة من الصلاة لأنها زيادة على الفرض. ويقال لولد الولد النافلة لأنه زيادة على الولد. وقيل في قوله تعالى: وَوَهَبْنا لَهُ إِسْحاقَ وَيَعْقُوبَ نافِلَةً  : إنه دعا بإسحاق فاستجيب له وزيد يعقوب، كأنه تفضّل من الله تعالى، وإن كان كل بتفضّله  ."},{"t":"ذاتَ بَيْنِكُمْ","m":"أي الحالة التي بينكم لتكون سببا لألفتكم واجتماع كلمتكم، وقيل: أموركم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يسألونك عن الأنفال","m":"وهي الغنائم والمعنى يسألونك عن حكمها"},{"t":"لله والرسول","m":"أي يحكمان فيها"},{"t":"فاتقوا الله","m":"بترك الخلاف"},{"t":"وأصلحوا ذات بينكم","m":"أي حقيقة وصلكم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الأنفال","m":"غنائم بدر"},{"t":"ذات بينكم","m":"أحوالكم التي يحصل بها اتّصالكم"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَجِلَتْ","m":"فَزِعَتْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَجِلَتْ قُلُوبُهُمْ","m":"خافت."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ذكر الله","m":"أي ذكرت عضمته"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"وجلت قلوبهم","m":"فزعت و رقّت استعظاما و هيبة"},{"t":"يتوكّلون","m":"يعتمدون و إلى الله يُفوّضون"}]}]},{"ayah":5,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كما أخرجك","m":"المعنى امض لامر الله في الغنائم وان كرهوا كما مضيت في خروجك من بيتك يوم بدر وهم كارهون"}]}]},{"ayah":6,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يجادلونك في الحق","m":"أي في القتال يم بدر لانهم خرجوا بلا عدة فكرهوا القتال بالطبع"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الطَّائِفَتِيْنِ","m":"عِيرِ قُرَيْشٍ، وَمَا تَحْمِلُهُ مِنْ أَرْزَاقٍ، أَوِ النَّفِيرِ لِقِتَالِهِمْ."},{"t":"ذَاتِ الشَّوْكَةِ","m":"صَاحِبَةِ السِّلَاحِ، وَالْقُوَّةِ."},{"t":"وَيَقْطَعَ","m":"يَسْتَاصِلَ."},{"t":"دَابِرَ الْكَافِرِينَ","m":"آخِرَهُمْ، وَالْمُرَادُ: جَمِيعُهُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ذاتِ الشَّوْكَةِ","m":"الحدّ والسّلاح  أي من السّيف والسّنان والنّصال. وقيل: الشوكة: شدّة الحرب. والشوكة: الحدة. واشتقاقها من الشّوك وهو النّبت الذي له حدّة."},{"t":"وَيَقْطَعَ دابِرَ الْكافِرِينَ","m":"أي يستأصلهم. والدابر: الأصل، وقيل:آخر من بقي."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إحدى الطائفتين","m":"ابو سفبان وما معه من المال وابوجهل ومن معه من قريش"},{"t":"ذات الشوكة","m":"ذات السلاح"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الطائفين","m":"هما العير و النّفير"},{"t":"ذات الشّوكة","m":"ذات السّلاح و القوّة . و هي النّفير"},{"t":"دابر الكافرين","m":"آخرهم و المراد جميعهم"}]}]},{"ayah":8,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلَوْ كَرِهَ الْمُجْرِمُونَ","m":"أي المذنبون."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بعد ما تبين","m":"لهم انك في الحق أي في القتال يم بدر لا تفعل الا ما تؤمر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لله و الرّسول","m":"مفوّضٌ إليهما أمرُها"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُرْدِفِينَ","m":"يَتْبَعُ بَعْضُهُمْ بَعْضًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مُرْدِفِينَ","m":"أردفهم الله بغيرهم  ومُرْدِفِينَ: رادفين،يقال: ردفته وأردفته إذا جئت بعده."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إذ تستغيثون","m":"لما نظر النبي صلى الله عليه وسلم الى قلة أصحابه يوم بدر جعل يقول اللهم انجز لي ما وعدتني فنزلت هذه الايه"},{"t":"مردفين","m":"وهم المتتابعون وقرأ نا فع بفتح الدال اراد فعل الله ذلك بهم أي اردف المسلمين بهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مُردفين","m":"مُتبِعا بعضهم بعضا آخر منهم"}]}]},{"ayah":10,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَما جَعَلَهُ اللَّهُ إِلَّا بُشْرى","m":"البشرى والبشارة: إخبار ما يسرّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وما جعله الله","m":"يعني المدد"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُغَشِّيكُمُ","m":"يُلْقِي النُّعَاسَ عَلَيْكُمْ؛ كَالْغِطَاءِ."},{"t":"أَمَنَةً","m":"أَمَانًا."},{"t":"رِجْزَ الشَّيْطَانِ","m":"وَسَاوِسَهُ وَتَخْوِيفَاتِهِ."},{"t":"وَلِيَرْبِطَ","m":"لِيَشُدَّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَمَنَةً","m":"مصدر أمنت أمنة وأمانا وأمنا، كلهن سواء."},{"t":"وَيُذْهِبَ عَنْكُمْ رِجْزَ الشَّيْطانِ","m":"أي لطخه وتخويفه وما يدعو إليه من الكفر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"رجز الشيطان","m":"وساوسه لانه وسوس اليهم قد غلبكم المشركون على الماء وانتم تزعمون انكم اولياء الله فأنزل الله المطر فشربوا وتطهروا"},{"t":"وليربط","m":"أي ليشد"},{"t":"على قلوبكم","m":"بالصبر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يغشّيكم النّعاس","m":"يجعله غاشيا عليكم كالغطاء"},{"t":"أمنة منه","m":"أمنا من الله و تقوية لكم"},{"t":"رجز الشّيطان","m":"وسوسته و تخويفه إياكم من العطش"},{"t":"ليربط","m":"يشدّ و يقوّي باليقين و الصّبر"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بَنَانٍ","m":"طَرَفٍ، وَمِفْصَلٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كُلَّ بَنانٍ","m":"أصابع، واحدها بنانة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فوق الأعناق","m":"يعني الرءوس"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أنِّي معكم","m":"مُعينكم على تثبيت المؤمنين"},{"t":"الرّعب","m":"الخوف و الفزع و الإنزعاج"},{"t":"كلّ بنان","m":"كلّ الأطراف أو كلّ مفصل"}]}]},{"ayah":13,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"اقُّوا اللَّهَ","m":"حاربوه وجانبوا دينه وطاعته. ويقال: شاقوا الله:صاروا في شقّ غير شقّ المؤمنين."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"شاقوا","m":"جانبوا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"شاقّوا","m":"خالفوا و عصوْا"}]}]},{"ayah":14,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ذلكم فذوقوه","m":"المعنى ذوقوا هذا في الدنيا"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"زَحْفًا","m":"مُتَقَارِبِينَ مِنْكُمْ، مُجْتَمِعِينَ؛ كَأَنَّهُمْ لِكَثْرَتِهِمْ يَزْحَفُونَ."},{"t":"الأَدْبَارَ","m":"الظُّهُورَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"إِذا لَقِيتُمُ الَّذِينَ كَفَرُوا زَحْفاً","m":"الزّحف: تقارب القوم إلى القوم في الحرب."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"زحفا","m":"جيشا زاحفا نحوكم لقتالكم"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُتَحَرِّفًا لِّقِتَالٍ","m":"مُظْهِرًا الْفِرَارَ؛ خِدْعَةً، ثُمَّ يَكُرُّ."},{"t":"مُتَحَيِّزًا إِلَى فِئَةٍ","m":"مُنْحَازًا إِلَى جَمَاعَةِ المُسْلِمِينَ؛ سَوَاءٌ كَانُوا سَرِيَّةً فَانْحَازُوا لِلجَيْشِ أَوِ انْحَازُوا لِلإِمَامِ الأَعْظَمِ."},{"t":"بَاءَ","m":"رَجَعَ."},{"t":"الْمَصِيرُ","m":"الْمَرْجِعُ، وَالْمَآلُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مُتَحَيِّزاً إِلى فِئَةٍ","m":"أي منضمّا إلى جماعة. يقال: تحوّز وتحيّز وانحاز بمعنى واحد."}]},{"nam