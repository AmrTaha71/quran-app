[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمُزَّمِّلُ","m":"أَصْلُهَا: المُتَزَمِّلُ، أَيِ: المُتَلَفِّفُ بِثِيَابِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْمُزَّمِّلُ","m":"الملتفّ في ثيابه، وأصله المتزمّل، فأدغمت التاء في الزاي."},{"t":"الْمُدَّثِّرُ","m":"أي المتدثّر بثيابه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"المزمل","m":"الملتف في ثيابه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"المزّمل","m":"المتلفّـف بثيابه (النبي صلى الله عليه و سلم)"}]}]},{"ayah":3,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"نصفه","m":"بدل من الليل"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَرَتِّلِ","m":"اقْرَا بِتُؤَدَةٍ وَتَمَهَّلٍ؛ مُبَيِّنًا الحُرُوفَ وَالوُقُوفَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَرَتِّلِ الْقُرْآنَ","m":"التّرتيل في القراءة: التّبيين لها كأنّه يفصل بين الحرف  والحرف، ومنه  قيل: ثغر رتل ورتل: إذا كان مفلّجا لم يلصق بعض الأسنان على بعض، ولا يركب بعضها بعضا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"رتـّـل القرآن","m":"اقرأه بتمهّل ، و تبْيين حروف"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"ثَقِيلًا","m":"عَظِيمًا، مُشْتَمِلًا عَلَى الأَوَامِرِ وَالنَّوَاهِي."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ثقيلا","m":"أي في فرضة وحكمه وقيل مهيبا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"قوْلاً ثقيلا","m":"شاقّـاعلى المكلـّـفـين"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"نَاشِئَةَ اللَّيْلِ","m":"العِبَادَةَ الَّتِي تَنْشَأُ فِي جَوْفِ اللَّيْلِ بَعْدَ النَّوْمِ."},{"t":"هِيَ أَشَدُّ وَطْئًا","m":"أَشَدُّ تَاثِيرًا فِي القَلْبِ."},{"t":"وَأَقْوَمُ قِيلًا","m":"أَبْيَنُ قَوْلًا؛ لِحُضُورِ القَلْبِ، وَقِلَّةِ الشَّوَاغِلِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ناشِئَةَ اللَّيْلِ","m":"ساعاته، من نشأت: أي ابتدأت."},{"t":"هي أشدّ وطاء","m":"أثبت قياما، يعني أن ناشئة اللّيل  أوطأ للقيام وأسهل على المصلّي من ساعات النهار لأنّ النهار خلق لتصرّف العباد فيه، والليل خلق للنّوم وللراحة والخلوة من العمل، فالعبادة فيه أسهل.وجواب آخر أَشَدُّ وَطْئاً: أي أشدّ على المصلّي من صلاة النهار لأنّ الليل خلق للنوم، فإذا أزيل عن ذلك ثقل على العبد ما يتكلّفه منه  ، وكان الثواب أعظم من هذه الجهة. ومن قرأ أشدّ وطاء: أي مواطأة، أي أجدر أن يواطئ اللّسان القلب، والقلب العمل وقرئت أَشَدُّ وَطْئاً  فقيل هو بمعنى الوطء. وقال الفرّاء:لا يقال الوطء ولم يجزه   ."},{"t":"أَقْوَمُ قِيلًا","m":"أصحّ قولا لهدأة الناس وسكون الأصوات."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إن ناشئة الليل","m":"ساعاته كل ما نشأ منه ومذهب عائشة"},{"t":"أشد وطأ","m":"يتواطأ فيها قلب المصلي ولسانه وسمعه على التفهم"},{"t":"وأقوم قيلا","m":"أي اخلص للقول وأسمع له"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ناشِئة الليل","m":"العبادة التي تنشأ به و تحدث"},{"t":"أقوَم قيلا","m":"أثبتُ قِراءة لحضور القلب فيها"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبْحًا","m":"تَصّرُّفًا، وَتَقَلُّبًا فِي مَصَالِحِكَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"سَبْحاً طَوِيلًا","m":"أي متصرّفا فيما تريد، أي لك في النهار ما يقضي حوائجك. وقرئت سبخا  بالخاء المعجمة أي سعة، يقال: سبّخي قطنك: أي وسّعيه ونفّشيه. والتّسبيخ: التّخفيف أيضا، يقال: اللهم سبّخ عنه الحمّى: أي خفّف."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"سبحا","m":"أي قرارا لنومك وراحتك"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سَبْحًا","m":"تصرّفا و تقـلـّـبا في مُهمّـاتك"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَتَبَتَّلْ","m":"انْقَطِعْ لِعِبَادَتِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَبَتَّلْ إِلَيْهِ","m":"انقطع إليه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وتبتل","m":"انقطع إليه في العبادة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تبتـّـل إليه","m":"انقطع إلى عبادته تعالى ، و استغرق في مراقـبته"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَكِيلًا","m":"تُفَوِّضُ أُمُورَكَ إِلَيْهِ، وَتَعْتَمِدُ عَلَيْهِ."}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"هَجْرًا جَمِيلًا","m":"أَعْرِضْ عَنْهُمْ؛ تَارِكًا الاِنْتِقَامَ مْنْهُمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"هجرًا جميلا","m":"اعتزالا حَسَنا لا جزع فيه"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أُولِي النَّعْمَةِ","m":"أَصْحَابَ النَّعِيمِ وَالتَّرَفِ."},{"t":"وَمَهِّلْهُمْ قَلِيلًا","m":"أَجِّلْهُمْ زَمَنًا قَلِيلًا بِتَاخِيرِ العَذَابِ عَنْهُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ومهلهم","m":"منسوخ بآية السيف"},{"t":"النعمة","m":"التنعم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ذرني و المكذبين","m":"دَعْـني و إياهم فسأكفـيكهم"},{"t":"أولي النعمة","m":"أرباب التنعّم ، و غضارة العيش"},{"t":"مهّـلهم قليلا","m":"أمْهلهم زمانا قليلا بعده النّـكال"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَنكَالًا","m":"قُيُودًا ثَقِيلَةً."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَنْكالًا","m":"قيودا، ويقال: أغلالا، واحدها نكل."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أنكالا","m":"قيودا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أنـْـكالا","m":"قـيودا شديدة ثِقالا"},{"t":"ملا ممْدودا","m":"كثيرا دائما غير منقطع عنه"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"ذَا غُصَّةٍ","m":"يَنْشَبُ فِي الحُلُوقِ، لَا يُسْتَسَاغُ؛ لِكَرَاهَتِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"طَعاماً ذا غُصَّةٍ","m":"أي تغصّ به الحلوق فلا يسوغ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ذا غصة","m":"لا يسوغ في الحلق"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"طعامًـا ذا غصّة","m":"ذا نُشوب في الحلق فلا يَـنـْـساغ"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَرْجُفُ","m":"تَضْطَرِبُ."},{"t":"كَثِيبًا","m":"رَمْلًا مُجْتَمِعًا."},{"t":"مَّهِيلًا","m":"سَائِلًا مُتَنَاثِرًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَثِيباً مَهِيلًا","m":"رملا سائلا. يقال لكلّ ما أرسلته من يدك من رمل أو تراب أو نحو ذلك: هلته، يعني أن الجبال فتّتت من زلزلتها حتى صارت كالرّمل المذرّى."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كثيبا","m":"رملا والمهيل الذي يتحرك أسفله فينهال أعلاه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يوم ترجُف الأرض","m":"تضطرب و تتزلزل (يوم القيامة)"},{"t":"كثيبا مهيلا","m":"رَمْلا مُجْـتمِعًـا – سائلا مُنهالا"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَبِيلًا","m":"شَدِيدًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَبِيلًا","m":"أي شديدا، بلغة حمير  متخما لا يستمرأ  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وبيلا","m":"ثقيلا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أخذا وبيلا","m":"شديدا ثقيلا وَخيم العُقـبى"}]}]},{"ayah":17,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شِيباً","m":"جمع أشيب وهو الأبيض الرأس."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تتقون إن كفرتم يوما","m":"أي عذاب يوم"}]}]},{"ayah":18,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُنفَطِرٌ بِهِ","m":"مُتَصَدِّعَةٌ فِي يَوْمِ القِيَامَةِ."},{"t":"مَفْعُولًا","m":"وَاقِعًا لَا مَحَالَةَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مُنْفَطِرٌ بِهِ","m":"متشقق به، أي باليوم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"منفطر به","m":"أي منشق فيه أي في ذلك اليوم والسماء تذكر وتؤنث فها هنا ذكر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"السماء منفطر به","m":"شيء مُنشقّ في ذلك اليوم لِهوْله"}]}]},{"ayah":19,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبِيلًا","m":"طَرِيقًا بِالطَّاعَةِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أشدّ وطأ","m":"ثباتا للقدَم و رسوخا في العبادة"}]}]},{"ayah":20,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَقُومُ","m":"تُصَلِّي مُتَهَجِّدًا مِنَ اللَّيْلِ."},{"t":"أَدْنَى","m":"أَقَلَّ."},{"t":"لَّن تُحْصُوهُ","m":"لَنْ يُمْكِنَكُمْ قِيَامُ اللَّيْلِ كُلِّهِ."},{"t":"فَتَابَ عَلَيْكُمْ","m":"خَفَّفَ عَلَيْكُمْ."},{"t":"يَبْتَغُونَ","m":"يَطْلُبُونَ بِالتَّنَقُّلِ فِي الأَرْضِ."},{"t":"فَضْلِ اللَّهِ","m":"رِزْقِ اللهِ."},{"t":"وَأَقْرِضُوا","m":"تَصَدَّقُوا."},{"t":"قَرْضًا حَسَنًا","m":"صَدَقَةً بِاخْلَاصٍ، وَطِيبِ نَفْسٍ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لن تحصوه","m":"تطيقوا قيام ثلثي اليوم ولا ثلثه ولا نصفه"},{"t":"فتاب","m":"خفف"},{"t":"مرضى","m":"لا تطيقون قيام الليل فنسخ قيام الليل عن المسلمين بالصلوات الفرائض"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لنْ تـُحصوه","m":"لنْ تـُـطيقـوا ضَبْط وَقتِ قِـيامه"},{"t":"فـتـَـاب عَليكم","m":"بالتـّرخيص في ترك قيامه المقدّر"},{"t":"فاقرءُوا ما تيسر من القرآن","m":"فصلـّـوا ما سَهُـلَ عليكم منْ صلاة اللـّـيل ، و في الصّلاة قرآن"},{"t":"يَضربون","m":"يُـسافـرون للتجارة و نحوها"},{"t":"أقيموا الصّـلاة","m":"المفروضة"},{"t":"قرضا حسنا","m":"احتسابا بطيبة نفـْـس"}]}]}]