[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبِّحِ اسْمَ رَبِّكَ","m":"نَزِّهْ رَبَّكَ ذَاكِرًا اسْمَهُ بِلِسَانِكَ."},{"t":"الْأَعْلَى","m":"الَّذِي لَهُ عُلُوُّ الذَّاتِ، وَعُلُوَّ القَدْرِ، وَعُلُوُّ القَهْرِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سبّح اسم ربّك","m":"نَزِّهُه ومَجِّدهُ تعالى عمَّا لا يَليق به"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَسَوَّى","m":"أَتْقَنَ خَلْقَهُ، وَأَحْسَنَهُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"خَلق","m":"أَوْجَدَ كلَّ شىءٍ بقدرتِه"},{"t":"فسَوّى","m":"بَينَ خَلْقِه فى الإحْكام والإتقان"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَهَدَى","m":"يَسَّرَ لَهُ مَا يُنَاسِبُهُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"قدر فهدى","m":"قدر لكل دابة ما يصلحها وهداها إليه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"قـَـدّر","m":"جعلَ الأشياءَ على مَقادِيرَمَخصوصهٍ"},{"t":"فهَـدَى","m":"فَوجَّه كلَّ واحدٍ منها إلى ما يَنبَغى له"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمَرْعَى","m":"الكَلَأَ الأَخْضَرَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أخرج المرعى","m":"أنبت العشب وما ترعاه البهائم ثم جعله بعد الخضرة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أخْرَجَ المرعى","m":"أنـْـبَتَ العُشبَ رَطْبًا غَضًّا"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"غُثَاءً","m":"هَشِيمًا جَافًّا."},{"t":"أَحْوَى","m":"مُتَغَيِّرًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"غُثاءً أَحْوى","m":"فيه قولان:أحدهما: والذي أخرج المرّعى أحوى، أي أخضر غضّا يضرب إلى السّواد من شدة الخضرة والرّيّ فجعله بعد خضرته غثاء، أي يابسا. والغثاء: ما يبس من النّبت فحملته الأودية والمياه.والثاني: فجعله غثاء أي يابسا أَحْوى أسود من قدمه واحتراقه، أي فكذلك يميتكم بعد الحياة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غثاء","m":"أي جففه حتى تركه هشيما جافا كالغثاء الذي تراه فوق ماء السيل والأحوى الذي قد اسود عن القدم والعتق"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فجَعَله غـُـثاءً","m":"يابِسًا هَشِيمًا من بعدُ كالغُثاءِ(هو ما يَحمِلُه السَّيلُ من البَالِى من ورقِ الشجرِ مُخالِطًا زَبَدَه)"},{"t":"أحْوَى","m":"أسْودَ أو أسْمَرَ بعد الخُضرة"}]}]},{"ayah":6,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فلا تنسى","m":"أي سنجمع القرآن في قلبك فلا تنساه أبدا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سنـُـقرؤك","m":"ما نُوحِى إليكَ بواسطةِ جبريل عليه السلام"},{"t":"فلا تنسى","m":"أبَدًا من قوةِ الحفظِ والإتقان"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِلَّا مَا شَاءَ اللَّهُ","m":"إِلَّا مَا أَرادَ اللهُ أَنْ يَنْسَخَ تِلَاوَتَهُ وَحُكْمَهُ، وَيُنْسِيَكَ إِيَّاهُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إلا ما شاء الله","m":"أن ينسخه فتنساه"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لِلْيُسْرَى","m":"لِلطَّرِيقَةِ المُيَسَّرَةِ فِي شَرِيعَتِكَ، وَحَيَاتِكَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لليسرى","m":"أي يسهل عليك عمل الخيرات"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"نـُـيـسّـرُك لليُـسرى","m":"نُوفِّقُكَ للطريقةِ اليُسرى فى كل أمْرٍ"}]}]},{"ayah":9,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"نفعت","m":"أي قبلت وقيل المعنى وإن لم تنفع وقيل معناه قد نفعت"}]}]},{"ayah":10,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لمّـاعَـليها","m":"إلا عليها"},{"t":"و التـّرائب","m":"عِظامِ الصَّدرِ أو الأطرافِ مِن كلٍّ منهما ، أو يَخرجُ من كل البَدَنِ مِنهما ، والصُّلْبُ والترائب كِنايةٌ عنه"},{"t":"تزَكّى","m":"تَطهِّرَ من الكفر والمعاصى"}]}]},{"ayah":15,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وذكر اسم ربه فصلى","m":"في الصحف الأولى"},{"t":"والنمارق الوسائد","m":"والنمارق الوسائد"}]}]},{"ayah":18,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِنَّ هَذَا","m":"أَيْ: مِنْ قَوْلِهِ: {قَدْ أَفْلَحَ مَن تَزَكَّى}."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إن هذا","m":"يعني الفلاح لمن تزكى"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"إنّ هَذا","m":"المذكورَ (الآياتِ الأربعَ السابقة)"}]}]}]