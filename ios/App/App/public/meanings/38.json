[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"ذِي الذِّكْرِ","m":"المُشْتَمِلِ عَلَى تَذْكِيرِ النَّاسِ بِمَا هُمْ عَنْهُ غَافِلُونَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الذكر","m":"الشرق وجواب القسم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"و القرآن","m":"(قسم) جوابه ما الأمر كما تزعمون"},{"t":"ذي الذكر","m":"ذي البيان لما يُحتاج إليه في الدين"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عِزَّةٍ","m":"تَكَبُّرٍ، وَحَمِيَّةٍ."},{"t":"وَشِقَاقٍ","m":"مُخَالَفَةٍ، وَعِنَادٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فِي عِزَّةٍ","m":"العزّة: المغالبة والممانعة. يقال: عزّه يعزّه عزّا، إذا غلبه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والعزة التكبر عن الحق","m":"والعزة التكبر عن الحق"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عزة","m":"حميّـة و تكبر عن الحقّ"},{"t":"شقاق","m":"مشاقّة و مخالفة لله و لرسوله"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَمْ أَهْلَكْنَا","m":"كَثِيرًا مِنَ الأُمَمِ أَهْلَكْنَا."},{"t":"قَرْنٍ","m":"أُمَّةٍ سَابِقَةٍ."},{"t":"وَلَاتَ حِينَ مَنَاصٍ","m":"لَيْسَ الوَقْتُ وَقْتَ فِرَارٍ وَخَلَاصٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلاتَ حِينَ مَناصٍ","m":"أي ليس حين فرار، بلغة توافق لغة القبط  .ويقال: «لات» إنما هي «لا» والتاء زائدة  فيه ثلاثة أقوال:أحدها: أن أصله «ليس» فقلبت الياء ألفا والسين تاء، كما قال الشاعر:يا قاتل الله بني السّعلاة ... عمرو بن يربوع شرار النّات يريد: الناس. وقوله: «أي ليس حين فرار» يحتمل هذا القول.والثاني: هو الذي حكاه ثانيا فهو كما زيد في «ثم» و «ربّ» فقيل: ثمّت وربّت.والثالث: أن التاء تلحق ب «حين» كما قال الشاعر:العاطفون تحين لا من عاطف ... والمطعمون زمان لا من مطعم  وكذلك تلحق «الآن» فيقال «تالآن» ، وقال الشاعر:وصلينا كما زعمت تلانا وهذا قول أبي عبيد  .والمناص مصدر ناص ينوص نوصا ومناصا، وهو الفرار والمهرب، وقيل:المطلب، وقيل: التّأخر، والمعنى: لا منجى ولا فوت."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كم أهلكنا","m":"قال الفراء المعنى لكم فحذفت اللام وقال الكسائي جواب القسم"},{"t":"فنادوا","m":"عند نزول العذاب"},{"t":"ولات حين مناص","m":"أي وليس بحين فرار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كم أهلكنا","m":"كثيرة أهلكنا"},{"t":"قرن","m":"أمة"},{"t":"فنادوْا","m":"استغاثوا حين عاينوا العذاب"},{"t":"لات حين مناص","m":"ليس الوقت وقت فرار و خلاص"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عُجَابٌ","m":"عَجِيبٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"عُجابٌ","m":"العجاب والعجيب بمعنى."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عجاب","m":"بالغ الغاية في العَجَب"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمَلَأُ","m":"الأَشْرَافُ، وَكِبَارُ القَوْمِ."},{"t":"امْشُوا","m":"اسْتَمِرُّوا عَلَى دِينِكُمْ، وَشِرْكِكُمْ."},{"t":"لَشَيْءٌ يُرَادُ","m":"مُدَبَّرٌ يُقْصَدُ مِنْهُ التَّرَؤُسُ، وَالسِّيَادَةُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أن امشوا","m":"أي انطلقوا بهذا القول"},{"t":"إن هذا","m":"الذي تراه من زيادة أصحاب محمد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الملأ منهم","m":"الوجوه من كفار قريش"},{"t":"امشوا","m":"سيروا على طريقتكم و دينكم"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمِلَّةِ الْآخِرَةِ","m":"دِينِ آبَائِنَا وَدِينِ النَّصَارَى."},{"t":"اخْتِلَاقٌ","m":"كَذِبٌ، وَافْتِرَاءٌ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الملة الآخرة","m":"النصرانية"}]},{"name":"كلمات القرآن","author":"حسنين مح