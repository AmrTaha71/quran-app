[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَنزَلْنَاهُ","m":"أَنْزَلْنَا القَرْآنَ جُمْلَةً وَاحِدَةً مِنَ اللَّوْحِ المَحْفُوظِ إِلَى بَيْتِ العِزَّةِ فِي السَّمَاءِ الدُّنْيَا."},{"t":"لَيْلَةِ الْقَدْرِ","m":"لَيْلَةِ الشَّرَفِ، وَالعَظَمَةِ، وَكِتَابِ المَقَادِيرِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَنْزَلْناهُ","m":"أي القرآن، وقيل: جبريل، وقيل: أوّل القرآن."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إنا أنزلناه","m":"يعني القرآن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أنزلناه","m":"ابْـتـَـدَأنا إنـْـزَالَ القرآنِ العظيم"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالرُّوحُ","m":"جِبْرِيلُ - عليه السلام -."},{"t":"أَمْرٍ","m":"قَضَاءٍ قَدَّرَهُ اللهُ فِي تِلْكَ السَّنَةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالرُّوحُ","m":"هو جبريل عليه السلام."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الروح","m":"جبريل"},{"t":"من كل أمر","m":"أي بكل أمر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الرّوح","m":"جبريل عليه السلام"},{"t":"منْ كل أمر","m":"بكلّ أمر من الخير و البركة"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَلَامٌ","m":"أَمْنٌ، وَسَلَامَةٌ، وَتَسْلِيمٌ مِنَ المَلَائِكَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"سلام","m":"أي هي خير وبركة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سلام هيَ","m":"على أولياء الله و أهل طاعته"}]}]}]