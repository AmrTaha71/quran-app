[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبَّحَ لِلَّهِ","m":"نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِجَلَالِهِ سُبْحَانَهُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سَبّح لله","m":"نـَـزّهَه و مَجّده تعالى و دلّ عليه"}]}]},{"ayah":2,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لم تقولون","m":"كان الرجل يجيء فيقول لرسول الله صلى الله عليه وسلم فعلت كذا وكذا وما فعل فنزلت"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَبُرَ مَقْتًا","m":"عَظُمَ بُغْضًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَبُرَ مَقْتاً","m":"عظم بغضا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كَبُرَ مَقـتا","m":"عَظم بغضا بالغ الغاية"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"صَفًّا","m":"صَافِّينَ صَفًّا."},{"t":"مَّرْصُوصٌ","m":"مُتَرَاصٌّ مُحْكَمٌ لَا فُرْجَةَ فِيهِ، وَلَا يَنْفُذُ فِيهِ العَدُوُّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بُنْيانٌ مَرْصُوصٌ","m":"لاصق بعضه ببعض لا يغادر شيء منه شيئا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"مرصوص","m":"ملتصق بعضه ببعض"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صَفّا","m":"صافّين أنفسهم أو مصفوفين"},{"t":"بُنيانٌ مَرْصوص","m":"متلاصق مُحكم لا فرجة فيه"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"زَاغُوا","m":"عَدَلُوا عَنِ الحَقِّ، مَعَ عِلْمِهِمْ بِهِ."},{"t":"أَزَاغَ اللَّهُ قُلُوبَهُمْ","m":"صَرَفَهَا عَنْ قَبُولِ الحَقِّ؛ جَزَاءً عَلَى زَيْغِهِمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَلَمَّا زاغُوا أَزاغَ اللَّهُ قُلُوبَهُمْ","m":"أي فلمّا مالوا عن الحقّ والطاعة، أمال الله قلوبهم عن الخير