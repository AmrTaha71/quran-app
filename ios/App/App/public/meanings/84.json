ْدَ أحْوَال مُتطابقة في الشّدة"}]}]},{"ayah":23,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُوعُونَ","m":"يَكْتُمُونَ فيِ صُدُورِهِمْ مِنَ العِنَادِ، وَالتَّكْذِيبِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بِما يُوعُونَ","m":"يجمعون في صدورهم من التكذيب بالنبي صلّى الله عليه وسلّم، كما يوعى المتاع في الوعاء."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يوعون","m":"يجمعون في قلوبهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يوعـون","m":"يُضمِرونه أو يَجمعونه من السّيئات"}]}]},{"ayah":24,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حُـقـّـتْ","m":"حَقّ الله عليها الاستماع و الانقـياد"}]}]}]