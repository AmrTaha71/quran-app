والشّهادة: ما ظهر لهم. وقيل: الغيب: ما سيوجد، والشّهادة: الموجود  والغيب: خفاء الشّيء عن الإدراك، والشهادة:ظهوره للإدراك."}]}]},{"ayah":7,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الذي أحسن كل شيء خلقه","m":"أي أحكمه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أحسَن كلّ شيء","m":"أحكمه و أتقنه"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"نَسْلَهُ","m":"ذُرِّيَّتَهُ."},{"t":"سُلَالَةٍ","m":"وَهِيَ النُّطْفَةُ؛ لِأَنَّهَا مُسْتَلَّةٌ مِنْ جَمِيعِ البَدَنِ."},{"t":"مَّهِينٍ","m":"ضَعِيفٍ، رَقِيقٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مِنْ ماءٍ مَهِينٍ","m":"أي ضعيف، ويقال: حقير، يعني النّطفة."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سلالة","m":"خُلاصة"},{"t":"ماءٍ مهين","m":"منيّ ضعيف حقير"}]}]},{"ayah":9,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سوّاه","m":"قوّمه بتصوير أعضائه و تكميلها"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"ضَلَلْنَا فِي الْأَرْضِ","m":"تَحَوَّلْنَا تُرَابًا بَعْدَ المَوْتِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ضَلَلْنا فِي الْأَرْضِ","m":"بطلنا وصرنا ترابا فلم يوجد لنا لحم ولا دم ولا عظم. ويقرأ صللنا  أي أنتنّا وتغيّرنا، من قولهم: صلّ اللّحم وأصلّ وصنّ وأصنّ، إذا أنتن وتغيّر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ضللنا","m":"المعنى صارت عظامنا ولحومنا ترابا كالأرض يقال ضل الماء في اللبن إذا غلب اللبن فأخفاه"},{"t":"أئنا لفي خلق جديد","m":"استفهام إنكار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ضللنا في الأرض","m":"ضِعنا فيها و صرنا ترابا"}]}]},{"ayah":11,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَتَوَفَّاكُمْ مَلَكُ الْمَوْتِ","m":"من: توفّي العدد، واستيفائه. وتأويله أنه يقبض أرواحكم أجمعين فلا ينقص واحد منكم، كما تقول: استوفيت من فلان وتوفّيت منه ما لي عنده، أي لم يبق لي عليه شيء."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وكل بكم","m":"أي يقبض أرواحكم"},{"t":"ناكسو رؤوسهم","m":"مطاطئوها حياء وندما"},{"t":"ربنا","m":"فيه إضمار يقولون"},{"t":"أبصرنا","m":"أي علمنا صحة ما كنا نكذبه به"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"نَاكِسُو رُؤُوسِهِمْ","m":"قَدْ خَفَضُوهَا، وَأَطْرَقُوا خِزْيًا وَنَدَمًا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ناكِسوا رءوسهم","m":"مُطْرقُها خِزياً و حياءً و ندماً"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"حَقَّ الْقَوْلُ","m":"ثَبَتَ وَتَحَقَّقَ وَوَجَبَ."},{"t":"الْجِنَّةِ","m":"الجِنِّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"حق","m":"وجب و"},{"t":"القول","m":"قوله لإبليس"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حقّ القول","m":"ثبت و تحقّق و نفذ القضاء"},{"t":"الجـِـنّة","m":"الجنّ"}]}]},{"ayah":14,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فذوقوا","m":"أي يقال لهم في النار ذوقوا العذاب"},{"t":"بما نسيتم","m":"أي تركتم العمل ل"},{"t":"إنا نسيناكم","m":"تركناكم من الرحمة"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَتَجَافَى","m":"تَرْتَفِعُ، وَتَتَنحَّى لِلْعِبَادَةِ."},{"t":"الْمَضَاجِعِ","m":"فُرُشِ النَّوْمِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَتَجافى جُنُوبُهُمْ عَنِ الْمَضاجِعِ","m":"أي ترتفع وتنبو عن الفرش."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تتجافى جنوبهم","m":"ترتفع"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تتجافى جنوبهم","m":"ترتفع و تتنحّى للعبادة"},{"t":"عن المضاجع","m":"الفُرُش التي يُضطجع عليه