[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَوْلِيَاءَ","m":"خُلَصَاءَ وَأَحِبَّاءَ."},{"t":"تُلْقُونَ","m":"تُفْضُونَ."},{"t":"أَن تُؤْمِنُوا","m":"لِأَجْلِ إِيمَانِكُمْ."},{"t":"ضَلَّ سَوَاءَ السَّبِيلِ","m":"أَخْطَأَ طَرِيقَ الهُدَى."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا تتخذوا عدوي","m":"وهم المشركون"},{"t":"أن تؤمنوا","m":"أي لإيمانكم"},{"t":"إن كنتم","m":"المعنى إن كنتم خرجتم جهادا لا تتخذوا عدوى والاية نزلت في حاطب بن زبي بلتعة كتب رلى أهل مكة يخبرهم أن النبي صلى الله عليه وسلم قصد إليهم لأجل أهله وماله عندهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أولياء","m":"أعوانا توادونهم و تناصحونهم"},{"t":"أن تؤمنوا","m":"لإيمانكم أو كراهة إيمانكم"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَثْقَفُوكُمْ","m":"يَظْفَرُوا بِكُمْ."},{"t":"وَيَبْسُطُوا","m":"يَمُدُّوا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يثقفوكم","m":"يَظفروا بكم . أو يصادفوكم"},{"t":"يبسطوا إليكم","m":"يمدّوا إليكم"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَفْصِلُ بَيْنَكُمْ","m":"يُفَرِّقُ بَيْنَ المُطِيعِينَ، وَالعَاصِينَ."}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أُسْوَةٌ","m":"قُدْوَةٌ."},{"t":"بُرَءَاؤُا","m":"بَرِيئُونَ."},{"t":"إِلَّا قَوْلَ إِبْرَاهِيمَ","m":"لَكِنْ لَا تَقْتَدُوا بِإِبْرَاهِيمَ حِينَ قَالَ."},{"t":"أَنَبْنَا","m":"رَجَعْنَا بِالتَّوْبَةِ، وَالطَّاعَةِ."},{"t":"الْمَصِيرُ","m":"المَرْجِعُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أسوة","m":"اقتداء حسن والمعنى تأسوا بإبراهيم إلا في"},{"t":"ربنا عليك توكلنا","m":"أي قولوا أنتم هذا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أسروة حسنة","m":"قدوة حميدة في التـَّـبَـرّي من الضالين"},{"t":"بُرَآءُ منكم","m":"أبرياء منكم"},{"t":"إليك أنـَــبْنا","m":"إليك رَجَعْنا تائبين"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فِتْنَةً لِّلَّذِينَ كَفَرُوا","m":"بِعَذَابِكَ لَنَا، أَوْ تَسْلِيطِ الكُفَّارِ عَلَيْنَا، فَيَقُولُونَ: لَوْ كَانَ هَؤُلَاءِ عَلَى حَقٍّ، مَا أَصَابَهُمُ العَذَابُ، فَيَزْدَادُوا كُفْرًا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تجعلنا فـتنة","m":"مفتونين بهم معذبين بأيديهم"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَرْجُو اللَّهَ","m":"يَطْمَعُ فِي الخَيْرِ مِنَ اللهِ."},{"t":"يَتَوَلَّ","m":"يُعْرِضْ عَنِ الاِقْتِدَاءِ بِالأَنْبِيَاءِ، وَيُوَالِ أَعْدَاءَ اللهِ."},{"t":"الْحَمِيدُ","m":"المَحْمُودُ فِي ذَاتِهِ، وَصِفَاتِهِ، وَأَفْعَالِهِ."}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَّوَدَّةً","m":"مَحَبَّةً."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"عاديتم منهم","m":"أي من أهل مكة"},{"t":"مودة","m":"ففعل ذلك فتزوج رسول الله صلى الله عليه وسلم أم حبيبة فانكسر أبو سفيان عن كثير مما كان يصنع وأسلم يوم الفتح منهم خلق كثير"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَبَرُّوهُمْ","m":"تُكْرِمُوهُمْ."},{"t":"وَتُقْسِطُوا","m":"تَعْدِلُوا فِيهِمْ."},{"t":"الْمُقْسِطِينَ","m":"العَادِلِينَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"عن الذين لم يقاتلوكم","m":"نزلت في أسماء بنت أبي بكر رضي الله عنهما قدمت أمها قتيلة بهدايا فلم تقبل هداياها فنزلت الاية وهي رخصة في صلة الذين لم ينصبوا الحرب وقيل معنى هذه الآية والتي قبلها منسوخ باية السيف"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تبرّوهم","m":"تحْسنوا إليهم و تكرموهم"},{"t":"تـُـقسِطوا إليهم","m":"تـُـفـضوا إليهم بالقسْط و العدل"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَظَاهَرُوا","m":"عَاوَنُوا."},{"t":"أَن تَوَلَّوْهُمْ","m":"أَنْ تَنْصُرُوهُمْ، وَتَوَدُّوهُمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ظاهروا","m":"عاوَنوا الذين قاتلوكم و أخرجوكم"},{"t":"أن توَلّوْهمْ","m":"أن تتخذوهم أولياء"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَامْتَحِنُوهُنَّ","m":"فَاخْتَبِرُوهُنَّ؛ لِتَعْلَمُوا صِدْقَ إِيمَانِهِنَّ."},{"t":"وَآتُوهُم مَّا أَنفَقُوا","m":"وَأَعْطُوا أَزْوَاجَ اللَّاتِي أَسْلَمْنَ مِثْلَ مَا أَنْفَقُوا عَلَيْهِنَّ مِنَ المُهُورِ."},{"t":"جُنَاحَ","m":"إِثْمَ."},{"t":"أُجُورَهُنَّ","m":"مُهُورَهُنَّ."},{"t":"بِعِصَمِ الْكَوَافِرِ","m":"بِعُقُودِ نِكَاحِ زَوْجَاتِكُمُ الكَافِرَاتِ."},{"t":"وَاسْأَلُوا مَا أَنفَقْتُمْ","m":"وَاطْلُبُوا مِنَ المُشْرِكِينَ مُهُورَ نِسَائِكُمُ المُرْتَدَّاتِ اللَّوَاتِي لَحِقْنَ بِهِمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَامْتَحِنُوهُنَّ","m":"فاختبروهن."},{"t":"الْكُفَّارِ","m":"جمع كافر [زه] وهو المقابل للمؤمن  ."},{"t":"وَلا تُمْسِكُوا بِعِصَمِ الْكَوافِرِ","m":"أي بحبالهنّ. والعصم: الحبال، واحدها: عصمة. وكل ما أمسك شيئا، فقد عصمه، يقول: لا ترغبوا فيهن."},{"t":"وَسْئَلُوا ما أَنْفَقْتُمْ","m":"أي اسألوا أهل مكة أن يردّوا عليكم مهور النساء اللاتي يخرجن إليهم مرتدّات."},{"t":"وَلْيَسْئَلُوا ما أَنْفَقُوا","m":"أي وليسألوكم مهور من خرج إليكم من نسائهم مؤمنات."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فامتحنوهن","m":"وهو أن تقول والله ما أخرجكن رلا حب الله ورسوله ولا خرجتن ازوج ولا مال فرذا قلن ذلك تركن"},{"t":"وآتوهم","m":"يعني أزواجهن"},{"t":"ما أنفقوا","m":"وهو المهر والمعنى عليكم أن تغرموا لهم الصداق كما يغرمون لكم"},{"t":"ولا تمسكوا بعصم الكوافر","m":"يعني رذا كفرت فقد زالت العصمة بينها وبين المؤمنين أي انبت عقد النكاح"},{"t":"واسألوا ما أنفقتم","m":"أي إن لحقت امرأة منكم بأهل العهد من الكفار مرتدة فاسزلواهم ما أنفقتم من المهر رذا لم يدفعوها إليكم"},{"t":"وليسألوا ما أنفقوا","m":"يعني المشركين الذين لحقت أزواجهم بكم مؤمنات إذا تزوجن منكم فليسأل أزواجهن الكفار من تزوجهن منكم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فامْتـَـحنوهنّ","m":"فاختبروهن و كان ذلك بالتحْـليف"},{"t":"أجورهنّ","m":"مُهورهنّ"},{"t":"بعِصم الكوافر","m":"بعقود نكاح المشركات"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَإِن فَاتَكُمْ شَيْءٌ مِّنْ أَزْوَاجِكُمْ","m":"انْفَلَتَتْ وَاحِدَةٌ بِرِدَّةٍ."},{"t":"فَعَاقَبْتُمْ","m":"فَظَفِرْتُمْ بِالكُفَّارِ، وَغَنِمْتُمْ مِنْهُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فعاقبتم","m":"أي أصبتموهم في القتال بعقوبة حتى غنمتم"},{"t":"فآتوا الذين ذهبت أزواجهم مثل ما أنفقوا","m":"أي أعطوا الأزواج من رأس الغنيمة ما أنفقوا من المهر وهذه الأحكام من أداء المهور وأخذه من الكفار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فاتكم شيء","m":"انفلتَ أحدٌ بردّة"},{"t":"فعاقبتمْ","m":"فَغَزوتم  فغَنمتم منهمْ"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُبَايِعْنَكَ","m":"يُعَاهِدْنَكَ."},{"t":"بِبُهْتَانٍ يَفْتَرِينَهُ","m":"بِأَنْ يُلْحِقْنَ بِأَزْوَاجِهِنَّ أَوْلَادًا لَيْسُوا مِنْهُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولا يقتلن أولادهن","m":"وهو الوأد الذي كانوا يفعلونه"},{"t":"ولا يأتين ببهتان","m":"أي لا يلحقن بأزواجهن غير أولادهم وكانت المرأة تلتقط الولد فتقول ازوجها هذا ولدي منك فذلك البهتان وإنما قال"},{"t":"بين أيديهن وأرجلهن","m":"لأن الولد إذا وضعته المرأة سقط بين يديها ورجليها"},{"t":"في معروف","m":"وهو النوح"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ببُـهتان","m":"بإلصاق اللّـقـطاء بالأزواج"},{"t":"يفترينه","m":"يَختـَـلِقـنه"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا تَتَوَلَّوْا","m":"لَا تَجْعَلُوهُمْ أَوْلِيَاءَ، وَأَخِلَّاءَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غضب الله عليهم","m":"وهم اليهود"},{"t":"يئسوا من الآخرة","m":"أي من ثوابها"},{"t":"كما يئس الكفار من أصحاب القبور","m":"أن يبعثوا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تتولوْا","m":"لا تتخذوا أولياء"},{"t":"قوْمًـا","m":"هم اليَهود ، أو الكفار عامّة"}]}]}]