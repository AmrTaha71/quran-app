[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْكَوْثَرَ","m":"الخَيْرَ الكَثِيرَ، وَمِنْهَ نَهْرُ الكَوْثَرِ فِي الجَنَّةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْكَوْثَرَ","m":"نهر في الجنّة. وقيل «فوعل» من الكثرة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الكوثر","m":"نهر في الجنة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أعطيناك الكوثر","m":"نهرًا في الجَنّة أو الخيْر الكَثير"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَانْحَرْ","m":"اذْبَحْ ذَبِيحَتَكَ للهِ وَحْدَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"انْحَرْ","m":"اذبح. ويقال: انحر: ارفع يدك بالتكبير إلى نحرك."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وانحر","m":"قال ابن عباس أذبج له يوم النحر قال القرظي المعنى صلى لله وانحر لله فإن ناسا يصلون لغير الله وينحرون لغيره"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"انـْـحَرْ","m":"الأضاحي نـُـسُـكًـا شُـكْرًا لله تعالى"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"شَانِئَكَ","m":"مُبْغِضَكَ."},{"t":"الْأَبْتَرُ","m":"المُنْقَطِعُ أَثَرُهُ، المَقْطُوعُ مِنْ كُلِّ خَيْرٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شانِئَكَ","m":"مبغضك."},{"t":"الْأَبْتَرُ","m":"الذي لا عقب له."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الأبتر","m":"المنقطع عن الخير وهذا نزل في العاص ابن وائل قال عن النبي صلى الله عليه وسلم إنه أبتر لأن عبد الله ابن النبي صلى الله عليه وسلم كان قد مات"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"شـَأنِـئـَـكَ","m":"مُـبْغِـضك (أحد مُشركي قريش)"},{"t":"هو الأبْـتـر","m":"المقطوع الأثر. أو الخير"}]}]}]