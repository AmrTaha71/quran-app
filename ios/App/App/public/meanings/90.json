"words":[{"t":"فَلَا اقْتَحَمَ","m":"فَهَلَّا تَجَاوَزَ."},{"t":"الْعَقَبَةَ","m":"مَشَقَّةَ الآخِرَةِ؛ بِإِنْفَاقِ المَالِ، وَالعَمَلِ الصَّالِحِ."},{"t":"وَمَا يُغْنِي","m":"لَا يَنْفَعُهُ."},{"t":"تَرَدَّى","m":"وَقَعَ فِي النَّارِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"اقْتَحَمَ الْعَقَبَةَ","m":"يقال: هي عقبة بين الجنّة والنّار. والاقتحام:الدّخول في الشيء والمجاوزة له بشدّة وصعوبة، أي لم يقتحمها، أي لم يجاوزها و «لا» مع الماضي بمعنى «لم» مع المستقبل كقوله:إن تغفر اللهمّ تغفر جمّا ... وأيّ عبد لك لا ألمّا أي: وأيّ عبد لك لم يلمّ [بذنب]  [زه] ومعناه: يهم."},{"t":"تَرَدَّى","m":"تفعّل من الرّدى، وهو الهلاك. ويقال: تردّى فلان من رأس الجبل، إذا سقط."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فلا اقتحم","m":"والمعنى فهلا أنفق ماله في فك الرقاب والإطعام لتجاوز"},{"t":"تردى","m":"في جهنم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فلا اقـتحم العقبة","m":"فهلاّ جَاهد نفسَـه في أعمال البرّ"},{"t":"ما يُـغْنى","m":"ما يَدْفع العذاب عنه"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِنَّ عَلَيْنَا لَلْهُدَى","m":"عَلَيْنَا أَنْ نُبَيِّنَ طَرِيقَ الهُدَى؛ فَضْلًا مِنَّا وَرَحْمَةً."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تلظى","m":"تتوقد وتتوهج"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"إنّ علينا للهدى","m":"الدّلالة على الحقّ أو بيان طريقه"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَكُّ رَقَبَةٍ","m":"إِعْتَاقُهَا مِنَ الرِّقِّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَكُّ رَقَبَةٍ","m":"أي أعتقها  وفكّها من الرّقّ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فكّ رَقـبَة","m":"تخليصها من الرّق و العبوديّة"},{"t":"ناقة الله و سُقياها","m":"احْذروا عـقـْـرَها و نـَـصيـبَها من الماء"}]}]},{"ayah":14,