[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالْفَتْحُ","m":"فَتْحُ مَكَّةَ، وَكَانَ ذَلِكَ فِي العَامِ الثَّامِنِ الهِجْرِيِّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"نَصْرُ اللَّهِ","m":"معونته على قريش. وقيل: عامّ في جميع الكفار."},{"t":"وَالْفَتْحُ","m":"الإسلام على البلاد. وقال الحسن: هو فتح مكّة لأنّ العرب أسلمت بإسلام أهل مكة  . وقال ابن عبّاس: فتح المدائن والقصور."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والفتح","m":"فتح مكة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"جاء نصر الله","m":"عَوْنـُهُ لك على الأعداء"},{"t":"الفتح","m":"فتح مكة في السنة الثامنة الهجرية"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَفْوَاجًا","m":"جَمَاعَاتٍ كَثِيرَةً تِلْوَ جَمَاعَاتٍ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أفواجا","m":"جَماعاتٍ جماعات كثيرة"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ","m":"نَزِّهُ رَبَّكَ تَنْزِيهًا مَصْحُوبًا بِحَمْدِهِ."},{"t":"تَوَّابًا","m":"يَرْجِعُ عَلَى المُسْتَغْفِرِ بِالرَّحْمَةِ، وَيَقْبَلُ التَّوْبَةَ مِمَّنْ تَابَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فسبح","m":"صل وهذه السورة نعت إلى النبي صلى الله عليه وسلم نفسه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فسبّح بحمد ربّك","m":"فـنـَـزّهْهُ تعالى ، حامِدًا له"},{"t":"كان توّابا","m":"كثير القبول لتوبة عباده"}]}]}]