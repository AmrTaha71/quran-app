[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالنَّازِعَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ تَنْزِعُ أَرْوَاحَ الكُفَّارِ."},{"t":"غَرْقًا","m":"نَزْعًا شَدِيدًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالنَّازِعاتِ غَرْقاً","m":"الملائكة تنزع أرواح الكفّار إغراقا كما يغرق النازع في القوس."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غرقا","m":"أي إغراقا كما يغرق النازع في القوس يعني أنه يبلغ بها غاية المد وهي الناشطات تنشط أرواح الكفار وهي السابحات تسبح بأرواح المؤمنين أي تسلها سلا رقيقا ثم يدعونها حتى تستريح وهي السابقات تسبق بأرواحهم إلى الجنة وهي المدبرات فجبريل موكل بالرياح والجنود وميكائيل موكل بالقطر والنبات وملك الموت يقبض الأرواح وإسرافيل يتنزل بالأمر العظيم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"غرْقا","m":"نـَزعا شديدا مُؤْلما بالغ الغاية"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالنَّاشِطَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ تَسُلُّ أَرْوَاحَ المُؤْمِنِينَ بِرِفْقٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالنَّاشِطاتِ نَشْطاً","m":"الملائكة تنشط أرواح المؤمنين، أي تحلّ حلّا رفيقا كما ينشّط العقال من يد البعير أي يحلّ حلّا برفق."}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالسَّابِحَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبَحُ فِي نُزُولِهَا مِنَ السَّمَاءِ، وَصُعُودِها إِلَيْهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالسَّابِحاتِ سَبْحاً","m":"الملائكة- عليهم السلام- جعل نزولها كالسّباحة."}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَالسَّابِقَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبِقُ الشَّيَاطِينَ بِالوَحْيِ إِلَى الأَنْبِيَاء؛ لِئَلَّا تَسْتَرِقَهُ."}]},{"name":"التبيان في تفسي