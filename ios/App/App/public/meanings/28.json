راد: ويلك، وأنّ منصوبة بإضمار: أعلم أن الله. ويقال: «وي» مفصولة من «كأنّ» ومعناها التعجّب  ، كما تقول: وي، لم فعلت ذلك؟ و «كأنّ» معناها: أظنّ ذلك، وأقدّره، كما تقول: كأنّ الفرج قد أتاك، أي أظنّ ذلك وأقدّره."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ويكأن","m":"في كلام العرب كقول الرجل أما ترى"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ويْكأنّ الله","m":"ألـَـمْ تـَـرَ الله"},{"t":"يَقـْـدِر","m":"يُضيّق على من يشاء لحكمة"},{"t":"ويكَأنّه لا يفلح","m":"ألـَـم ترَ الشأن لا يُفلح . . ."}]}]},{"ayah":83,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عُلُوًّا","m":"تَكَبُّرًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"علوا","m":"أي بغيا"}]}]},{"ayah":85,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَرَضَ","m":"أَنْزَلَ."},{"t":"لَرَادُّكَ إِلَى مَعَادٍ","m":"لَمُرْجِعُكَ إِلَى المَوْضِعِ الَّذِي خَرَجْتَ مِنَهُ، وَهُوَ مَكَّةُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَرَضَ عَلَيْكَ الْقُرْآنَ","m":"أي أوجب عليك العمل به. ويقال:أصل الفرض: الحزّ، يقال: لكلّ حزّ فرض. فمعناه أنّ الله- عز وجل- ألزمهم ذلك فثبت عليهم كما ثبت الحزّ في العود إذا حزّ فتبقى علاماته."},{"t":"إِلى مَعادٍ","m":"أي مرجع. وقيل: إلى مكّة، وقيل: معاده الجنّة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فرض عليك القرآن","m":"أي فرض العمل به"},{"t":"لرادك إلى معاد","m":"وهو يوم القيامة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"معادٍ","m":"مكّة المكرّمة ظاهرا عليها"}]}]},{"ayah":86,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَرْجُو","m":"تُؤَمِّلُ."},{"t":"يُلْقَى","m":"يُنَزَّلَ."},{"t":"ظَهِيرًا","m":"عَوْنًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إلا رحمة من ربك","m":"أي إلا أن ربك رحمك"}]}]}]