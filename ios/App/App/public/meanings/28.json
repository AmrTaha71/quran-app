","m":"خَزَائِنِ الأَمْوَالِ."},{"t":"مَفَاتِحَهُ","m":"مَفَاتِيحَ خَزَائِنِ مَالِهِ وَصَنَادِيقِهُ المُقْفَلَةِ."},{"t":"لَتَنُوءُ بِالْعُصْبَةِ","m":"لَيَثْقُلُ حَمْلُهَا عَلَى الجَمَاعَةِ الكَثِيرَةِ."},{"t":"لَا تَفْرَحْ","m":"لَا تَبْطَرْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَبَغى عَلَيْهِمْ","m":"أي ترفّع وجاوز المقدار."},{"t":"لَتَنُوأُ بِالْعُصْبَةِ","m":"أي تنهض بها. وهو من المقلوب. معناه أنّ العصبة تنوء بمفاتحه، أي ينهضون بها، ويقال: ناء بحمله، إذا نهض بحمله متثاقلا.وقال الفرّاء  : ليس هذا بمقلوب إنما معناه: ما إنّ مفاتحه لتنيء العصبة  ، أي تميلهم بثقلها، فلما انفتحت التاء دخلت الباء [كما] قالوا: هو يذهب بالبؤس،ويذهب البؤس، واختصاره:  تنوء بالعصبة بمعنى تجعل العصبة تنوء أي تنهض متثاقلة، كقولك: قم بنا، أي: اجعلنا نقوم."},{"t":"لا تَفْرَحْ","m":"لا تأشر."},{"t":"إِنَّ اللَّهَ لا يُحِبُّ الْفَرِحِينَ","m":"أي الأشرين البطرين. وأما الفرح بمعنى السرور فليس بمكروه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من قوم موسى","m":"أي من عشيرته وكان ابن عمه"},{"t":"فبغى","m":"بالكفر"},{"t":"لتنوء بالعصبة","m":"أي تثقلهم وتميليهم وفي العصبة ها هنا ثلاثة أقوال أحدها ما بين الثلاثة إلى العشرة والثاني أربعون والثالث خمسة عشر"},{"t":"إذ قال له قومه","m":"أي المؤمنون منهم"},{"t":"لا تفرح","m":"أي لا تبطر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فبغى عليهم","m":"ظَلَمَهُم . أو تكبّرَ عليهم"},{"t":"لَتنوءُ بالعُصبة","m":"لتـُـثـقل الجماعة الكثيرة و تميل بهم"},{"t":"لا تفرحْ","m":"لا تبْطَرْ و لا تأشَرْ بكُثرَةِ المال"}]}]},{"ayah":77,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَابْتَغِ","m":"الْتَمِسْ وَاطْلُبْ."},{"t":"وَلَا تَنسَ نَصِيبَكَ","m":"لَا تَتْرُكْ حَظَّكَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولا تنس نصيبك من الدنيا","m":"أي تعمل فيها للآخرة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سرمدا","m":"دائما مُطّردا"}]}]},{"ayah":78,"book