يد)"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَّمْدُودًا","m":"مَبْسُوطًا وَاسِعًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ممدودا","m":"كثيرا له مدد"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"شُهُودًا","m":"حُضُورًا مَعَهُ فِي مَكَّةَ لَا يَغِيبُونَ عَنْهُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"شهودا","m":"حضورا معه لا يحتاجون إلى السفر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بنين شهودًا","m":"حضورا معه ، لا يُفارقونه للتكسّب لِغناهم عنه"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَمَهَّدتُّ لَهُ تَمْهِيدًا","m":"يَسَّرْتُ لَهُ سُبُلَ العَيْشِ تَيْسِيرًا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ومهدت","m":"بسطت له في العيش"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مهّدت له","m":"بَسَطتُ له النّعمة  و الرّياسة و الجَاه"}]}]},{"ayah":15,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أن أزيد","m":"من المال والولد وقيل أن أدخله الجنة"},{"t":"والمعاذير جمع عذر","m":"والمعاذير جمع عذر"}]}]},{"ayah":16,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"عنيدا","m":"أي معاندا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كلاّ","m":"كلمة رَدْع و زجر عن الطمع الفارغ"},{"t":"لآياتنا عنيدا","m":"معاندا جَاحِدًا أو مُـجانيا  للحقّ"}]}]},{"ayah":17,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَأُرْهِقُهُ صَعُودًا","m":"سَأُكَلِّفُهُ عَذَابًا شَاقًّا لَا رَاحَةَ لَهُ فِيهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"سَأُرْهِقُهُ صَعُوداً","m":"سأغشيه مشقّة من العذاب صَعُوداً أي عقبة شاقّة [زه] ويقال: إن