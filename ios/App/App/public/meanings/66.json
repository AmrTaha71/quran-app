[{"ayah":1,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كان رسول الله صلى الله عليه وس","m":"كان رسول الله صلى الله عليه وسلم قد خلا بمارية في بيت حفصة فلما رأته قالت يا رسول الله في بيتي فقال هي علي حرام فلا تخبري عائشة وقال هلا أبوك وزبو عائشة واليا الناس بعدي"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ما أحلّ الله لك","m":"شرب العسل"},{"t":"تبْـتغي","m":"تـَـطلب"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَحِلَّةَ أَيْمَانِكُمْ","m":"تَحْلِيلَ أَيْمَانِكُمْ بِأَدَاءِ الكَفَّارَةِ عَنْهَا."},{"t":"مَوْلَاكُمْ","m":"نَاصِرُكُمْ، وَمُتَوَلِّي أُمُورِكُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تحلة أيمانكم","m":"زي كفارتها"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تحلّة أيْمانكمْ","m":"تحليلها بالكفّارة"},{"t":"الله مولاكمْ","m":"ناصِركم و متولّي أموركم"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بَعْضِ أَزْوَاجِهِ","m":"هِيَ: حَفْصَةُ بِنْتُ عُمَرَ رضي الله عنهما."},{"t":"وَأَظْهَرَهُ","m":"أَطْلَعَهُ."},{"t":"عَرَّفَ بَعْضَهُ","m":"أَعْلَمَ حَفْصَةَ رَضِيَ اللهُ عَنْهَا بَعْضَ مَا أَخْبَرَتْ بِهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إلى بعض أزواجه","m":"وهي حفصة"},{"t":"حديثا","m":"وهو قوله هي علي حرام فزخبرت به عائشة فأطلع الله نبيه عليه السلاكم علي ذلك"},{"t":"عرف بعضه","m":"حدثها ما حدثته عائشة من تحريم مارية"},{"t":"وأعرض عن بعض","m":"ذكر الخلافة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"نبّـأت به","m":"أخْـبَرَتْ به غيرها"},{"t":"أظهَرَه الله عليه","m":"أطلعه الله تعالى على إفشائه"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَتُوبَا إِلَى اللَّهِ","m":"تَرْجِعَا - يَا حَفْصَةُ، وَيَا عَائِشَةُ - إِلَى اللهِ."},{"t":"صَغَتْ قُلُوبُكُمَا","m":"مَالَتْ إِلَى مَحَبَّةِ مَا كَرِهَهُ الرَّسُولُ - صلى الله عليه وسلم - مِنْ إِفْشَاءِ سِرِّهِ."},{"t":"وَإِن تَظَاهَرَا عَلَيْهِ","m":"وَإِنْ تَتَعَاوَنَا عَلَيْهِ."},{"t":"ظَهِيرٌ","m":"أَعْوَانٌ، وَأَنْصَارٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"صَغَتْ قُلُوبُكُما","m":"أي مالت."},{"t":"ظَهِيرٌ","m":"أي عون."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إن تتوبا إلى الله","m":"أي من التعاون على رسول الله صلى الله عليه وسلم بالإذاء"},{"t":"فقد صغت","m":"زاغت وأثمت"},{"t":"وصالح المؤمنين","m":"خيارهم"},{"t":"ظهير","m":"أي ظهران"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صَغَتْ قلوبكما","m":"مَالتْ عن حَقـّه صلى الله عليه و سلم عليكما"},{"t":"تظاهَرَا عليه","m":"تتعاونـَا عليه بما يسوءُه"},{"t":"هو مولاه","m":"وَليّـه  و ناصِره"},{"t":"ظهير","m":"فوْجٌ مُظاهر معينٌ له"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَائِحَاتٍ","m":"صَائِمَاتٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"سائِحاتٍ","m":"أي صائمات. والسّياحة في هذه الأمة: الصّوم."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"قانتات","m":"مطيعات خاضعاتٍ لله"},{"t":"سائحات","m":"مهاجرَاتٍ . أو صائمات"}]}]},{"ayah":6,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"قُوا أَنْفُسَكُمْ","m":"أي احفظوها، والأمر منه: ق."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"قوا أنفسكم وأهليكم نارا","m":"أي علموهم وأدبوهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"قوا أنفسكم","m":"جَـنّـبوها بالطاعات"},{"t":"غِلاظ شِداد","m":"قساةٌ أقوياء و هم الزبانية"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَوْبَةً نَّصُوحًا","m":"صَادِقَةً لَا يَعُودُ صَاحِبُهَا إِلَى الذَّنْبِ، وَلَا يُرِيدُ العَوْدَ إِلَيْهِ."},{"t":"لَا يُخْزِي","m":"لَا يُذِلُّ، وَلَا يُعَذِّبُ."},{"t":"يَسْعَى","m":"يَسِيرُ."},{"t":"بَيْنَ أَيْدِيهِمْ","m":"أَمَامَهُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَوْبَةً نَصُوحاً","m":"النّصوح: فعول من النّصح. والنّصوح، بالضم:مصدر نصحت له نصحا ونصوحا  . والتوبة النّصوح: المبالغة في النّصح التي لا ينوي التائب معها معاودة المعصية. وقال الحسن رحمه الله: ندم بالقلب واستغفار باللّسان وترك بالجوارح وإضمار ألا يعود  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"نصوحا","m":"أي توبة بالغة في النصح"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"توبة نـَـصوحا","m":"خالصة . أو صادقة . أو مقبولة"},{"t":"لا يُخزي الله النبي","m":"لا يُـذلّه بل يُعزّه و يكرمه"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَاغْلُظْ عَلَيْهِمْ","m":"اسْتَعْمِلِ الخُشُونَةَ وَالشِّدَّةَ فيِ جِهَادِهِمْ."},{"t":"وَمَاوَاهُمْ","m":"مَسْكَنُهُمْ."},{"t":"الْمَصِيرُ","m":"المَرْجِعُ، وَالمَآلُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"اغلظ عليهم","m":"شدِّدْ. أو اقـْـسُ عليهم"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَخَانَتَاهُمَا","m":"بِالكُفْرِ، وَالمُخَالَفَةِ فِي الدِّينِ."},{"t":"فَلَمْ يُغْنِيَا","m":"فَلَمْ يَدْفَعَا وَيَمْنَعَا عَنْهُمَا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فخانتاهما","m":"بالكفر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فخانتاهما","m":"بالنّـفاق أو بالنميمة"},{"t":"فلم يغنيا عنهما","m":"فـلمْ يَدْفَعا و لم يمْنعاعنهما"}]}]},{"ayah":11,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من فرعون وعمله","m":"دينه وقيل جماعته"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَحْصَنَتْ","m":"حَفِظَتْ وَصَانَتْ عَنِ الزِّنَى."},{"t":"فَنَفَخْنَا فِيهِ مِن رُّوحِنَا","m":"جِبْرِيلَ - عليه السلام -، حَيْثُ نَفَخَ فِي جَيْبِ قَمِيصِهَا؛ فَوَصَلَتِ النَّفْخَةُ إِلَى رَحِمِهَا."},{"t":"الْقَانِتِينَ","m":"المُطِيعِينَ لِرَبِّهِمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أحصنت فرجها","m":"عَـفّـتْ و صانته من الرّجال"},{"t":"من روحنا","m":"روحًا مِنْ خَلقِـنـَـا بلا توسّط أبٍ (عيسى عليه السلام)"},{"t":"من القانتين","m":"من القوم المطيعين لربّهم"}]}]}]