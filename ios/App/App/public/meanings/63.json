[{"ayah":1,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لكاذبون","m":"لأنهم أضمروا غير ما أظهروا وذلك الكذب لأنهم آمنوا باللسان ثم كفروا في السر"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"جُنَّةً","m":"وِقَايَةً وَسُتْرَةً لَهُمْ مِنَ المُؤَاخَذَةِ وَالعَذَابِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"جُـنّة","m":"وقاية لأنفسهم و أموالهم"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"آمَنُوا","m":"أَيْ: فِي الظَّاهِرِ لَا غَيْرُ."},{"t":"فَطُبِعَ","m":"خُتِمَ."},{"t":"لَا يَفْقَهُونَ","m":"لَا يَفْهَمُونَ مَا فِيهِ صَلَاحُهُمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"آمنوا","m":"بألسِنـَتهم لا غير"},{"t":"فطُــبع","m":"خُـتم بسبَب الكفر"},{"t":"لا يفقهون","m":"لا يعرفون حقيقة الإيمان"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَسْمَعْ لِقَوْلِهِمْ","m":"تَسْمَعْ لِحَدِيثِهِمْ؛ لِفَصَاحَتِهِمْ."},{"t":"كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ","m":"كَأَنَّهُمْ لِخُلُوِّ قُلُوبِهِمْ مِنَ الإِيمَانِ، وَعُقُولِهِمْ مِنَ الفَهْمِ: أَخْشَابٌ مُلْقَاةٌ عَلَى حَائِطٍ."},{"t":"يَحْسَبُونَ","m":"يَظُنُّونَ."},{"t":"كُلَّ صَيْحَةٍ عَلَيْهِمْ","m":"كُلَّ صَوْتٍ عَالٍ وَاقِعًا عَلَيْهِمْ؛ لِعِلْمِهِمْ بِحَقِيقَةِ حَالِهِمْ، وَلِخَوْفِهِمْ."},{"t":"قَاتَلَهُمُ اللَّهُ","m":"أَخْزَاهُمْ، وَطَرَدَهُمْ مِنَ رَحْمَتِهِ."},{"t":"أَنَّى يُؤْفَكُونَ","m":"كَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ بَعْدَ قِيَامِ البُرْهَانِ؟!"}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَأَنَّهُمْ خُشُبٌ","m":"جمع خشبة."},{"t":"مُسَنَّدَةٌ","m":"منصوبة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"مسندة","m":"أي ممالة رلى الجدار والمراد أنها ليست بأشجار تثمر وتنمي ثم عابهم بالجبن فقال"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"خُشُبٌ مُسنّـدة","m":"إلى الحائط ، أجسامٌ بلا أحلام"},{"t":"هم العدوّ","m":"الراسخون في العداوة"},{"t":"أنّى يؤفكون ؟","m":"كيف يُصرَفون عن الحقّ؟"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَوَّوْا رُؤُوسَهُمْ","m":"عَطَفُوهَا إِعْرَاضًا، وِاسْتِهْزَاءً."},{"t":"يَصُدُّونَ","m":"يُعْرِضُونَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لوّوْا رؤوسهم","m":"عَطفوها إعرَاضا و استهزاءً"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَنفَضُّوا","m":"يَتَفَرَّقُوا عَنْهُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حتى ينفضّوا","m":"كيْ يَـتفـرقوا عنه"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"رَّجَعْنَا","m":"مِنْ غَزْوَةِ بَنِي المُصْطَلِقِ."},{"t":"الْأَعَزُّ","m":"الأَقْوَى؛ يَعْنُونَ: أَنْفُسَهُمْ."},{"t":"الْأَذَلَّ","m":"الأَضْعَفَ وَالأَهْوَنَ؛ يَعْنُونَ: رَسُولَ اللهِ - صلى الله عليه وسلم -، وَمَنْ مَعَهُ."},{"t":"الْعِزَّةُ","m":"القُوَّةُ، وَالغَلَبَةُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ليخرجن الأعز","m":"هذا قول ابن أبي وعنى بالأعز نفسه وبالأذل رسول الله صلى الله عليه وسلم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"رَجَعْنـَـا","m":"من غزوة بني المصطلق"},{"t":"ليُـخْرجَنّ الأعزّ","m":"الأشد  و الأقوى يَعنون أنفسهم"},{"t":"الأذلّ","m":"الأضعف و الأهون . يعنون الرسول و المؤمنين"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا تُلْهِكُمْ","m":"لَا تَشْغَلْكُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"عن ذكر الله","m":"وهو طاعته في الجهاد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تـلهكم","m":"لا تشغَـلْـكم و تصْرفكمْ"},{"t":"ذِكر الله","m":"عِبادَته و طاعته و مراقبته"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَوْلَا أَخَّرْتَنِي","m":"هَلَّا أَمْهَلْتَنِي، وَأَخَّرْتَ أَجَلِي."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وأنفقوا","m":"يعني زكاة المال"},{"t":"إلى أجل قريب","m":"يعني الاستزادة في الأجل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لوْلا أخّرتني","m":"هلاّ أمهلتني و أخّرت أجَلي"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَجَلُهَا","m":"وَقْتُ مَوْتِهَا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"و لله العزّة","m":"الغَـلبة و القهْر"}]}]}]