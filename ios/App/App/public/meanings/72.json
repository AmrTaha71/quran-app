ر والكذب وهو وصفه بالشريك"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يَقول سَفـيهُـنا","m":"جَـاهِـلنا (إبليس اللعين)"},{"t":"شططا","m":"قوْلاً مُـفرطًـا في الكذب و الضّـلال"}]}]},{"ayah":5,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الآن","m":"أي بعد بعث محمد صلى الله عليه وسلم"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَعُوذُونَ","m":"يَسْتَجِيرُونَ، وَيَسْتَعِيذُونَ."},{"t":"رَهَقًا","m":"طُغْيانًا، وَسَفَهًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"رَهَقاً","m":"ما يرهقه أي يغشاه من المكروه، أو نقصا بلغة قريش  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وأنه كان رجال من الإنس","m":"وهذا في الجاهلية كان الرجل إذا سافر فأمسى في نفر من الأرض قال أعوذ بسيد هذا الوادي من شرسفهاء قومه فيبيت في جوار منهم"},{"t":"فزادوهم","m":"أي أن الإنس زادوا الجن"},{"t":"رهقا","m":"ضلالا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يَعوذون","m":"يَسْـتعيذون و يَتحيّـرون"},{"t":"فزادوهمْ رَهَـقـا","m":"إثما . أو طغيانا و سَفَها"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَأَنَّهُمْ ظَنُّوا","m":"وَأَنَّ كُفَّارَ الإِنْسِ حَسِبُوا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وأنهم","m":"يعني الجن"},{"t":"ظنوا كما ظننتم","m":"أيها المشركون"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَمَسْنَا السَّمَاءَ","m":"طَلَبْنَا بُلُوغَ السَّمَاءِ؛ لِاسْتِرَاقِ السَّمْعِ."},{"t":"وَشُهُبًا","m":"نُجُومًا مُحْرِقَةً؛ وَذَلِكَ لَمَّا بُعِثَ النَّبِيُّ - صلى الله عليه وسلم -."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شُهُباً","m":"جمع شهاب، يعني الكوكب. والشّهاب: كل متوقّد مضيء."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","wor