[
  {
    "id": 8,
    "surah_no": 2,
    "ayah_no": 1,
    "ayah_text": "\u0627\u0644\u0653\u0645\u0651\u0653\u06da\u200f"
  },
  {
    "id": 9,
    "surah_no": 2,
    "ayah_no": 2,
    "ayah_text": "\u0630\u0670\u0644\u0650\u0643\u064e \u0627\u0644\u06e1\u0643\u0650\u062a\u0670\u0628\u064f \u0644\u064e\u0627 \u0631\u064e\u064a\u06e1\u0628\u064e\u06db\u06da\u06d6 \u0641\u0650\u064a\u06e1\u0647\u0650\u06db\u06da \u0647\u064f\u062f\u064b\u064a \u0644\u0650\u0651\u0644\u06e1\u0645\u064f\u062a\u064e\u0651\u0642\u0650\u064a\u06e1\u0646\u064e\u06d9\u200f"
  },
  {
    "id": 10,
    "surah_no": 2,
    "ayah_no": 3,
    "ayah_text": "\u0627\u0644\u064e\u0651\u0630\u0650\u064a\u06e1\u0646\u064e \u064a\u064f\u0648\u0654\u06e1\u0645\u0650\u0646\u064f\u0648\u06e1\u0646\u064e \u0628\u0650\u0627\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0648\u064e\u064a\u064f\u0642\u0650\u064a\u06e1\u0645\u064f\u0648\u06e1\u0646\u064e \u0627\u0644\u0635\u064e\u0651\u0644\u0670\u0648\u0629\u064e \u0648\u064e\u0645\u0650\u0645\u064e\u0651\u0627 \u0631\u064e\u0632\u064e\u0642\u06e1\u0646\u0670\u0647\u064f\u0645\u06e1 \u064a\u064f\u0646\u06e1\u0641\u0650\u0642\u064f\u0648\u06e1\u0646\u064e\u06d9\u200f"
  },
  {
    "id": 270,
    "surah_no": 2,
    "ayah_no": 263,
    "ayah_text": "\u0642\u064e\u0648\u06e1\u0644\u064c \u0645\u064e\u0651\u0639\u06e1\u0631\u064f\u0648\u06e1\u0641\u064c \u0648\u064e\u0651\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u064c \u062e\u064e\u064a\u06e1\u0631\u064c \u0645\u0650\u0651\u0646\u06e1 \u0635\u064e\u062f\u064e\u0642\u064e\u0629\u064d \u064a\u064e\u0651\u062a\u06e1\u0628\u064e\u0639\u064f\u0647\u064e\u0627\u0658 \u0627\u064e\u0630\u064b\u064a\u0615 \u0648\u064e\u0627\u0644\u0644\u0651\u0670\u0647\u064f \u063a\u064e\u0646\u0650\u064a\u064c\u0651 \u062d\u064e\u0644\u0650\u064a\u06e1\u0645\u064c"
  },
  {
    "id": 3706,
    "surah_no": 36,
    "ayah_no": 1,
    "ayah_text": "\u064a\u0670\u0633\u0653\u06da\u200f"
  },
  {
    "id": 5205,
    "surah_no": 64,
    "ayah_no": 6,
    "ayah_text": "\u0630\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0627\u064e\u0646\u064e\u0651\u0647\u0657 \u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u062a\u064e\u0651\u0627\u06e1\u062a\u0650\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0631\u064f\u0633\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u0628\u0650\u0627\u0644\u06e1\u0628\u064e\u064a\u0650\u0651\u0646\u0670\u062a\u0650 \u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u06e1\u0658\u0627 \u0627\u064e\u0628\u064e\u0634\u064e\u0631\u064c \u064a\u064e\u0651\u0647\u06e1\u062f\u064f\u0648\u06e1\u0646\u064e\u0646\u064e\u0627\u0617 \u0641\u064e\u0643\u064e\u0641\u064e\u0631\u064f\u0648\u06e1\u0627 \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u064e\u0651\u0648\u06e1\u0627 \u0648\u064e\u0651\u0627\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u064a \u0627\u0644\u0644\u0651\u0670\u0647\u064f\u0615 \u0648\u064e\u0627\u0644\u0644\u0651\u0670\u0647\u064f \u063a\u064e\u0646\u0650\u064a\u064c\u0651 \u062d\u064e\u0645\u0650\u064a\u06e1\u062f\u064c"
  },
  {
    "id": 5272,
    "surah_no": 68,
    "ayah_no": 1,
    "ayah_text": "\u0646\u0653 \u0648\u064e\u0627\u0644\u06e1\u0642\u064e\u0644\u064e\u0645\u0650 \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0633\u06e1\u0637\u064f\u0631\u064f\u0648\u06e1\u0646\u064e\u06d9\u200f"
  },
  {
    "id": 6189,
    "surah_no": 105,
    "ayah_no": 1,
    "ayah_text": "\u0627\u064e\u0644\u064e\u0645\u06e1 \u062a\u064e\u0631\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0641\u064e\u0639\u064e\u0644\u064e \u0631\u064e\u0628\u064f\u0651\u0643\u064e \u0628\u0650\u0627\u064e\u0635\u06e1\u062d\u0670\u0628\u0650 \u0627\u0644\u06e1\u0641\u0650\u064a\u06e1\u0644\u0650\u0615\u200f"
  }
]
