[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُسَبِّحُ","m":"يُنَزِّهُ اللهَ عَنْ كُلِّ مَا لَا يَلِيقُ بِهِ."},{"t":"الْقُدُّوسِ","m":"المُنَزَّهِ عَنْ كُلِّ نَقْصٍ."},{"t":"الْعَزِيزِ","m":"القَوِيِّ الغَالِبِ الَّذِي لَا يُغَالَبُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يسبّح لله","m":"يُنـزّهه و يُمَجّده تعالى و يدلّ عليه"},{"t":"الملك","m":"مالك الأشياء كلّها"},{"t":"القدوس","m":"البليغ في النّـزاهة عن النّـقائص"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْأُمِّيِّينَ","m":"العَرَبِ الَّذِينَ لَا يَقْرَؤُونَ، وَلَا كِتَابَ عَنْدَهُمْ."},{"t":"وَيُزَكِّيهِمْ","m":"يُطَهِّرُهُمْ مِنَ العَقَائِدِ الفَاسِدَةِ، وَالأَخْلَاقِ السَّيِّئَةِ."},{"t":"الْكِتَابَ","m":"القُرْآنَ."},{"t":"وَالْحِكْمَةَ","m":"السُّنَّةَ، وَإِذَا جَاءَتِ الحِكْمَةُ مَعَ الكِتَابِ فَالمُرَادُ بِهَا: السُّنَّةُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"في الأميين","m":"يعني العرب وكانوا لا يكتبون"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الأميين","m":"العرب المعاصرين له صلى الله عليه و سلم"},{"t":"يزكّيهم","m":"يُطهّرُهم من أدناس الجاهليّة"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَآخَرِينَ مِنْهُمْ","m":"وَبَعَثَهُ إِلَى قَوْمٍ آخَرِينَ مِنَ العَرَبِ، وَغَيْرِهِمْ."},{"t":"لَمَّا يَلْحَقُوا بِهِمْ","m":"لَمْ يَجِيئُوا بَعْدُ، وَسَيَجِيئُونَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وآخرين","m":"أي وبعث محمدا صلى الله عليه وسلم في آخرين من الأميين وهم العجم وإنما قال"},{"t":"منهم","m":"لأنهم رذا أسلموا صاروا منهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أخرين منهم","m":"من العَرَب"},{"t":"لمّـا يَلحقوا بهم","m":"لمْ يلحقوا بهمْ بَعد و سيلحقون"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَسْفَارًا","m":"كُتُبًا."},{"t":"بِئْسَ مَثَلُ الْقَوْمِ","m":"قَبُحَ مَثَلُهُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَسْفاراً","m":"كتبا، واحدها: سفر [زه] بلغة كنانة  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"حملوا التوراة","m":"كلفوا العمل بما فيها"},{"t":"ثم لم يحملوها","m":"أي لم يعملوا بموجبها شبههم بالحمار لأنه لا يعقل ما يحمل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حُـمّـلوا التوراة","m":"كُـلّـفوا العمل بما فيها (اليهود)"},{"t":"يَحْمِل أسفارًا","m":"كُتـبا عظاما و لا ينتفع بها"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"هَادُوا","m":"تَدَيَّنُوا بِاليَهُودِيَّةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فتمنوا الموت","m":"لأن الآخرة خير لأولياء الله من الدنيا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"هَادوا","m":"تديّـنوا باليهودية"}]}]},{"ayah":8,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"العزيز","m":"القادر الغالب القاهر"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَاسْعَوْا","m":"فَامْضُوا."},{"t":"وَذَرُوا","m":"اتْرُكُوا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَاسْعَوْا إِلى ذِكْرِ اللَّهِ","m":"بادروا بالنّيّة والجدّ، ولم يرد العدو والإسراع في المشي  ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ذروا البيْع","m":"اتركوه و تفرّغوا لذكر الله"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَضْلِ اللَّهِ","m":"رِزْقِ اللهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من فضل الله","m":"إباحة لطلب الرزق بالتجارة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فانتشروا","m":"تفـرّ قو