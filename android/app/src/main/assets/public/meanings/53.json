[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالنَّجْمِ إِذَا هَوَى","m":"قَسَمٌ بِالثُّرَيَّا إِذَا غَابَتْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالنَّجْمِ","m":"قيل: كان ينزل القرآن نجوما فأقسم الله- عز وجل- بالنّجم منه إذا نزل. وقال أبو عبيدة: والنجم: قسم به  ، والنّجم في معنى النجوم."},{"t":"إِذا هَوى","m":"إذا سقط في المغرب"}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"النجم","m":"وقيل القرآن نزل نجوما"},{"t":"لما انشق القمر في عهد رسول الل","m":"لما انشق القمر في عهد رسول الله صلى اله عليه وسلم قالوا سحركم فنزلت الايات"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"و النّجم إذا هوَى","m":"(قسَم) بالنّجم إذا غرب و سَقط"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَا ضَلَّ","m":"مَا حَادَ عَنِ الحَقِّ."},{"t":"وَمَا غَوَى","m":"مَا اعْتَقَدَ بَاطِلًا قَطُّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ما ضل","m":"عن طريق الهدى"},{"t":"والمستمر الذاهب والمعنى هذا سح","m":"والمستمر الذاهب والمعنى هذا سحر والسحر لا يثبت"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ما ضلّ صاحبكم","m":"ما عدَل الرّسول عن الحقّ و الهُـدَى (جواب القسم)"},{"t":"ما غوَى","m":"ما اعتقد باطلا قطّ"}]}]},{"ayah":3,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"عن الهوى","m":"أي بالهوى"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِنْ هُوَ","m":"أَيِ: القُرْآنُ، والسُّنَّةُ."}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"شَدِيدُ الْقُوَى","m":"مَلَكٌ شَدِيدُ القُوَّةِ؛ وَهُوَ جِبْرِيلُ - عليه السلام -."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شَدِيدُ الْقُوى","m":"يعني جبريل عليه السلام. 