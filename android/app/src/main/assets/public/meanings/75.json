 تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَتَمَطَّى","m":"يتبختر، يقال جاء يمشي المطيطاء وهي مشية تبختر وهي أن يلقي بيده ويتكفّأ، وكان الأصل: يتمطّط فقلبت إحدى الطاءين ياء، كما قيل: يتظنّى فيما أصله يتظنّن. وقيل: يتمطّى: يتبختر ويمد مطاه في مشيته. ويقال: يلوي مطاه تبخترا. والمطا: الظّهر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يتمطى","m":"أي يتبختر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يَتمَطى","m":"يَـتبَختر في مِشيَـتِه اخْتِـيالا"}]}]},{"ayah":34,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَوْلَى لَكَ فَأَوْلَى","m":"كَلِمَةُ وَعِيدٍ، أَيْ: هَلَاكٌ لِكَ فَهَلَاكٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَوْلى لَكَ فَأَوْلى","m":"تهدّد ووعيد، أي قد وليك شرّ فاحذره."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أولي","m":"تهدد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أوْلى لك","m":"قارَبَك ما يُهْـلِـكُـك"}]}]},{"ayah":36,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سُدًى","m":"هَمَلًا لَا يُؤْمَرُ، وَلَا يُحَاسَبُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَنْ يُتْرَكَ سُدىً","m":"مهملا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"سدى","m":"مهملا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يُـتـْـرَك سُـدًى","m":"مُهْمَلا فلا يُكلـّـف و لا يُجَـازَى"}]}]},{"ayah":37,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُمْنَى","m":"يُصَبُّ فِي الرَّحِمِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مَنِيّ يُمْـنـَى","m":"يُصَبّ في الرّحم"}]}]},{"ayah":38,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عَلَقَةً","m":"قِطْعَةً مِنْ دَمٍ جَامِدٍ."},{"t