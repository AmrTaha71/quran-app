[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالْفَجْرِ","m":"قَسَمٌ بِالوَقْتِ المَعْرُوفِ أَوَّلَ النَّهَارِ."}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَلَيَالٍ عَشْرٍ","m":"قَسَمٌ بِلَيَالِي عَشْرِ ذِي الحِجَّةِ الأُوَلِ، وَمَا شَرُفَتْ بِهِ مِنْ أَعْمَالٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلَيالٍ عَشْرٍ","m":"عشر الأضحى."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وليال عشر","m":"وهي عشر ذي الحجة"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالشَّفْعِ وَالْوَتْرِ","m":"قَسَمٌ بِكُلِّ زَوْجٍ، وَفَرْدٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الشَّفْعِ","m":"هو في اللّغة اثنان."},{"t":"وَالْوَتْرِ","m":"واحد.وقيل: الشّفع يوم الأضحى، والوتر: يوم عرفة [زه] وقيل: الوتر: الله تعالى، والشّفع: الخلق خلقوا أزواجا.وقيل: الوتر: آدم، شفع بزوجته.وقيل: الشّفع والوتر: الصّلاة منها شفع ومنها وتر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والشفع","m":"يوم عرفة ويوم الأضحى"},{"t":"والوتر","m":"ليلة النحر"},{"t":"والوالد آدم","m":"والوالد آدم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"والد و ما وَلد","m":"آدم و جميع ذريّـته أو الصالحين منهم"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَسْرِ","m":"يَسْرِي بِظَلَامِهِ، وَجَوَابُ القَسَمِ مَحْذُوفٌ، تَقْدِيرُهُ: لَتُبْعَثُنَّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والكبد الشدة المعنى أنه يكابد","m":"والكبد الشدة المعنى أنه يكابد الشدائد"},{"t":"الكفارات والنفقات مند دخلت في","m":"الكفارات والنفقات مند دخلت في دين محمد"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":