ًا بِلَا رَاعٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"نَفَشَتْ فِيهِ غَنَمُ الْقَوْمِ","m":"أي رعت ليلا. يقال: نفشت الغنم باللّيل، وسرحت، وسربت، وهملت بالنهار."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"نفشت","m":"رعت ليلا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الحرث","m":"الزّرع . أو الكرم"},{"t":"نفشت فيه","m":"انتشرت فيه ليلا بلا راعٍ فرعته"}]}]},{"ayah":79,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُسَبِّحْنَ","m":"تُسَبِّحُ الجِبَالُ مَعَهُ إِذَا سَبَّحَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ففهمناها","m":"يعني القضية وكانت غنم رجل قد دخلت حرث اخر فاكلته فقال داود لصاحب الحرث لك رقاب الغنم فقال سليمان او غير ذلك قال ما هو قال ينطلق اصحاب الحرث بالغنم فيصيبون من البانها ومنافعها ويقبل اصحاب الغنم على الكرم حتى اذا عاد كما كان سلموه اربابا وتسلموا غنمهم ومذهب احمد انه اذا جرى مثل هذا وجب الضمان"}]}]},{"ayah":80,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"صَنْعَةَ لَبُوسٍ","m":"صِنَاعَةَ الدُّرُوعِ يَعْمَلُهَا حِلَقًا مُتَشَابِكَةً."},{"t":"لِتُحْصِنَكُم","m":"لِتَحْمِيَكُمْ."},{"t":"بَاسِكُمْ","m":"حَرْبِكُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لَبُوسٍ","m":"دروع يكون واحدا وجمعا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"صنعة لبوس","m":"وهي الدرع ولباس الحرب"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صنعة لَبوس","m":"عمل الدّروع تلبس في الحرب"},{"t":"لِتُحصنكم","m":"لتحفظكم و تقيكم"},{"t":"بأسكم","m":"حرب عدوّكم و إصابتكم بسلاحه"}]}]},{"ayah":81,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عَاصِفَةً","m":"شَدِيدَةَ الهُبُوبِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"حكما","m":"نبوة"},{"t":"إلى الأرض","m":"وهي ارض الشام"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عاصفة","m":"شديدة الهبوب"}]}]},{"ayah":82,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَغُوصُونَ لَهُ","m":"يَغُوصُونَ فِي البِحَارِ؛ لِاسْتِخْرَاجِ الَّلآلِئِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"دون ذلك","m":"أي سواه"},{"t":"حافظين","m":"ان يفسدوا ما عملوا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يغوصون له","m":"في البحار لاستخراج نفائسها"},{"t":"لهم حافظين","m":"من الزّيغ عن أمره أو الإفساد"}]}]},{"ayah":84,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ومثلهم معهم","m":"احيي الله له الاهل واثابه مثلهم في الدنيا"},{"t":"وذكرى","m":"عظة"}]}]},{"ayah":85,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَذَا الْكِفْلِ","m":"لم يكن نبيّا ولكن كان عبدا صالحا تكفّل بعمل رجل صالح عند موته. ويقال: تكفّل لنبيّ بقومه أن يقضي بينهم بالحقّ ففعل فسمّي ذا الكفل   قال ابن عباس: هو إلياس  . وقال الحسن: هو نبيّ اسمه ذو الكفل  .وقيل: هو يوشع بن نون  . والكفل: الحظّ. ويقال: هو حزقيل «7» ، وهو ثالث خلفاء بني إسرائيل بعد موسى، ويعرف بابن العجوز. وقيل: إنه سمّي ذا الكفل لأنه تكفّل بسبعين نبيّا وأنجاهم من القتل. وفي أيامه، وقع الطاعون المشار إليه في قوله تعالى: أَلَمْ تَرَ إِلَى الَّذِينَ خَرَجُوا مِنْ دِيارِهِمْ وَهُمْ أُلُوفٌ حَذَرَ الْمَوْتِ «8» ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وذا الكفل","m":"هل هو نبي ام رجل صالح فيه قولان تكفل النبي بعباده يفعلها فوفى"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ذا الكفل","m":"قيل هو إلياس عليه السّلام"}]}]},{"ayah":87,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَذَا النُّونِ","m":"وَصَاحِبَ الحُوتِ، وَهُوَ يُونُسُ - عليه السلام -."},{"t":"أَن لَّن نَّقْدِرَ عَلَيْهِ","m":"أَن لَّنْ نُضَيِّقَ عَلَيْهِ فِي بَطْنِ الحُوتِ، وَنُؤَاخِذَهُ