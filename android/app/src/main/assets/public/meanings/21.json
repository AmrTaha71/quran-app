 بالبعث للجزاء"}]}]},{"ayah":96,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فُتِحَتْ يَاجُوجُ","m":"أَيْ: سَدُّ يَاجُوجَ."},{"t":"حَدَبٍ","m":"مُرْتَفِعٍ مِنَ الأَرْضِ."},{"t":"يَنسِلُونَ","m":"يُسْرِعُونَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"حَدَبٍ","m":"نشز ونشز من الأرض، أي ارتفاع منها."},{"t":"يَنْسِلُونَ","m":"أي من كل جانب يخرجون، بلغة جرهم  :يسرعون، من النّسلان  ، وهو مقاربة الخطو مع الإسراع كمشي الذّئب إذا أسرع، يقال: مرّ الذّئب ينسل ويعسل."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فتحت يأجوج ومأجوج","m":"أي فتح الردم عنهم"},{"t":"ينسلون","m":"من النسلان وهو مقاربة الخطو مع الاسراع"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حَدَبٍ","m":"مرتفع من الأرض"},{"t":"ينسِلون","m":"يُسرعون المشي في الخروج"}]}]},{"ayah":97,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْوَعْدُ الْحَقُّ","m":"يَوْمُ القِيَامَةِ."},{"t":"شَاخِصَةٌ","m":"مَفْتُوحَةٌ لَا تَكَادُ تَطْرِفُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شاخِصَةٌ أَبْصارُ الَّذِينَ كَفَرُوا","m":"أي مرتفعة الأجفان لا تكاد تطرف من هول ما هم فيه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الوعد","m":"القيامة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الوعد الحقّ","m":"البعث و الحساب و الجزاء"},{"t":"شاخصة أبصار","m":"مُرتفعة لا تكاد تطرف أبصار . ."}]}]},{"ayah":98,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"حَصَبُ جَهَنَّمَ","m":"وَقُودُهَا، وَحَطَبُهَا."},{"t":"وَارِدُونَ","m":"دَاخِلُونَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"حَصَبُ جَهَنَّمَ","m":"يعني الحطب بلغة قريش، [و] كلّ شيء ألقيته في النار فقد حصبتها به. ويقال: حصب جهنّم: حطبها بالحبشية  وقوله:«بالحبشية» إن كان أراد أنّ هذه الكلمة حبشية وعربية بلفظ واحد، فهو وجه واه «7» ، أو أراد أنّها حبشية الأصل سمعتها العرب فتكلمت بها «8» بها فصارت عربية حينئذ،فذلك وجه، وإلا فليس في القرآن غير العربية. ويقرأ حضب جهنّم  بالضّاد المعجمة وهو ما هيّجت به النار وأوقدتها  إن أراد بالعربية استعمال العرب فلا شكّ في صحة ما قال: أي ليس فيه إلا ما هو على وفق استعمالهم في أساليب كلامهم. وإن أراد وضعهم فهو محلّ النّزاع، فمن قال: إنّ اللّغات توقيفية أي واضعها هو الله تعالى فيمنع ذلك، وإلا فمذهبان في ثبوت المعرّب فيه والمحقّقون على النّفي، وليس محل الخلاف الأعلام كإبراهيم ونحوه للاتفاق على أن أحد سببي منعه الصّرف العجمة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"واردون","m":"داخلون"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حصب جهنّم","m":"حطبها ووقودها الذي به تهيَّج"},{"t":"لها واردون","m":"فيها داخلون"}]}]},{"ayah":99,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لو كان هؤلاء","m":"الاصنام"}]}]},{"ayah":100,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"زَفِيرٌ","m":"تَنَفُّسٌ شَدِيدٌ تَنْتَفِخُ مِنْهُ الضُّلُوعُ يَدُلُّ عَلَى شِدَّةِ عَذَابِهِمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا يسمعون","m":"لان في السماع انسا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"زفير","m":"تنفّس شديد تنتفخ منه الضّلوع"}]}]},{"ayah":101,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إن الذين سبقت لهم منا الحسنى","m":"وهي السعادة"}]}]},{"ayah":102,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"حَسِيسَهَا","m":"صَوْتَ لَهِيبِهَا، وَاحْتِرَاقِ الأَجْسَادِ فِيهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"حَسِيسَها","m":"صوتها."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"حسيسها","m":"صوت حركة تلهّبها"}]}]},{"ayah":103,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عب