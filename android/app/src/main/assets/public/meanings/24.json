َ جُمِعُوا لَهُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"على أمر جامع","m":"أي على أمر يجتمع عليه نحو الجهاد والعيد والجمعة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أمر جامع","m":"أمر مهمّ يجب اجتماعهم له"}]}]},{"ayah":63,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"دُعَاءَ الرَّسُولِ","m":"نِدَاءَكُمْ لَهُ بِأَنْ تَقُولُوا: يَا مُحَمَّدُ! وَلَكِنْ قُولُوا: يَا رَسُولَ اللهِ!"},{"t":"يَتَسَلَّلُونَ مِنكُمْ","m":"يَخْرُجُونَ خُفْيَةً بِغَيْرِ إِذْنٍ."},{"t":"لِوَاذًا","m":"يَسْتَتِرُ بَعْضُهُمْ بِبَعْضٍ فِي الخُرُوجِ."},{"t":"فِتْنَةٌ","m":"مِحْنَةٌ، وَشَرٌّ، وَعَذَابٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَتَسَلَّلُونَ","m":"يخرجون من الجماعة واحدا واحدا، كقولك:سللت كذا من كذا، إذا أخرجته منه."},{"t":"لِواذاً","m":"مصدر لاوذته ملاوذة ولواذا: أي يلوذ بعضهم ببعض، أي: يستتر به."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا تجعلوا دعاء الرسول","m":"أمروا أن يقولوا يا رسول الله صلى الله عليه وسلم ولا يقولوا يا محمد والتسلل الخروج في الخفية واللواذ أن يستتر بشيء"},{"t":"أمره","m":"قولان أحدهما أنها ترجع إلى الله عز وجل والثاني إلى الرسول صلى الله عليه وسلم و"},{"t":"عن","m":"زائدة والفتنة البلاء"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"دعاء الرّسول","m":"دعوته لكم للاجتماع أو نداءكم له"},{"t":"يتسلّلون منكم","m":"يخرجون منكم تدريجا في خفية"},{"t":"لِواذا","m":"يستتر بعضهم ببعض في الخروج"},{"t":"يخالفون عن أمره","m":"يعرضون أو يصدون عنه"},{"t":"فتنة","m":"بلاء و محنة في الدنيا"}]}]}]