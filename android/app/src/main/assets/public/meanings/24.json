[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَفَرَضْنَاهَا","m":"أَوْجَبْنَا العَمَلَ بِأَحْكَامِهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَرَضْناها","m":"أي فرضنا ما فيها. وفَرَضْناها  : أنزلنا فيها فرائض مختلفة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وفرضناها","m":"أي فرضنا فيها فروضا ومن خلف أراد ألزمناكم العمل بما فرض فيها"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فرضناها","m":"أوجبنا أحكامها عليكم"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"طَائِفَةٌ","m":"جَمَاعَةٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"رَأْفَةٌ","m":"هي أرقّ الرّحمة."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كلّ واحد","m":"إذا كان حُرّا غير مُحصن"}]}]},{"ayah":3,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا ينكح إلا زانية","m":"النكاح ها هنا الجماع والمعنى لا يزني الزاني إلا بزانية أو مشركة"},{"t":"وحرم ذلك","m":"يعني الزنا"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَرْمُونَ","m":"يَقْذِفُونَ بِالزِّنَى."},{"t":"الْمُحْصَنَاتِ","m":"العَفِيفَاتِ، وَمِثْلُهُنَّ العَفِيفُونَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يرمون المحصنات","m":"أي بالزنا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يرمون المحصنات","m":"يقذفون العفيفات بالزّنى"}]}]},{"ayah":5,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تابوا","m":"عن القذف"},{"t":"وأصلحوا","m":"أظهروا التوبة"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَيَدْرَأُ","m":"يَدْفَعُ العُقُوبَةَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يدرأ عنها العذاب","m":"يدفع عنها العقوبة"}]}]},{"ayah":10,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولولا فضل الله","m":"جوابه محذوف تقديره لنال الكاذب منكم عذاب عظيم"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِالْإِفْكِ","m":"أَشْنَعِ الكَذِبِ، وَهُوَ رَمْيُ أُمِّ المُؤْمِنِينَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا بِالزِّنَى."},{"t":"عُصْبَةٌ مِّنكُمْ","m":"جَمَاعَةٌ مِنْكُمْ."},{"t":"تَوَلَّى كِبْرَهُ","m":"تَحَمَّلَ مُعْظَمَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بِالْإِفْكِ","m":"أسوأ الكذب."},{"t":"كِبْرَهُ","m":"أي معظمه. قيل إنه بكسر الكاف وضمّها  لغتان بمعنى.ويقال: إنه بالكسر مصدر الكبير من الأشياء والأمور، وبالضم مصدر الكبير  السّن  وفي إضافة المصدر إلى الكبير تسامح."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"جاؤوا بالإفك","m":"يعني الكذب"},{"t":"لا تحسبوه","m":"خطاب لعائشة وصفوان وقيل لرسول الله صلى الله عليه وسلم وأبي بكر وعائشة والمعني أنكم تؤجرون فيه"},{"t":"كبره","m":"معظمه والذي تولاه عبد الله بن أبي"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بالإفك","m":"أقبح الكذب و أفحشه"},{"t":"عصبة منكم","m":"جماعة منكم"},{"t":"تولّى كبره","m":"تحمّل معظمه (رأس المنافقين)"}]}]},{"ayah":12,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بأنفسهم خيرا","m":"أي بإخوانهم وأمهاتهم لأن المؤمنين كنفس واحدة"}]}]},{"ayah":13,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فأولئك عند الله","m":"أبي في حكمه"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَفَضْتُمْ فِيهِ","m":"خُضْتُمْ فِيهِ مِنْ حَدِيثِ الإِفْكِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أفضتم فيه","m":"خضتم فيه من حديث الإفك"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَلَقَّوْنَهُ","m":"تَتَلَقَّفُونَهُ، وَتَنْقُلُونَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَلَقَّوْنَهُ بِأَلْسِنَتِكُمْ","m":"تقبلونه  وتَلَقَّوْنَهُ  من الولق، وهو استمرار اللّسان بالكذب."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تلقونه","m":"أي يلقيه بعضكم إلى بعض وقرأت عائشة تلقونه أي"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تحسبونه هيّـنا","m":"تظنونه سهلا لا تبعة له"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بُهْتَانٌ","m":"كَذِبٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بُهْتانٌ","m":"البهتان: الكذب، يواجه به المؤمن فيتحيّر منه."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سبحانك","m":"تعجّب من شناعة هذا الإفك"},{"t":"بهتان","m":"كذب يُحيّر سامعه لفظاعته"}]}]},{"ayah":17,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَعِظُكُمُ","m":"يَنْهَاكُمْ."}]}]},{"ayah":19,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أن تشيع الفاحشة","m":"أن يفشوا لقذف بها"},{"t":"في الدنيا","m":"يعني المجلد"},{"t":"والآخرة","m":"عذاب النار"},{"t":"والله يعلم","m":"أي شر ما خصتم فيه"}]}]},{"ayah":21,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"خُطُوَاتِ الشَّيْطَانِ","m":"طُرُقَهُ، وَمَذَاهِبَهُ."},{"t":"مَا زَكَا","m":"مَا تَطَهَّرَ مِنَ الذُّنُوبِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ما زَكى مِنْكُمْ مِنْ أَحَدٍ","m":"أي لم يكن زاكيا، يقال: زكا فلان إذا كان زاكيا، وزكّاه  الله: أي جعله زاكيا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"خطوات الشيطان","m":"طرقه و أثاره و مذاهبه"},{"t":"بالفحشاء","m":"ما عَظُم قبحه من الذنوب"},{"t":"المنكر","m":"ما ينكره الشّرع و يكرهه الله"},{"t":"ما زكى","m":"ما تطهّر من دنس الذنوب"}]}]},{"ayah":22,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَلَا يَاتَلِ","m":"لَا يَحْلِفْ."},{"t":"أُوْلُوا الْفَضْلِ","m":"أَهْلُ الفَضْلِ فِي الدِّينِ، وَالمَالِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلا يَأْتَلِ","m":"يحلف «يفتعل» من الأليّة، وهي اليمين وقرئت يتألّ  على معنى «يتفعّل» ، من الأليّة أيضا. ويأتل: يفتعل أيضا من قولك:ما ألوت جهدا، أي: ما قصّرت."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولا يأتل","m":"أي يحلف وكان أبو بكر رضي الله عنه حلف لا ينفق على مسطح وكان ابن خالة أبي بكر وكان مهاجرا فقيرا لأن"},{"t":"أن يؤتوا","m":"أن لا يؤتوا فحذف لا فلما نزلت أعاد النفقة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا يأتـلِ","m":"لا يحلف أو لا يُقصّر"},{"t":"السّعة","m":"الغنى"}]}]},{"ayah":23,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْغَافِلَاتِ","m":"العَفِيفَاتِ اللَّوَاتِي لَمْ تَخْطُرِ الفَاحِشَةُ بِقُلُوبِهِنَّ."},{"t":"لُعِنُوا","m":"طُرِدُوا وَأُبْعِدُوا مِنْ رَحْمَةِ اللهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"المحصنات","m":"العفائف"},{"t":"الغافلات","m":"عن الفواحش"},{"t":"لعنوا في الدنيا","m":"عذبوا بالجلد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"المحصنات","m":"العفائف ، و مثلهن المحصنون"}]}]},{"ayah":24,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تشهد عليهم ألسنتهم","m":"أي تقر"}]}]},{"ayah":25,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"دِينَهُمُ الْحَقَّ","m":"جَزَاءَهُمْ بِالعَدْلِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"دينهم الحق","m":"أي حسابهم العدل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"دينهم الحقّ","m":"جزاءهم الثابت لهم بالعدل"}]}]},{"ayah":26,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْخَبِيثاتُ لِلْخَبِيثِينَ","m":"وكذلك الطيبات من الكلام للطيبين من الناس  أي الخبيثات من الكلام للخبيثين من الناس. وقيل: الخبيثات من النّساءللخبيثين من الرّجال، وكذلك الطيّبات من النّساء للطيبين من الرجال."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الخبيثات","m":"أي الكلمات الخبيثات لا يتكلم بها إلا الخبيث من الرجال والنساء والكلمات الطيبات لا يتكلم بها إلا الطيبون من الرجال والنساء"},{"t":"أولئك","m":"يعني عائشة وصفوان"}]}]},{"ayah":27,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَسْتَانِسُوا","m":"تَسْتَاذِنُوا أَهْلَ البُيُوتِ، وسُمِّيَ الِاسْتِئْذَانُ اسْتِئْنَاسًا؛ لِأَنَّهُ يُزِيلُ الوَحْشَةَ مِنَ القَادِمِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تستأنسوا","m":"أي تستأذنوا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أولوا الفضل","m":"أصحاب الزيادة في الدّين"},{"t":"تستأنسوا","m":"تستأذنوا ممن يملك الإذن"}]}]},{"ayah":28,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَزْكَى","m":"أَطْهَرُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أزكى لكم","m":"أطهر لكم من دنس الريبة و الدّناءة"}]}]},{"ayah":29,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فِيهَا مَتَاعٌ لَّكُمْ","m":"فَيهَا مَنْفَعَةٌ، وَمَصْلَحَةٌ لَكُمْ؛ كَالبُيُوتِ المُعَدَّةِ صَدَقَةً لِلْمُسَافِرِينَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غير مسكونة","m":"يعني الخانات والرباطات والبيوت المبنية للسابلة ليؤوا إليها"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"جناح","m":"إثم"},{"t":"متاع لكم","m":"منفعة و مصلحة لكم"}]}]},{"ayah":30,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَغُضُّوا مِنْ أَبْصارِهِمْ","m":"أي ينقصوا من نظرهم عما حرّم الله فقد أطلق لهم ما سوى ذلك."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من أبصارهم","m":"من زائدة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يغضوا من أبصارهم","m":"يكفوا نظرهم عن المحرّمات"}]}]},{"ayah":31,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِلَّا مَا ظَهَرَ مِنْهَا","m":"إِلَّا الثِّيَابَ الظَّاهِرَةَ الَّتِي جَرَتِ العَادَةُ بِلُبْسِهَا إِذَا لَمْ يَكُنْ فِيهَا فِتْنَةٌ."},{"t":"وَلْيَضْرِبْنَ","m":"وَلْيُلْقِينَ."},{"t":"بِخُمُرِهِنَّ","m":"بِأَغْطِيَةِ رُؤُوسِهِنَّ."},{"t":"عَلَى جُيُوبِهِنَّ","m":"عَلَى فَتَحَاتِ صُدُورِهِنَّ، فَيُغَطِّينَ وُجُوهَهُنَّ."},{"t":"لِبُعُولَتِهِنَّ","m":"لِأَزْوَاجِهِنَّ."},{"t":"نِسَائِهِنَّ","m":"المُسْلِمَاتِ، وَقِيلَ: المُخْتَصَّاتِ بِهِنَّ بِالصُّحْبَةِ وَالخِدْمَةِ."},{"t":"أُوْلِي الْإِرْبَةِ","m":"الرَّجَالِ الَّذِينَ لَا غَرَضَ لَهُمْ فِي النِّسَاءِ؛ كَالبُلْهِ."},{"t":"لَمْ يَظْهَرُوا","m":"لَا عِلْمَ لَهُمْ بِأُمُورِ العَوْرَاتِ، وَلَيْسَ فِيهِمْ شَهْوَةٌ."},{"t":"مَا يُخْفِينَ مِن زِينَتِهِنَّ","m":"كَالخَلَاخِلِ الَّتي تُلْبَسُ فِي الأَرْجُلِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بِخُمُرِهِنَّ","m":"جمع خمار، وهي المقنعة، سمّيت بذلك، لأن الرأس يخمّر بها، أي يغطّى، وكل شيء غطّيته فقد خمّرته. والخمر: ما واراك من شجر."},{"t":"الْإِرْبَةِ","m":"الحاجة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولا يبدين زينتهن","m":"يعني الخفية"},{"t":"إلا ما ظهر منها","m":"وهي الثياب والخمر جمع خمار وهو ما تغطى به المرأة رأسها"},{"t":"أو نسائهن","m":"يعني المسلمات"},{"t":"أو ما ملكت أيمانهن","m":"يعني الإماء دون العبيد"},{"t":"أو التابعين","m":"الذين يتبعون القوم لإرفاقهم إياهم قال قتادة هو الأحمق الذي لا تشتهيه المرأة ولا يغار عليه الرجل وقيل هو الذي لا يكترث بالنساء إما لكبر أو لهرم أو لصغر"},{"t":"الإربة","m":"الحاجة إلى النساء"},{"t":"يظهروا على عورات النساء","m":"أي لم يعرفوها"},{"t":"ولا يضربن بأرجلهن","m":"أي بإحدى الرجلين على الأخرى ليضرب الخلخال الخلخال"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"زينتهن","m":"مواضع زينتهن من الجسد"},{"t":"ما ظهر منها","m":"الوجه و الكفين و القدمين"},{"t":"و ليضربن","m":"و ليلقين و يسدلن"},{"t":"بخمورهن","m":"أغطية رؤوسهن ( المقانع)"},{"t":"على جيوبهن","m":"على مواضعها (صدورهن و ما حواليها)"},{"t":"لبعولتهن","m":"لأزواجهن"},{"t":"نسائهن","m":"المختصّات بهن بالصحبة أو الخدمة"},{"t":"أولي الإربة","m":"أصحاب الحاجة إلى النساء"},{"t":"لم يظهروا","m":"لم يبلغوا حد الشهوة"}]}]},{"ayah":32,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَأَنكِحُوا","m":"زَوِّجُوا."},{"t":"الْأَيَامَى","m":"مَنْ لَا زَوْجَ لَهُ."},{"t":"عِبَادِكُمْ","m":"عَبِيدِكُمْ."},{"t":"وَإِمَائِكُمْ","m":"جَوَارِيكُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْأَيامى","m":"الذين لا أزواج لهم من الرجال والنّساء، واحدهم أيّم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الأيامى","m":"الذين لا أزواج لهم من الرجال والنساء"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"انكحوا الأيامى","m":"من لا زوج لها ، و من لا زوجة له"}]}]},{"ayah":33,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَبْتَغُونَ","m":"يَطْلُبُونَ."},{"t":"الْكِتَابَ","m":"المُكَاتَبَةَ، بِأَنْ يَشْتَرُوا أَنْفُسَهُمْ مِنْ أَسْيَادِهِمْ بِمَالٍ مُقَسَّطٍ يُؤَدُّونَهُ إِلَيْهِمْ."},{"t":"خَيْرًا","m":"رَشَدًا وَقُدْرَةً عَلَى الكَسْبِ."},{"t":"فَتَيَاتِكُمْ","m":"جَوَارِيكُمْ."},{"t":"الْبِغَاءِ","m":"الزِّنَى."},{"t":"تَحَصُّنًا","m":"تَعَفُّفًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَتَياتِكُمْ عَلَى الْبِغاءِ","m":"أي إمائكم على الزنا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وليستعفف","m":"أي ليطلب العفة عن الزنا"},{"t":"الكتاب","m":"المكاتبة"},{"t":"فكاتبوهم","m":"ندب"},{"t":"والخير المال","m":"والخير المال"},{"t":"وآتوهم","m":"خطاب للسادة أمروا أن يطوا مكاتبيهم قال أحمد رحمه الله هو ربع الكتابة وهو واجب وكذلك قال الشافعي وقال ليس بمقدر وقال أبو حنيفة ومالك لا يجب الإيتاء"},{"t":"البغاء","m":"الزنا والتحصن التعفف وإما قال"},{"t":"إن أردن","m":"لأن الإكراه لا يتصور إلا عند إرادة التحصن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يبتغون الكتاب","m":"يطلبون عقد المكاتبة المعروف"},{"t":"فتياتكم","m":"إماءكم"},{"t":"البغاء","m":"الزّنى"},{"t":"تحصّـنا","m":"منوّرهما أو هادي أهلهما أو موجدهما"}]}]},{"ayah":34,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ومثلا من الذين خلوا","m":"شبها من حالهم بحالكم"}]}]},{"ayah":35,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"نُورُ السَّمَوَاتِ وَالْأَرْضِ","m":"أَيْ: هُوَ نُورٌ، وَكِتَابُهُ نُورٌ، وَبِهِ اسْتَنَارَتِ السَّمَوَاتُ وَالأَرْضُ، يُدَبِّرُ الأَمْرَ فِيهِمَا، وَيَهْدِي أَهْلَهُمَا."},{"t":"كَمِشْكَاةٍ","m":"هِيَ: الكُوَّةُ فِي الحَائِطِ غَيْرُ النَّافِذَةِ."},{"t":"دُرِّيٌّ","m":"مُضِيءٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَمِشْكاةٍ","m":"كوّة غير نافذة."},{"t":"مِصْباحٌ","m":"سراج."},{"t":"دُرِّيٌّ","m":"مضيء، منسوب إلى الدّرّ في ضيائه، وإن كان الكوكب أكثر ضوءا من الدّرّ، ولكنه يفضل الكوكب بضيائه كما يفضل البرّ سائر الحبّ. ودُرِّيٌّ  بلا همز بمعنى درّيّ وكسر أوله حملا على وسطه وآخره لأنه يثقل عليهم ضمة بعدها كسرة وياءان، كما قالوا: كرسيّ للكرسيّ، ودرّيء  مهموز «فعّيل» من النّجوم الدّراري التي تدرأ، أي أن تنحطّ وتسير متدافعة، يقال:درأ الكوكب إذا تدافع منقضّا فتضاعف ضوؤه. ويقال: تدارأ الرّجلان، إذا تدافعا.ولا يجوز أن تضمّ الدال وتهمز، لأنه ليس في الكلام فعّيل. ويقال: درّيء «فعليّ» منسوب إلى الدّرّ، ويجوز درّيّ بغير همز يكون مخففا من المهموز."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"نور السماوات","m":"أي هادي أهلها"},{"t":"مثل نوره","m":"أي مثل هداه في قلب المؤمن"},{"t":"والمشكاة الكوة التي لا تنفذ وذ","m":"والمشكاة الكوة التي لا تنفذ وذكر الزجاج لأن النور فيه أشد والدري المشبه بالدر والدري بكسر الدال الجاري وبفتحها الملتمع"},{"t":"يوقد","m":"بالياء مع ضم الدال أراد"},{"t":"من شجرة","m":"أي من زيت شجرة وهي الزيتون"},{"t":"لا شرقية","m":"أي هي في الصحراء لا يوازيها شيء فذلك أجود لزيتها"},{"t":"نور على نور","m":"أي المصباح نور والزجاجة نور"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الله نور السّمـوات","m":"تعفّــفا و تصوّنا عنه"},{"t":"كمشكاة","m":"كنور كوّة غير نافذة"},{"t":"مصباح","m":"سراج ضخم ثاقب"},{"t":"زجاجة","m":"قنديل من الزجاج صاف أزهر"},{"t":"كوكب درّي","m":"مضيء متلألئ صافٍ"}]}]},{"ayah":36,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فِي بُيُوتٍ","m":"هَذَا النُّورُ فِي مَسَاجِدَ."},{"t":"تُرْفَعَ","m":"تُعَظَّمَ بِالتَّعْمِيرِ، وَالتَّطْهِيرِ."},{"t":"بِالْغُدُوِّ وَالْآصَالِ","m":"أَوَّلِ النَّهَارِ، وَآخِرِهِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بيوت","m":"هي المساجد كلّها"},{"t":"أن ترفع","m":"أن تُعظّم و تـُطهّر"},{"t":"بالغدوّ و الآصال","m":"أول النهار و آخره"}]}]},{"ayah":37,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ","m":"أَيْ: بَيْنَ الرَّجَاءِ، وَالخَوْفِ."}]}]},{"ayah":38,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِغَيْرِ حِسَابٍ","m":"بِلَا عَدٍّ، وَيُعْطَى مِنَ الأَجْرِ مَا لَا يَبْلُغُهُ عَمَلُ العَامِلِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بغير حساب","m":"بلا نهاية لما يُعطي ، أو بتوسّع"}]}]},{"ayah":39,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَسَرَابٍ","m":"هُوَ مَا يُشَاهَدُ كَالمَاءِ عَلَى الأَرْضِ المُسْتَوِيَةِ فِي الظَّهِيرَةِ."},{"t":"بِقِيعَةٍ","m":"الأَرْضُ المُنْخَفِضَةُ المُسْتَوِيَةُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"كَسَرابٍ","m":"السّراب: ما رأيته من الشمس كالماء نصف النهار.والآل: ما رأيته في أول النهار وآخره الذي يرفع كلّ شيء."},{"t":"بِقِيعَةٍ","m":"أي في قيعة  . والقيعة والقاع بمعنى، وهو المستويمن الأرض. ويقال: قيعة: جمع قاع  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والسراب ما رأيت من الشمس كالما","m":"والسراب ما رأيت من الشمس كالماء نصف النهار والآل ما تراه أول النهار وآخره والقيعة والقاع واحد"},{"t":"ووجد","m":"أي قدم على الله"},{"t":"فوفاه حسابه","m":"أي جازاه بعمله"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"كسراب","m":"شعاع يُرى ظهرا في البرّ عند اشتداد الحرّ كالماء السارب"},{"t":"بقيعة","m":"في منبسطة من الأرض متـسع"}]}]},{"ayah":40,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لُّجِّيٍّ","m":"عَمِيقٍ."},{"t":"يَغْشَاهُ","m":"يَعْلُوهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لُجِّيٍّ","m":"منسوب إلى اللّجة، وهو معظم البحر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"واللجي العظيم اللجة","m":"واللجي العظيم اللجة"},{"t":"فوقه أي من فوق الموج","m":"فوقه أي من فوق الموج"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بحر لجّي","m":"عميق كثير الماء"},{"t":"يغشاه","m":"يعلوه و يغطّيه"}]}]},{"ayah":41,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"صَافَّاتٍ","m":"بَاسِطَاتٍ أَجْنِحَتَهُنَّ فِي الهَوَاءِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"صافات","m":"أي باسطات أجنحتها في الهواء"},{"t":"والصلاة لبني آدم والتسبيح لغير","m":"والصلاة لبني آدم والتسبيح لغيرهم والمعنى قد علم الله ذلك"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صافات","m":"باسطات أجنحتهن في الهواء"}]}]},{"ayah":43,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُزْجِي","m":"يَسُوقُ."},{"t":"يُؤَلِّفُ","m":"يَجْمَعُ."},{"t":"رُكَامًا","m":"مُتَرَاكِمًا."},{"t":"الْوَدْقَ","m":"المَطَرَ."},{"t":"مِنْ 