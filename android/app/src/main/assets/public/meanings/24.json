":"ما أمر به من التبليغ"},{"t":"ما حُمّلتم","m":"ما أمرتم به من الطاعة و الإنقياد"}]}]},{"ayah":57,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُعْجِزِينَ","m":"فَائِتِينَ مِنَ العَذَابِ بِالهَرَبِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مُعجزين","m":"فائتين من عذابنا بالهرب"}]}]},{"ayah":58,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَمْ يَبْلُغُوا الْحُلُمَ","m":"أَيْ: دُونَ سِنِّ الاِحْتِلَامِ، وَالبُلُوغِ."},{"t":"جُنَاحٌ","m":"حَرَجٌ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ثَلاثُ عَوْراتٍ","m":"أي ثلاثة أوقات من أوقات العورة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الذين ملكت أيمانكم","m":"قال القاضي أبو يعلى الأظهر أن يراد به العبيد الصغار والإماء الصغار لأن العبد البالغ بمنزلة الحر البالغ في تحريم النظر إلى مولاته"},{"t":"منكم","m":"أي من الأحرار"},{"t":"طوافون","m":"أي هم طوافون عليكم"},{"t":"بعضكم على بعض","m":"وهم المماليك"},{"t":"على بعض","m":"وهم الأحرار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"جناح","m":"حرج في الدخول بلا استئذان"}]}]},{"ayah":59,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وإذا بلغ الأطفال منكم","m":"أي من الأحرار"},{"t":"الحلم فليستأذنوا","m":"أي في جميع الأوقات"},{"t":"كما استأذن الذين من قبلهم","m":"يعني الأحرار الكبار الذين أمروا بالاستئذان على كل حال"}]}]},{"ayah":60,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالْقَوَاعِدُ","m":"العَجَائِزُ مِنَ النِّسَاءِ اللَّاتِي قَعَدْنَ عَنِ الحَيْضِ، وَالوَلَدِ، وَالاِسْتِمْتَاعِ؛ لِكِبَرِهِنَّ."},{"t":"مُتَبَرِّجَاتٍ","m":"مُظْهِرَاتٍ لِلزِّينَةِ الخَفِيَّةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالْقَواعِدُ مِنَ النِّساءِ","m":"العجائز اللواتي قعدن عن الأزواج من الكبر. وقيل: قعدن عن الحيض والحبل، واحدتهن