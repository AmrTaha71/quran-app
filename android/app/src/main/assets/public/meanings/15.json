وسمّيت مثاني لأنها تثنّى في كل صلاة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"سبعا من المثاني","m":"يعني الفاتحه سكيت سبعا لعدد اياتها وسميت بالمثاني لانها تثني في كل صلاة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سبعا","m":"سبع آيات و هي الفاتحة"},{"t":"من المثاني","m":"التي تثنّى و تكررّ قراءتها في الصّلاة – و من للبيان"}]}]},{"ayah":88,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا تَمُدَّنَّ عَيْنَيْكَ","m":"لَا تَنْظُرْ بِعَيْنَيْكَ، وَلَا تَتَمَنَّ."},{"t":"أَزْوَاجًا","m":"أَصْنَافًا."},{"t":"وَاخْفِضْ جَنَاحَكَ","m":"تَوَاضَعْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أزواجا منهم","m":"أي اصنافا من المشركين واليهود والمعنى لا ترغب في الدنيا"},{"t":"ولا تحزن عليهم","m":"ام لم يؤمنوا"},{"t":"واخفض جناحك","m":"أي الن جانبك"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أزواجا منهم","m":"أصناف من الكفّار"},{"t":"اخفض جناحك","m":"تواضع و ألن جانبك"}]}]},{"ayah":90,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"المُقْتَسِمِينَ","m":"الَّذِي قَسَّمُوا القُرْآنَ فَآمَنُوا بِبَعْضٍ، وَكَفَرُوا بِبَعْضٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْمُقْتَسِمِينَ","m":"المتحالفين على عضه  رسول الله- صلّى الله عليه وسلّم- وقيل هم قوم من أهل الشّرك، قالوا: تفرّقوا [على]  عقاب مكة حيث تمرّ بهم أهل الموسم فإذا سألوهم عن محمد قال بعضهم: هو كاهن، وبعضهم: هو ساحر، وبعضهم: هو شاعر، وبعضهم: هو مجنون، فمضوا فأهلكهم الله- عز وجل- وسمّوا المقتسمين لأنهم اقتسموا طرق  مكّة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كما أنزلنا","m":"المعنى أنا النذير مثل الذي انزل"},{"t":"على المقتسمين","m":"من العذاب أوهم مشركوا العرب قريش تقسمت أقوالهم في القران فقال بعضهم سحر وقال بعضهم كهانه وقال بعضهم أساطير الاولين فعضوا فيه هذا القول أي فرقوه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"المقتسمين","m":"أهل الكتاب"}]}]},{"ayah":91,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"عِضِينَ","m":"أَجْزَاءَ، فَقَالَ بَعْضُهُمْ: سِحْرٌ، وَقَالَ بَعْضُهُمْ: كِهَانَةٌ، وَغَيْرَ ذَلِكَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"جَعَلُوا الْقُرْآنَ عِضِينَ","m":"عضّوه أعضاء، أي فرّقوه فرقا. يقال:عضّيت الشاة والجزور إذا جعلتهما أعضاء. ويقال: فرّقوا القول فيه، فقالوا: شعر، وقالوا: سحر، وقالوا: كهانة، وقالوا: أساطير الأوّلين. وقال عكرمة  : العضة:السّحر بلغة قريش  . ويقولون للسّاحرة عاضهة. ويقال: عضّوه: آمنوا بما أحبّوا منه وكفروا بالباقي فأحبط كفرهم إيمانهم  ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عظين","m":"أعضاءً و أجزاءً ، فآمنوا ببعض و كفروا ببعض"}]}]},{"ayah":94,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَاصْدَعْ","m":"فَاجْهَرْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَاصْدَعْ بِما تُؤْمَرُ","m":"أفرق وأمضه. ولم يقل: تؤمر به لأنه ذهب بها إلى المصدر، أراد فاصدع بالأمر  ومن جعل «ما» اسما موصولا اعتذر عن حذف «به» بأن باب «أمر» يجوز فيه حذف الجار ونصب المفعول الثاني بنفس الفعل، فلما أجري هذا المجرى صار التقدير: بالذي تؤمره، فساغ الحذف. وبالله التّوفيق."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وأعرض","m":"منسوخ باية السيف"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فاصدع بما تؤمر","m":"فاجهر به أو فامضه و نفّذه"}]}]},{"ayah":95,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إنا كفيناك المستهزئين","m":"قوم من كفار مكة أهلكهم الله فكفاه امرهم"}]}]},{"ayah":98,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"السَّاجِدِينَ","m":"العَابِدِينَ، المُصَلِّينَ."}]}]},{"ayah":99,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْيَقِينُ","m":"المَوْتُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"اليقين","m":"الموت"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"اليقين","m":"الموت المُتيقّن وقوعه"}]}]}]