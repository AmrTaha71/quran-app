[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ","m":"مُسْتَقْبِلَاتٍ لِعِدَّتِهِنَّ، أَيْ: فِي طُهْرٍ لَمْ يَقَعْ فِيهِ جِمَاعٌ."},{"t":"وَأَحْصُوا الْعِدَّةَ","m":"احْفَظُوهَا؛ لِتَعْلَمُوا وَقْتَ الرَّجْعَةِ إِنْ أَرَدْتُّمُ المُرَاجَعَةَ."},{"t":"بِفَاحِشَةٍ مُّبَيِّنَةٍ","m":"بِمَعْصِيَةٍ ظَاهِرَةٍ؛ كَالزِّنَى، وَالتَّطَاوُلِ عَلَى الزَّوْجِ بِاللِّسَانِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لعدتهن","m":"أي لزمان عدتهن وهو الطهر الذي لم يصبها فيه وهذا للمدخول بها لا غير لأن غير المدخول بها لا عدة عليها"},{"t":"الفاحشة","m":"خروجهن قبل انقضاء العدة"},{"t":"يحدث بعد ذلك أمرا","m":"وهو أن يوقع في قلب الرجل محبة المراجعة لزوجته"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فطلّـقوهن لعدتهنّ","m":"مُستقـبلاتٍ لعدتهنّ (الــّطهْر)"},{"t":"أحصوا العدّة","m":"اضبطوها و أكمِلوها ثلاثة قروء"},{"t":"بفاحشة مبَيّـنة","m":"بمعصيةٍ كبيرةٍ ظاهرة"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بَلَغْنَ أَجَلَهُنَّ","m":"قَارَبْنَ أَنْ يَنْتَهِينَ مِنْ عِدَّتِهِنَّ."},{"t":"ذَوَيْ عَدْلٍ","m":"صَاحِبَيْ عَدَالَةِ."},{"t":"وَأَقِيمُوا","m":"أَدُّوا."},{"t":"مَخْرَجًا","m":"فَرَجًا مِنْ كُلِّ ضِيقٍ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بلغن أجلهن","m":"قاربن انقضاء العدة"},{"t":"وأشهدوا","m":"على الطلاق والرجعة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بَلَغْنَ أجلهنّ","m":"قاربْن انقضاء عدتهنّ"},{"t":"مخرجا","m":"من كلّ شدة و ضيق و بلاء"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا يَحْتَسِبُ","m":"لَا يَخْطُرُ بِبَالِهِ، وَلَا يَتَوَقَّعُ."},{"t":"حَسْبُهُ","m":"كَافِيهِ."},{"t":"بَالِغُ أَمْرِهِ","m":"مُنَفِّذٌ حُكْمَهُ؛ لَا يَفُوتُهُ شَيْءٌ، وَلَا يُعْجِزُهُ مَطْلُوبٌ."},{"t":"قَدْرًا","m":"أَجَلًا يَنْتَهِي إِلَيْهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"قدرا","m":"أي أجلا ومنتهى"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا يحتسب","m":"لا يَخطر بباله و لا يكون في حسابه"},{"t":"فهو حسبه","m":"كافيه ما أهمّه في جميع أموره"},{"t":"قـَـدْرًا","m":"أجَلاً ينتهي إليه أو تقديرا أزَلاً"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَئِسْنَ","m":"انْقَطَعَ رَجَاؤُهُنَّ؛ لِكِبَرِهِنَّ."},{"t":"ارْتَبْتُمْ","m":"شَكَكْتُمْ؛ فَلَمْ تَدْرُوا مَا الحُكْمُ فِيهِنَّ."},{"t":"وَأُوْلَاتُ الْأَحْمَالِ","m":"صَاحِبَاتُ الحَمْلِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"اللَّائِي","m":"واحدها التي والذي جميعا، واللاتي: جمع التي لا غير"},{"t":"أُولاتُ","m":"واحدها ذات."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يَـئِـسْنَ","m":"انقـطع رَجاؤهنّ لِكِبَرهنّ"},{"t":"يُسْرا","m":"تيْسيرا و فَـرَجًا"}]}]},{"ayah":5,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"و اللائي لم يَحِضن","m":"لِصِغرهنّ عدتهن ثلاثة أشهر"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مِنْ حَيْثُ سَكَنتُم","m":"قِبَلَ سُكْنَاكُمْ."},{"t":"مِّن وُجْدِكُمْ","m":"عَلَى قَدْرِ وُسْعِكُمْ، وَطَاقَتِكُمْ."},{"t":"أُولَاتِ","m":"ذَوَاتِ."},{"t":"وَاتَمِرُوا","m":"وَلْيَامُرْ بَعْضُكُمْ بَعْضًا."},{"t":"بِمَعْرُوفٍ","m":"بِمَا عُرِفَ مِنْ سَمَاحَةٍ، وَطِيبِ نَفْسٍ."},{"t":"تَعَاسَرْتُمْ","m":"تَشَاحَحْتُمْ فِي الإِرْضَاعِ فَامْتَنَعَ الأَبُ مِنَ الأُجْرَةِ، وَالأُمُّ مِنَ الرَّضَاعِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مِنْ وُجْدِكُمْ","m":"سعتكم ومقدرتكم، من الجدّة."},{"t":"وَأْتَمِرُوا بَيْنَكُمْ بِمَعْرُوفٍ","m":"أي ليأمر بعضكم بعضا به."},{"t":"وَإِنْ تَعاسَرْتُمْ","m":"تضايقتم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من وجدكم","m":"أي بقدر سعتكم"},{"t":"ولا تضاروهن","m":"بالتضييق عليهن في المسكن والنفقة"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"قُدِرَ","m":"ضُيِّقَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ما آتاها","m":"أي أعطاها من المال"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَكَأَيِّن","m":"كَثِيرٌ."},{"t":"عَتَتْ","m":"عَصَتْ، وَتَجَبَّرَتْ."},{"t":"نُّكْرًا","m":"مُنْكَرًا عَظِيمًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"عَتَتْ عَنْ أَمْرِ رَبِّها","m":"يعني عتا أهلها عن أمر ربّهم، أي تكبّروا وتجبّروا، يقال لكل جبّار: عات."}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَبَالَ أَمْرِهَا","m":"سُوءَ عَاقِبَةِ عُتُوِّهِمْ، وَكُفْرِهِمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وبال أمرها","m":"أي جزاء ذنبها"}]}]},{"ayah":10,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ذكرا","m":"قرآنا"}]}]},{"ayah":11,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"رسولا","m":"أي وبعث رسولا"}]}]},{"ayah":12,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"مثلهن","m":"أي بعددهن"},{"t":"الأمر","m":"الوحي"}]}]}]