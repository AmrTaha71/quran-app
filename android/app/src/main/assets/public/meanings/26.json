":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْأَعْجَمِينَ","m":"جمع أعجم، وأعجميّ أيضا، إذا كان في لسانه عجمة وإن لم يكن من العجم، ورجل عجميّ: منسوب إلى العجم، ورجل أعرابيّ:إذا كان بدويّا وإن لم يكن من العرب. ورجل عربيّ: منسوب إلى العرب وإن لم يكن بدويّا، قال الفرّاء: الأعجميّ منسوب [إلى]  نفسه، من العجمة، كما قالوا للأحمر أحمريّ، وكقوله:والدّهر بالإنسان دوّاريّ إنما هو دوّار."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الأعجمين","m":"جمع أعجم وهو الذي لا يفصح والمعنى لو قرأه عليهم الأعجمون لقالوا لا نفقه هذا"}]}]},{"ayah":200,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَلَكْنَاهُ","m":"أَدْخَلْنَا التَّكْذِيبَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كذلك سلكناه","m":"مذكور في الحجر"}]}]},{"ayah":202,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بَغْتَةً","m":"فَجْأَةً."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بغتة","m":"فجأة"}]}]},{"ayah":203,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُنظَرُونَ","m":"مُمْهَلُونَ مُؤَخَّرُونَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"هل نحن منظرون","m":"ممهلون لِنؤمن ؟ كلاّ"}]}]},{"ayah":205,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَفَرَأَيْتَ","m":"أَفَعَلِمْتَ؟"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أفرأيت","m":"أخبرني"}]}]},{"ayah":207,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ما أغنى عنهم","m":"أي شيء أغنى عنهم – لم يُغنِ"}]}]},{"ayah":212,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"السَّمْعِ","m":"اسْتِمَاعِ القُرْآنِ مِنَ السَّمَاءِ."},{"t":"لَمَعْزُولُونَ","m":"لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ."}]}]},{"ayah":215,"books":[{