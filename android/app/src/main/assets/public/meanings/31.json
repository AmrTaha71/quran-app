[{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَهْوَ الْحَدِيثِ","m":"مَا يُلْهِي عَنْ طَاعَةِ اللهِ؛ كَالغِنَاءِ."},{"t":"هُزُوًا","m":"سُخْرِيَةً."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لَهْوَ الْحَدِيثِ","m":"باطله، وما يشغل عن الخير. وقيل: هو الغناء"}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لهو الحديث","m":"الغناء"},{"t":"ليضل","m":"أي ليصير أمره إلى الضلال"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لَهْو الحديث","m":"الباطل المُلهي عن الخير و العبادة"},{"t":"هُـزوا","m":"سُخريةً – مهزوءًا بها"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَقْرًا","m":"صَمَمًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَقْراً","m":"صمما."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ولّى مُستكبرا","m":"أعرضَ مُتكبّرا عن تدبّرها"},{"t":"وقْرا","m":"صممًا مانعًا من السّماع"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"رَوَاسِيَ","m":"جِبَالًا ثَابِتَةً."},{"t":"أَن تَمِيدَ","m":"لِئَلَّا تَضْطَرِبَ وَتَتَحَرَّكَ."},{"t":"وَبَثَّ","m":"نَشَرَ."},{"t":"زَوْجٍ كَرِيمٍ","m":"صِنْفٍ بَهِيجٍ نَافِعٍ حَسَنَ المَنْظَرِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بغير عَمَد","m":"بغير دعائم و أساطينَ تُقيمُها"},{"t":"رواسي","m":"جبالا ثوابت"},{"t":"أن تميد بكم","m":"لِئلاّ تضطرب بكم"},{"t":"بثّ فيها","m":"نَشَرو فرَّق و أظهَرَ فيها"},{"t":"زوج كريم","m":"صِـنـْــفٍ حسنٍ كثير المنفعة"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْحِكْمَةَ","m":"الفِقْهَ فيِ الدِّينِ، وَالإِصَابَةَ فيِ القَوْلِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الحكمة","m":"الفهم والعقل"},{"t":"أن أشكر","m":"أي وقلنا له أن الشكر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لُقمان","m":"كان صالحا حكيما و ليس نبيّا"},{"t":"الحكمة","m":"العقل و الفهم و الفطنة و إصابة القول"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَهْنًا","m":"ضَعْفًا."},{"t":"وَفِصَالُهُ","m":"فِطَامُهُ عَنِ الرَّضَاعَةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَهْناً عَلى وَهْنٍ","m":"ضعفا على ضعف، أي كلما عظم خلقه في بطنها زادها ضعفا  . وفي الوهن ثلاث لغات: وهن يهن مثل وعد يعد، ووهن يوهن مثل وجل يوجل، ووهن يهن مثل ورث يرث."},{"t":"وَفِصالُهُ","m":"أي فطامه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وهنا","m":"أي ضعفا والمعنى لزمها بحمله أن يضعف مرة بعد مرة"},{"t":"وفصاله","m":"فطامه والمعنى أنه يقع فطامه"},{"t":"في عامين","m":"وهذا تنبيه على مشقة الوالدة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"وصّينا الإنسان","m":"أمرناه و ألزمناه"},{"t":"وهْنا","m":"ضعفا"},{"t":"فصاله","m":"فِطامُـه عن الرّضاع"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَبِيلَ","m":"طَرِيقَ."},{"t":"أَنَابَ","m":"رَجَعَ، وَتَابَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أناب إليّ","m":"رَجَع إليّ بالإخلاص و الطّاعة"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مِثْقَالَ","m":"وَزْنَ، وَمِقْدَارَ."},{"t":"حَبَّةٍ مِّنْ خَرْدَلٍ","m":"حَبَّةٍ صَغِيرَةٍ مُتَنَاهِيَةٍ فيِ الصِّغَرِ."},{"t":"يَاتِ بِهَا اللَّهُ","m":"يَاتِ بِهَا يَوْمَ القِيَامَةِ، وَيُحَاسِبْ عَلَيْهَا."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مثقال حبّة","m":"وزنَ أصغر شيء. ."}]}]},{"ayah":17,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مِنْ عَزْمِ الْأُمُورِ","m":"مِنَ الأُمُورِ الَّتِي يَنْبَغِي الحِرْصُ عَلَيْهَا."}]}]},{"ayah":18,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَلَا تُصَعِّرْ خَدَّكَ","m":"لَا تُمِلْ وَجْهَكَ كِبْرًا وَتَعَاظُمًا."},{"t":"مَرَحًا","m":"مُخْتَالًا مُتَبَخْتِرًا."},{"t":"مُخْتَالٍ","m":"مُتَكَبِّرٍ بِفِعْلِهِ."},{"t":"فَخُورٍ","m":"مُتَكَبِّرٍ بِقَوْلِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"ولا تصاعر خدّك للنّاس","m":"لا تعرض بوجهك عنهم في ناحية من الكبر. والصّعر: ميل في العنق. والصّعر: داء يأخذ البعير في رأسه فيقلب رأسه في جانب، فشبّه الذي يتكبّر على الناس به  وصعّر وصاعر لغتان كضعّف وضاعف  ."},{"t":"مَرَحاً","m":"خيلاء وكبرياء."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ولا تصعر","m":"قال الفراء تصعر وتصاعر لغتان معناهما الإعراض من الكبر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تُصعّر خدّك للنّاس","m":"لا تُمِلْ وجهَك عنهم كِبْرا و تعاظُما"},{"t":"مرَحا","m":"فَرَحا و بَطَرًا و خُيلاء"},{"t":"مُختال فخور","m":"مُتكبّرٍ، مُباهٍ متطاول بمناقبه"}]}]},{"ayah":19,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَاقْصِدْ","m":"تَوَاضَعْ، وَكُنْ بَيْنَ المُسْرِعِ، وَالمُبْطِئِ."},{"t":"وَاغْضُضْ","m":"اخْفِضْ."},{"t":"أَنكَرَ","m":"أَقْبَحَ، وَأَبْغَضَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَاقْصِدْ فِي مَشْيِكَ","m":"أي اعدل فيه فلا تتكبر فيه، ولا تدب دبيبا.والقصد: ما بين الإسراف والتّقصير  وهذا معنى قول بعضهم: «التّوسّط بينالغلوّ والتّقصير» و «كلا طرفي قصد الأمور ذميم» وقيل معنى اقصد: أسرع، بلغة هذيل  ."},{"t":"وَاغْضُضْ مِنْ صَوْتِكَ","m":"انقص منه [زه] يقال: غضّ منه، إذا نقص منه."},{"t":"إِنَّ أَنْكَرَ الْأَصْواتِ","m":"أي أقبحها، وإنما يكره رفع الصوت في الخصومة والباطل. ورفع الصوت محمود في مواطن منها الأذان والتّلبية."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"اقصِدْ في مَشيك","m":"توسّط فيه بين الإسراع و الإبطاء"},{"t":"اغضض","m":"اخفضْ و انقصْ"}]}]},{"ayah":20,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"سَخَّرَ لَكُم","m":"ذَلَّلَ لَكُمْ."},{"t":"وَأَسْبَغَ","m":"عَمَّكُمْ بِنِعَمِهِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"سخّر لكم","m":"لِمنافعكم و مصالحكم"},{"t":"أسْـبَغ","m":"أتمّ و أوسع و أكمل"}]}]},{"ayah":22,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُسْلِمْ وَجْهَهُ","m":"يُخْلِصْ عِبَادَتَهُ وَقَصْدَهُ إِلَى اللهِ."},{"t":"اسْتَمْسَكَ","m":"تَعَلَّقَ، وَاعْتَصَمَ."},{"t":"بِالْعُرْوَةِ الْوُثْقَى","m":"أَوْثَقِ سَبَبٍ مُوصِلٍ إِلَى رِضْوَانِ اللهِ."},{"t":"عَاقِبَةُ","m":"مَآلُ، وَمَرْجِعُ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يُسْلِم وجهه","m":"يُفوّض أمره كلّه . ."},{"t":"استمسك","m":"تمسّك و تعلـّـقَ و اعتصمَ"},{"t":"بالعروة الوُثقى","m":"بالعهد الأوثق الذي لا نقْضَ له"}]}]},{"ayah":24,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"غَلِيظٍ","m":"فَظِيعٍ ثَقِيلٍ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عذاب غليظ","m":"شديد ثقيل (عذاب النّار)"}]}]},{"ayah":27,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يمدّه","m":"يَزيده و يَنْصَبُّ إليه"},{"t":"سبعة أبحُر","m":"مملوءةٍ ماءً"},{"t":"ما نفدت","m":"ما فرغَتْ و ما فَنِيتْ"},{"t":"كلمات الله","m":"مقدوراته و عجائبه أو معلوماته"}]}]},{"ayah":29,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَيُولِجُ","m":"يُدْخِلُ؛ بِأَنْ يَاخُذَ مِنْ سَاعَاتِ اللَّيْلِ فَيطُولُ النَّهَارُ، وَالعَكْسِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يولج","m":"يُدْخِل"}]}]},{"ayah":31,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْفُلْكَ","m":"السُّفُنَ."},{"t":"بِنِعْمَتِ اللَّهِ","m":"بِأَمْرِ اللهِ وَرَحْمَتِهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لكل صبار","m":"أي صبور على أمر الله"}]}]},{"ayah":32,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"غَشِيَهُم","m":"عَلَاهُمْ."},{"t":"كَالظُّلَلِ","m":"كَالسَّحَابِ، أَوِ الجِبَالِ المُظِلَّةِ."},{"t":"مُّقْتَصِدٌ","m":"مُتَوَسِّطٌ لَمْ يَقُمْ بِشُكْرِ اللهِ عَلَى وَجْهِ الكَمَالِ."},{"t":"خَتَّارٍ","m":"غَدَّارٍ تَاقِضٍ لِلْعَهْدِ."},{"t":"كَفُورٍ","m":"جَحُودٍ لِنِعَمِ اللهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"خَتَّارٍ","m":"أي غدّار. والختر: أقبح الغدر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"غشيهم","m":"يعني الكفار"},{"t":"مقتصد","m":"أي مؤمن"},{"t":"والختار الغدار","m":"والختار الغدار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"غَشِيهم موْجٌ","m":"علاهم و غطّاهم"},{"t":"كالظـّــلل","m":"كالسّحاب . أو الجبال المظلـّـة"},{"t":"فمِنهم مُقتصد","m":"موفٍ بعهده . شاكر لله"},{"t":"ختـّار كفور","m":"غدّارٍ جَحود للنّعم"}]}]},{"ayah":33,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَّا يَجْزِي وَالِدٌ","m":"لَا يُغْنِي فِيهِ وَالِدٌ."},{"t":"فَلَا تَغُرَّنَّكُمُ","m":"فَلَا تَخْدَعَنَّكُمْ، وَتُلْهِيَنَّكُمْ."},{"t":"الْغَرُورُ","m":"مَا يَغُرُّ وَيَخْدَعُ مِنْ شَيْطَانٍ وَغَيْرِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لا يَجْزِي والِدٌ عَنْ وَلَدِهِ","m":"لا يغني عنه. ويجزي  عنه بضم الياء يعني يكفي عنه."},{"t":"الْغَرُورُ","m":"الشّيطان، وكل من غرّ فهو غرور. والغرور، بضم الغين: الباطل، مصدر غررت."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا يجزي","m":"يعني يقضي عنه شيئا من جناياته"},{"t":"الغرور","m":"الشيطان"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يوما لا يجزي","m":"لا يقضي فيه شيئا . ."},{"t":"فلا تغرنّـكم","m":"فلا تخدعنّكم و تُلهينّكم بلذاتها"},{"t":"الغَرور ْ","m":"ما يغرّ و يخدع من شيطان و غيره"}]}]}]