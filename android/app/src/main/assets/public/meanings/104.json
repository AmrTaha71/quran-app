[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَيْلٌ","m":"شَرٌّ، وَهَلَاكٌ."},{"t":"هُمَزَةٍ","m":"مُغْتَابٍ لِلنَّاسِ."},{"t":"لُّمَزَةٍ","m":"طَعَّانٍ فيِ النَّاسِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"هُمَزَةٍ لُمَزَةٍ","m":"معناهما واحد، أي عياب. ويقال: اللّمز في الوجه بكلام خفيّ. والهمز في القفا  وهذا محكي عن الخليل  . وعن ابن عباس: هو المشّاء بالنّميمة المفرّق بين الأحبّة الباغي للبريء العيب  . وعن الحسن: الهمزة الذي يهمز جليسه بعينه، أي يكسرها ويومئ إليه. واللّمزة: الذي يستقبل أخاه بوجه ويعيب له بآخر."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"وَيْل","m":"عذاب أو هَلاك أوْ وَادٍ في جَهنّم"},{"t":"هُمَزةٍ لُـمَزةٍ","m":"طَعّـان غَـيّـاب عَـيّـاب للناس"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَعَدَّدَهُ","m":"أَحْصَاهُ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وعدده","m":"أحصى عدده"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"عَدّده","m":"أحصاه . أو أعدّه للنّوائب"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَحْسَبُ","m":"يَظُنُّ."},{"t":"أَخْلَدَهُ","m":"أَبْقَاهُ خَالِدًا فِي الدُّنْيَا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أخلده","m":"بمعنى خلده"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أخلده","m":"يُخـلـّـدُهُ في الدنيا"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَلَّا","m":"لَيْسَ الأَمْرُ كَمَا يَظُنُّ."},{"t":"لَيُنبَذَنَّ","m":"لَيُطْرَحَنَّ."},{"t":"الْحُطَمَةِ","m":"النَّارِ الَّتِي تَهْشِمُ كُلَّ مَا يُلْقَى فِيهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْحُطَمَةِ","m":"النار، سمّيت بذلك لأنها تحطم كلّ شيء تكسره وتأتي عليه. ويقال للرّجل الأكول: إنه الحطمة. والحطمة السّنة الشّديدة أيضا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لينبذن","m":"ليطرحن و"},{"t":"الحطمة","m":"اسم من اسماء جهنم تأكل اللحم والجلد حتى تطلع على الفؤاد فتحرقه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لـَـيُنـْـبَذنّ","m":"لـَـيُطرَحَنّ"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَطَّلِعُ عَلَى الْأَفْئِدَةِ","m":"تَنْفُذُ لِشِدَّتِهَا مِنْ أَجْسَامِهِمْ إِلَى قُلُوبِهِمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تطّـلع على الأفـئدة","m":"تـَـغْشـَى حَرَارتها أوْساط القلوب"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُّؤْصَدَةٌ","m":"مُطْبَقَةٌ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والمؤصدة في سورة البلد","m":"والمؤصدة في سورة البلد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مؤْصَدَة","m":"مُـطبَـقـَـة مُـغْـلـقـَة ٌ أبْوابها"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فِي عَمَدٍ مُّمَدَّدَةٍ","m":"يُعَذَّبُونَ فِي أَعْمِدَةٍ طَوِيلَةٍ مِنَ النَّارِ، أَوْ أَنَّ أَبْوَابَهَا مُغْلَقَةٌ بِأَعْمِدَةٍ مُمَدَّدَةٍ؛ لِئَلَّا يَخْرُجُوا مِنْهَا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"في عمد","m":"وهي أوتاد الأطباق التي تطيق على أهل النار وفي بمعنى الباء والمعنى مطبقة بعمد"},{"t":"ممددة","m":"صفة للعمد أي أنها ممدودة مطولة وهي أرسخ من القصيرة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"في عَمَدٍ مُمَدّدة","m":"بأعمِدةٍ ممدودةٍ على أبْوابها"}]}]}]