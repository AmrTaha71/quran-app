يِ الأَجِنَّةِ، وَمَرَّةً حِينَ انْقَضَى أَجَلُنَا."},{"t":"وَأَحْيَيْتَنَا اثْنَتَيْنِ","m":"مَرَّةً فيِ الدُّنْيَا، وَمَرَّةً فيِ الآخِرَةِ."},{"t":"سَبِيلٍ","m":"طَرِيقٍ نَخْرُجُ بِهِ مِنَ النَّارِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَمَتَّنَا اثْنَتَيْنِ وَأَحْيَيْتَنَا اثْنَتَيْنِ","m":"مثل قوله: وَكُنْتُمْ أَمْواتاً فَأَحْياكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ  فالموتة الأولى: كونهم نطفا في أصلاب آبائهم لأن النّطفة ميّتة. والحياة الأولى: إحياء الله إيّاهم من النّطفة. والموتة الثانية: إماتة الله إياهم بعد الحياة. والحياة الثانية: إحياء الله إياهم للبعث، فهاتان موتتان وحياتان.ويقال: الموتة الأولى التي تقع بهم في الدّنيا بعد الحياة، والحياة الأولى:إحياء الله- جلّت قدرته- إيّاهم في القبر لمساءلة منكر ونكير، والموتة الثانية: إماتةالله إياهم بعد المساءلة، والحياة الثانية: إحياء الله إيّاهم للبعث."}]}]},{"ayah":12,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ذلكم","m":"يعني العذاب الذي نزل بهم"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تؤمنوا","m":"تذعـنوا و تقِرّوا بالشرك"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"رِزْقًا","m":"مَطَرًا تُرْزَقُونَ بِهِ."},{"t":"يُنِيبُ","m":"يَرْجِعُ إِلَى طَاعَةِ اللهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والرزق المطر","m":"والرزق المطر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ينيب","m":"يَرْجع إلى التـّـفكّر في الآيات"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"رَفِيعُ الدَّرَجَاتِ","m":"ارْتَفَعَتْ دَرَجَاتُهُ ارْتِفَاعًا بَايَنَ بِهِ مَخْلُوقَاتِهِ، وَارْتَفَعَ بِهِ قَدْرُهُ."},{"t":"يُلْقِي الرُّوحَ","m":"يُنْزِلُ الوَحْيَ."},{"t":"يَوْمَ التَّلَاقِ","m":"اليَوْمَ الَّذِي يَلْتَقِي فِيهِ الأَوَّلُونَ وَالآخِرُونَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَوْمَ