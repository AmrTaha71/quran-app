[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا تُقَدِّمُوا","m":"لَا تَتَقَدَّمُوا بِقَوْلٍ أَوْ فِعْلٍ، وَلَا تَقْضُوا أَمْرًا دُونَ أَمْرِ اللهِ وَرَسُولِهِ؛ فَتَبْتَدِعُوا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا تقدموا","m":"لا تعجلوا بقول أو فعل قبل أن يقول رسول الله صلى الله عليه وسلم أو يفعل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تقدّموا","m":"لا تقطعوا أمرا و تجزموا به"}]}]},{"ayah":2,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَن تَحْبَطَ","m":"كَرَاهَةَ أَنْ تَبْطُلَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أن تحبط أعمالكم","m":"كراهة أن تبطل أعمالكم"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَغُضُّونَ","m":"يَخْفِضُونَ."},{"t":"امْتَحَنَ اللَّهُ قُلُوبَهُمْ","m":"اخْتَبَرَهَا، وَصَفَّاهَا، وَأَخْلَصَهَا لِتَقْوَاهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"امْتَحَنَ اللَّهُ قُلُوبَهُمْ لِلتَّقْوى","m":"أخلصها."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"امتحن الله قلوبهم","m":"أي اختبر قلوبهم فوجدهم مخلصين"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يغضون أصواتهمْ","m":"يَخفضونها و يُخافتون بها"},{"t":"امتحن الله قلوبَهم","m":"أخلصها و صفّـاها"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُنَادُونَكَ","m":"يُنَادِيكَ الأَعْرَابُ بِصَوْتٍ مُرْتَفِعٍ، غَلِيظٍ، جَافٍ."},{"t":"الْحُجُرَاتِ","m":"حُجُرَاتِ زَوْجَاتِهِ - صلى الله عليه وسلم -."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"ينادونك من وراء الحجرات","m":"وهم بنو تميم جاءوا فنادوا يا محمد أخرج إلينا فإن مدحنا ين وإن ذمنا شين فخرج وهو يقول ذلكم الله قالوا جئنا بخطيبنا وشاعرنا نفاخرك بخطيبك وبشاعرك فقال ما بالشعر بعثت ولا بالفخار أمرت فتكلم خطيبهم فأجابه ثابت"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الحجرات","m":"حجرات زوجاته صلى الله عليه و سلم"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِنَبَأٍ","m":"بِخَبَرٍ."},{"t":"فَتَبَيَّنُوا","m":"فَتَثَبَّتُوا مِنْ خَبَرِهِ."},{"t":"أَن تُصِيبُوا","m":"خَشْيَةَ أَنْ تُصِيبُوا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إن جاءكم فاسق","m":"نزلت في الوليد بن عقبة بعثه النبي صلى الله عليه وسلم إلى بني المصطلق ليقبض صدقاتهم فسار بعض الطريق ثم خاف عداوة كانت بينه وبينهم في الجاهلية فرجع فقال قد منعوا الصدقة فضرب رسول الله صلى الله عليه وسلم البعث إليهم فنزلت الآية"},{"t":"أن تصيبوا","m":"أي لئلا"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَعَنِتُّمْ","m":"لَأَدَّى إِلَى مَشَقَّتِكُمْ، وَعَنَتِكُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أن فيكم رسول الله","m":"أي إن كذبتم أخبره الله فتفتضحوا"},{"t":"لو يطيعكم في كثير من الأمر","m":"أي مما تخبرونه فيه بالباطل"},{"t":"لعنتم","m":"أي لوقعتم في ضرر وفساد"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لعَنتـّـمْ","m":"لأثمْتم و هَلـَـكتمْ"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بَغَتْ","m":"اعْتَدَتْ."},{"t":"تَفِيءَ","m":"تَرْجِعَ إِلَى حُكْمِ اللهِ وَرَسُولِهِ."},{"t":"وَأَقْسِطُوا","m":"اعْدِلُوا."},{"t":"الْمُقْسِطِينَ","m":"العَادِلِينَ فِي أَحْكَامِهِمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَفِيءَ إِلى أَمْرِ اللَّهِ","m":"ترجع  ."},{"t":"الْمُقْسِطِينَ","m":"العادلين في القول والفعل. والإقساط: العدل، كالقسط، بالكسر، بخلاف القاسطين، والقسط، بالفتح، فإنه ضدّ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بَغَتْ","m":"اعتدت و اسْتطالت و أبَتِ الصلح"},{"t":"تفيء","m":"تَرْجع"},{"t":"أقسطوا","m":"اعدلوا في كل أموركم"},{"t":"المقسطين","m":"العادلين فيُـحْسِنُ جزاءَهمْ"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَا يَسْخَرْ","m":"لَا يَهْزَا، وَيَنْتَقِصْ."},{"t":"قَومٌ","m":"رِجَالٌ."},{"t":"وَلَا تَلْمِزُوا","m":"لَا يَعِبْ، وَلَا يَطْعَنْ بَعْضُكُمْ بَعْضًا."},{"t":"وَلَا تَنَابَزُوا بِالْأَلْقَابِ","m":"لَا يَدْعُ بَعْضُكُمْ بَعْضًا بِمَا يَكْرَهُ مِنَ الأَلْقَابِ."},{"t":"بِئْسَ الاِسْمُ الْفُسُوقُ","m":"قَبُحَ الاِسْمُ وَالصِّفَةُ الفُسُوقُ؛ وَهُوَ: السُّخْرِيَةُ، وَاللَّمْزُ، وَالتَّنَابُزُ."},{"t":"بَعْدَ الْإِيمَانِ","m":"بَعْدَمَا دَخَلْتُمْ فِي الإِسْلَامِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لا تَلْمِزُوا أَنْفُسَكُمْ","m":"أي لا تعيبوا إخوانكم من المسلمين [زه] واللّمز: العيب."},{"t":"وَلا تَنابَزُوا بِالْأَلْقابِ","m":"أي لا تداعوا بها أحدا ولا يدعوكم، أي  لا تداعوا بها أحدا. والأنباز: الألقاب، واحدها نبز."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لا يسخر قوم","m":"أي لا يستهزىء غني بفقير ولا مستور الذنب بمن لم يستر"},{"t":"ولا تلمزوا","m":"أي تعيبوا"},{"t":"أنفسكم","m":"أي إخوانكم من المسلمين"},{"t":"ولا تنابزوا","m":"أي تداعوا"},{"t":"بالألقاب","m":"وهي التي يكرهها المنادى بها أو تفيد ذما له فأما إذا كانت صدقا وأفادت حمدا فلا تكره كما قيل للصديق عتيق ولعمر الفاروق"},{"t":"بئس الاسم الفسوق","m":"أي أن تسمي أخاك فاسقا أو كافرا وقد آمن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا يسْخرْ","m":"لا يهْـزأ و لا ينتقصْ"},{"t":"لا تلمزوا أنفسكم","m":"لا يَعِبْ و لا يَطعَن بعضكم بعضا"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"كَثِيرًا مِّنَ الظَّنِّ","m":"هُوَ ظَنُّ السُّوءِ بِالمُؤْمِنِينَ."},{"t":"وَلَا تَجَسَّسُوا","m":"لَا تُفَتِّشُوا عَنْ عَوْرَاتِ المُسْلِمِينَ."},{"t":"وَلَا يَغْتَبْ","m":"لَا يَقُلْ أَحَدُكُمْ فِي أَخِيهِ الغَائِبِ مَا يَكْرَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلا تَجَسَّسُوا","m":"أي لا تبحثوا عن الأخبار، ومنه سمّي الجاسوس."},{"t":"وَلا يَغْتَبْ بَعْضُكُمْ بَعْضاً","m":"الغيبة: أن يقال في الرّجل من خلفه ما فيه، وإذا استقبل به فتلك المجاهرة. وإذا قيل ما ليس فيه فذلك البهت  وظاهره أن البهت مباين للغيبة لأنه جعله قسيمها، وهو ظاهر الحديث، وأما ما يقتضيه كلامهم فهو أخص منها لأنه قسم منها، والله أعلم."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كثيرا من الظن","m":"وهو أن يظن بأهل الخير سوءا"},{"t":"والتجسس التبحث","m":"والتجسس التبحث"},{"t":"أن يأكل لحم أخيه","m":"لأن ذكرك بالسوء من لم يحضر بمنزلة أكل لحمه وهو ميت لا يحسن بذلك"},{"t":"فكرهتموه","m":"قال الفراء أي فقد كرهتموه فلا تفعلوه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لا تنابزوا بالألقاب","m":"لا تداعوْا بالألقاب المستكرَهة"},{"t":"كثيرًا من الظنّ","m":"هو ظنّ السوء بأهل الخير"},{"t":"لا تجسّـسوا","m":"لا تتبعوا عوْرات المسلمين"},{"t":"فكرهتموه","m":"فقد كرهتموه فلا تفعلوه"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَقَبَائِلَ","m":"القَبِيلَةُ: الجَمَاعَةُ دُونَ الشَّعْبِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"شُعُوباً وَقَبائِلَ","m":"الشّعوب أعظم من القبائل، واحدها شعب، بفتح الشّين، ثم القبائل واحدها قبيلة، ثم العمائر واحدها عمارة، ثم البطون واحدها بطن، ثم الأفخاذ واحدها فخذ، ثم الفصائل واحدها فصيلة، ثم العشائر واحدها عشيرة، وليس بعد العشيرة حي يوصف  وفي تعديدها وترتيبها خلاف ذكرته مبيّنا فيما عملته من «شرح الأربعين النّووية» ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وقبائل","m":"دونها كبكر من ربيعة وتميم من مضر"},{"t":"لتعارفوا","m":"أي من قرب النسب وبعده"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْأَعْرَابُ","m":"البَدْوُ."},{"t":"لَا يَلِتْكُم مِّنْ أَعْمَالِكُمْ","m":"لَا يَنْقُصْكُمْ مِنْ ثَوَابِ أَعْمَالِكُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَلِتْكُمْ","m":"ويألتكم  ، أي ينقصكم، يقال: لات يليت، وألت يألت، لغتان."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"قالت الأعراب آمنا","m":"وهم قوم قدموا المدينة في سنة مجدية فأظهروا الإسلام ولم يكونوا مؤمنين ومنوا على الرسول صلى الله عليه وسلم فقالوا أتيناك"},{"t":"لا يلتكم","m":"وهما لغتان معناهما لا ينقصكم فلما نزلت في حقهم هذه الآيات إلى قوله"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"آمنّـا","m":"صدقنا بقلوبنا و ألسنتنا"},{"t":"لمْ تؤمنوا","m":"لمْ تصدقوا بقلوبكم"},{"t":"أسْلمْـنـَـا","m":"استسلمنا خَوفا و طمعًا"},{"t":"لا يَلتكمْ","m":"لا ينْقصكمْ"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَمْ يَرْتَابُوا","m":"لَمْ يَشُكُّوا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الصادقون","m":"أتوا رسول الله صلى الله عليه وسلم فجعلوا يحلفون أنهم مؤمنون فنزل قوله"}]}]},{"ayah":16,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أتعلمون الله بدينكم","m":"وفيهم نزل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أتعلـّـمون الله بدينكم","m":"أتخبرونه بقوْلكم آمنّا"}]}]}]