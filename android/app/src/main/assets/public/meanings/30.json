ج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَأَثَارُوا","m":"حَرَثُوا وَزَرَعُوا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَثارُوا الْأَرْضَ","m":"قلبوها للزراعة [زه] وقيل: قلبوا وجه الأرض لاستنباط المياه واستخراج المعادن وإلقاء البذور فيها للزّراعة. والإثارة: تحريك الشيء حتى يرتفع ترابه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يسيروا","m":"أي يسافروا"},{"t":"وأثاروا الأرض","m":"قلبوها للزراعة"},{"t":"أكثر مما عمروها","m":"أهل مكة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أثاروا الأرض","m":"حرَثوها و قلـّـبوها للزّراعة"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"السُّوأَى","m":"العُقُوبَةُ المُتَنَاهِيَةُ فيِ السُّوءِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَساؤُا السُّواى","m":"أي جهنّم، والحسنى: الجنة  وقيل:السّوأى: أي العذاب، وهي «فعلى» تأنيث «أفعل» كالحسنى والفضلى. وقيل:السّوأى: مصدر كالرّجعى."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أساؤوا","m":"الخلة السوءى وهي العذاب"},{"t":"أن كذبوا","m":"أي لأن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"السّوآى","m":"العقوبة المُتناهية في السّوء (النار)"}]}]},{"ayah":12,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُبْلِسُ","m":"يَيْئَسُ مِنَ النَّجَاةِ مِنَ العَذَابِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يُبلسُ المجرمون","m":"تنقطع حجّتهم . أو يَيْأسون"}]}]},{"ayah":13,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من شركائهم","m":"يعني الأوثان"},{"t":"شفعاء","m":"في القيامة"},{"t":"كافرين","m":"يتبرأ بعضهم من بعض"}]}]},{"ayah":14,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يتفرقون","m":"إلى الجنة والنار"}]}]},{"ayah":15,"books":[{"name":"السراج