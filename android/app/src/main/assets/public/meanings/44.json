[{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"لَيْلَةٍ مُّبَارَكَةٍ","m":"هِيَ: لَيْلَةُ القَدْرِ مِنْ شَهْرِ رَمَضَانَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لَيْلَةٍ مُبارَكَةٍ","m":"ليلة القدر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"إنا أنزلناه","m":"يعني القرآن و"},{"t":"في ليلة مباركة","m":"وهي ليلة القدر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ليلة مباركة","m":"ليلة القدر من شهر رمضان"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يُفْرَقُ","m":"يُقْضَى وَيُفْصَلُ مِنَ اللَّوْحِ المَحْفُوظِ إِلَى الكَتَبَةِ مِنَ المَلَائِكَةِ."},{"t":"أَمْرٍ حَكِيمٍ","m":"أَمْرٍ مُحْكَمٍ؛ مِنَ الآجَالِ، وَالأَرْزَاقِ، فِي تِلْكَ السَّنَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يفرق","m":"أي يفصل والحكيم بمعنى المحكم قال ابن عباس يكتب في أم الكتاب في ليلة القدر ما هو كائن في السنة من خير وشر"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فيها يُفرق","m":"يفصّل و يُـبَـيّـن"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"فَارْتَقِبْ","m":"انْتَظِرْ بِهَؤُلَاءِ المُشْرِكِينَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"يَوْمَ تَأْتِي السَّماءُ بِدُخانٍ مُبِينٍ","m":"أي جدب. ويقال: إنه الجدب والسنون التي دعا النبي- صلّى الله عليه وسلّم- فيها على مضر، فكان الجائع فيها يرى بينه وبين السّماء دخانا من شدّة الجوع. ويقال: قيل للجدب دخان ليبس الأرض وارتفاع الغبار فشبّه ذلك بالدّخان، وربما وضعت العرب الدّخان في موضع الشّرّ إذا علا، فتقول: كان بيننا أمر ارتفع له دخان."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بدخان مبين","m":"قال ابن مسعود لما دعا النبي صلى الله عليه وسلم على قريش أصابهم قحط حتى أكلوا الميتة فجعل الرجل ينظر إلى السماء فيرى بينه وبين السماء كهيئة الدخان من الجهد وقال غيره هو دخان هو دخان يجيء"},{"t":"قبل القيامة يأخذ بأنفاس الكفار","m":"قبل القيامة يأخذ بأنفاس الكفار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فارتقبْ","m":"انتظر بهؤلاء الشاكّين"},{"t":"بدخان","m":"كناية عن إصابتهم بالجَدْب و المجاعة"}]}]},{"ayah":11,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"يَغْشَى","m":"يَعُمُّ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"يغشى الناس","m":"يشملهم و يحيط بهم"}]}]},{"ayah":13,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَنَّى لَهُمُ الذِّكْرَى","m":"كَيْفَ يَكُونُ لَهُمُ التَّذَكُّرُ وَالاِتِّعَاظُ؟!"},{"t":"رَسُولٌ مُّبِينٌ","m":"بَيِّنُ الرِّسَالَةِ؛ وَهُوَ نَبِيُّنَا مُحَمَّدٌ - صلى الله عليه وسلم -."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الذكرى","m":"التذكير"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أنّى لهم الذكرى؟","m":"كيف يتذكّرون و يتـّـعِظون ؟"}]}]},{"ayah":14,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَوَلَّوْا","m":"أَعْرَضُوا."},{"t":"مُعَلَّمٌ","m":"عَلَّمَهُ بَشَرٌ، أَوْ شَيْطَانٌ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مُعلّم","m":"يعلـّـمه بشر"}]}]},{"ayah":15,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كاشفو العذاب قليلا","m":"أي زمنا يسيرا فعلى قول ابن مسعود كشف عنهم القحط فعادوا إلى الشرك وعلى قول غيره يكشف عنهم الدخان ويعودون إلى عذاب الله"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْبَطْشَةَ الْكُبْرَى","m":"العَذَابَ الأَكْبَرَ يَوْمَ القِيَامَةِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْبَطْشَةَ الْكُبْرى","m":"يوم بدر، ويقال: يوم القيامة. والبطش: أخذ بشدّة."}]},{"name":"تذكرة الأريب في تفسير الغريب"