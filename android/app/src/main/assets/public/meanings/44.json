":23,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فأسر بعبادي ليلا","m":"سِـرْ ليلا ببني إسرائيل"},{"t":"إنكم متبعون","m":"يتبعكم فرعون و جنوده"}]}]},{"ayah":24,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"رَهْوًا","m":"سَاكِنًا غَيْرَ مُضْطَرِبٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَاتْرُكِ الْبَحْرَ رَهْواً إِنَّهُمْ جُنْدٌ مُغْرَقُونَ","m":"رهوا أي ساكنا كهيئته بعد أن ضربه موسى، عليه السلام، وذلك أن موسى لما سأل ربّه- عز وجل- أن يرسل البحر خوفا من فرعون أن يعبر في إثره، قال الله تعالي: وَاتْرُكِ الْبَحْرَ رَهْواً الآية.ويقال: رهوا: منفرجا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"رهوا","m":"أي ساكنا على حاله بعد أن انفرق"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"البحْرَ رهوا","m":"ساكنـًـا . أو منفرجا مفتوحا"},{"t":"جندٌ","m":"جماعة"}]}]},{"ayah":26,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَمَقَامٍ كَرِيمٍ","m":"مَنَازِلَ جَمِيلَةٍ."}]}]},{"ayah":27,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَنَعْمَةٍ","m":"عِيشَةٍ، وَتَنَعُّمٍ."},{"t":"فَاكِهِينَ","m":"نَاعِمِينَ مُتْرَفِينَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"نعمَةٍ","m":"تنعّم أو نضارة عيشٍ و لذاذتِه"},{"t":"فاكهين","m":"ناعمين متفكّهين"}]}]},{"ayah":28,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"قَوْمًا آخَرِينَ","m":"هُمْ: بَنُو إِسْرَائِيلَ؛ خَلَفُوا الأَقْبَاطَ عَلَى بِلَادِهِمْ."}]}]},{"ayah":29,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مُنظَرِينَ","m":"مُؤَخَّرِينَ عَنِ العُقُوبَةِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"فما بكت عليهم السماء","m":"قال علي عليه السلام إذا مات المؤمن بكى"}]},{"name":"كلمات القرآن","