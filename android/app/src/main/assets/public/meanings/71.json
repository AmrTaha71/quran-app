"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ديّـارًا","m":"أحدًا يَدور ة يَتحرّك في الأرض"}]}]},{"ayah":27,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فاجِراً","m":"أي مائلا عن الحقّ. وأصل الفجور: الميل فقيل للكاذب فاجر لأنه مال عن الصّدق، وللفاسق فاجر لأنّه مال عن الحقّ. وقال بعض الأعراب لعمر بن الخطاب- رضي الله عنه. - وكان قد أتاه فشكا إليه نقب إبله ودبرها واستحمله فلم يحمله، فقال:أقسم بالله أبو حفص عمر ... ما مسّها من نقب ولا دبرفاغفر له اللهمّ إن كان فجر أي إن مال عن الصّدق"}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يضلوا عبادك","m":"لما أخبره الله عز وجل أنهم لا يلدون مؤمنا قال هذا"}]}]},{"ayah":28,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"تَبَارًا","m":"هَلَاكًا، وَخُسْرَانًا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَباراً","m":"هلاكا."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تبارا","m":"هلاكا"},{"t":"ولوالدي","m":"قال الحسن كانا مؤمنين"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تبارًا","m":"هَلاكًا وَ دَمارًا"}]}]}]