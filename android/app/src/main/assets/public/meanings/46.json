:"فرغ من تلاوته"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صرفنا إليك","m":"أمَلْـنا ووجهنا نَحْوَك"},{"t":"أنصتوا","m":"اسكتوا و اصغوا لنسمعه"},{"t":"قضِيَ","m":"أتمّ و فُــِرغ من قراءة القرآن"}]}]},{"ayah":31,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"دَاعِيَ اللَّهِ","m":"رَسُولَ اللهِ مُحَمَّدًا - صلى الله عليه وسلم -."},{"t":"وَيُجِرْكُم","m":"يُنْقِذْكُمْ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من ذنوبكم","m":"من صلة"}]}]},{"ayah":32,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِمُعْجِزٍ","m":"بِفَائِتٍ مِنَ اللهِ بِالهَرَبِ."},{"t":"أَولِيَاءُ","m":"أَنْصَارٌ يَمْنَعُونَهُ مِنْ عَذَابِ اللهِ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فليس بمعجزٍ","m":"لله فائت منه بالهَرَب"}]}]},{"ayah":33,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَلَمْ يَعْيَ بِخَلْقِهِنَّ","m":"لَمْ يَعْجِزْ عَنْ خَلْقِهِنَّ، وَلَمْ يَتْعَبْ بِهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بقادر","m":"زائدة أيضا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"لم يعيَ بخلقِهنّ","m":"لم يتعب به أو لم يعجز عنه"}]}]},{"ayah":35,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أُوْلُوا الْعَزْمِ","m":"ذَوُو الثَّبَاتِ وَالصَّبْرِ؛ وَهُمْ: نُوحٌ، وَإِبْرَاهِيمُ، وَمُوسَى، وَعِيسَى، وَمُحَمَّدٌ؛ عَلَيْهِمُ الصَّلَاةُ وَالسَّلَامُ."},{"t":"وَلَا تَسْتَعْجِل لَّهُمْ","m":"لَا تَتَعَجَّلْ بِطَلَبِ عُقُوبَتِهِمْ."},{"t":"بَلَاغٌ","m":"هَذَا تَبْلِيغٌ مِنَ اللهِ لَهُمْ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أُولُوا الْعَزْمِ مِنَ الرُّسُلِ","m":"نوح، وإبراهيم، وموسى، وعيسى، ومحمد صلّى الله عليه وسلّم [زه] وفيهم أقوال أخر."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":