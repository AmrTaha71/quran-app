[{"ayah":2,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"علـّـمَ القرآن","m":"عَـلـّـم الإنسان القرآن"}]}]},{"ayah":3,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الإنسان","m":"اسم جنس"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْبَيَانَ","m":"النُّطْقَ بِأَنْ يُبِينَ عَمَّا فِي نَفْسِهِ بِالنُّطْقِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"البيان","m":"النطق والتمييز"}]}]},{"ayah":5,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِحُسْبَانٍ","m":"يَجْرِيَانِ مُتَعَاقِبَيْنِ، بِحِسَابٍ مُتْقَنٍ لَا يَضْطَرِبُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"بِحُسْبانٍ","m":"أي بحساب. ويقال: جمع حساب، مثل شهاب وشهبان."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بحسبان","m":"بحساب"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بحُـسبان","m":"يجريان بحساب مقدّر في بروجهما"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَالنَّجْمُ","m":"الكَوْكَبُ فِي السَّمَاءِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدانِ","m":"النّجم: ما نجم من الأرض، أي طلع ولم يكن على ساق كالعشب والبقل. والشّجر: ما قام على ساق. وسجودهما: أنها يستقبلان الشّمس إذا طلعت ويميلان معها حتى ينكسر الفيء، والسّجود من جميع الموات: الاستسلام والانقياد لما سخّر له [زه] وليس فيه شيء من الامتناع عن المراد به."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"والنجم","m":"كل نبت ليس له ساق وقيل نجم السماء وسجود مالا مبين في النحل"},{"t":"والهباء المنبث ما سطع من سنابك","m":"والهباء المنبث ما سطع من سنابك الخيل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"النّجم","m":"النبات الذي ينجم و لا ساق له"},{"t":"يسجدان","m":"ينقادان لله فيما خُـلِقا له"}]}]},{"ayah":7,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَوَضَعَ الْمِيزَانَ","m":"وَضَعَ فِي الأَرْضِ العَدْلَ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"وضع الميزان","m":"شرَع العدل و أمر به الخلق"}]}]},{"ayah":8,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَلَّا تَطْغَوْا","m":"لِئَلَّا تَعْتَدُوا، وَتَخُونُوا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَلَّا تَطْغَوْا فِي الْمِيزانِ","m":"تجاوزوا القدر والعدل."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الميزان","m":"العدل"},{"t":"ألا تطغوا","m":"أي لئلا تجاوزوا العدل"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"ألا تطْغَوْا","m":"لئلاّ تتجاوزوا العدل و الحقّ"}]}]},{"ayah":9,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِالْقِسْطِ","m":"بِالعَدْلِ."},{"t":"وَلَا تُخْسِرُوا","m":"وَلَا تَنْقُصُوا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَلا تُخْسِرُوا الْمِيزانَ","m":"لا تنقصوا الوزن. وقرئت وَلا تُخْسِرُوا الْمِيزانَ  بفتح التاء: أي لا تخسروا الثواب الموزون يوم القيامة."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"تخسروا","m":"تنقصوا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بالقسْط","m":"بالعدْل"},{"t":"لا تـُـخْـسِروا الميزان","m":"لا تنقصوا مَوْزون الميزان"}]}]},{"ayah":10,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَضَعَهَا لِلْأَنَامِ","m":"مَهَّدَهَا؛ لِيَسْتَقِرَّ عَلَيْهَا الخَلْقُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"لِلْأَنامِ","m":"للخلق [زه] بلغة جرهم  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"للأنام","m":"الناس"}]},{"name":"كلمات الق