":"هُوَ الطِّينُ الَّذِي يُطْبَخُ لِيَتَحَجَّرَ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"كالفخار","m":"ما طبخ بالنار فخلقه من طين يابس فهو من يبسه كالفخار"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"صلصال","m":"طين يابس يُسمع له صلصلة"},{"t":"كالفخّار","m":"هو الطين يُحرَق حتى يتحجّر"}]}]},{"ayah":15,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْجَانَّ","m":"إِبْلِيسَ."},{"t":"مَّارِجٍ مِّن نَّارٍ","m":"لَهَبِ النَّارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مِنْ مارِجٍ مِنْ نارٍ","m":"المارج هنا: لهب النار، من قولك: مرج الشيء إذا اضطرب ولم يستقرّ. ويقال: مِنْ مارِجٍ مِنْ نارٍ: أي من خليط من النّار، أي من نوعين من النار خلطا، من قولك: مرجت الشّيئين، إذ خلطت أحدهما بالآخر."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مارج","m":"لهبٍ صافٍ لا دخان فيه"}]}]},{"ayah":16,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"آلَاءِ رَبِّكُمَا","m":"نِعَمِ رَبِّكُمَا."},{"t":"تُكَذِّبَانِ","m":"يَا مَعْشَرَ الإِنْسِ وَالِجنِّ."}]}]},{"ayah":17,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْمَشْرِقَيْنِ","m":"مَشْرِقِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."},{"t":"الْمَغْرِبَيْنِ","m":"مَغْرِبِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ","m":"المشرقان: مشرقا الصّيف والشتاء، والمغربان: مغرباهما."}]}]},{"ayah":18,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"تكذبان","m":"تكفران أيها الثقلان"}]}]},{"ayah":19,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مَرَجَ الْبَحْرَيْنِ","m":"خَلَطَ مَاءَ البَحْرَيْنِ: العَذْبَ، وَالمَالِحَ."}]},{"name":"تذكرة الأريب في تفسير