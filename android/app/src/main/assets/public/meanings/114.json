[{"ayah":1,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"بِرَبِّ النَّاسِ","m":"مُرَبِّيهِمْ، وَخَالِقِهِمْ، وَمُدَبِّرِ أَحْوَالِهِمْ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بربّ النـّـاس","m":"مُرَبِّـيهِمْ ومُدبّر أحوالهم"}]}]},{"ayah":2,"books":[{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"مَـلِـكِ النّـاس","m":"مالِكِهِمْ مِلـْـكًـا تـامّـا"}]}]},{"ayah":3,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"إِلَهِ النَّاسِ","m":"مَعْبُودِهِمُ الحَقِّ."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"إله النّاس","m":"مَعْبُودِهِم الحقّ"}]}]},{"ayah":4,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْوَسْوَاسِ","m":"الشَّيْطَانِ الَّذِي يُلْقِي شُكُوكَهُ وَأَبَاطِيلَهُ فيِ القُلُوبِ عِنْدَ الغَفْلَةِ."},{"t":"الْخَنَّاسِ","m":"الَّذِي يَخْتَفِي وَيَهْرُبُ عِنْدَ ذِكْرِ اللهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْوَسْواسِ","m":"الشّيطان وهو الْخَنَّاسِ [4] أيضا يعني الشيطان الذي يوسوس في الصّدور، وجاء في التفسير: أنّ له رأسا كرأس الحيّة يجثم على القلب يوسوس فيه فإذا ذكر الله- عز وجل- العبد خنس، أي تأخّر وتنحّى. وإذا ترك ذكر الله رجع إلى القلب فوسوس فيه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الوسواس","m":"الشيطان وهو"},{"t":"الخناس","m":"يوسوس في الصدور فإذا ذكر الله خنس أي كف"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الوَسواس","m":"المُوَسْوس جـِنـِّـيّـا أو إنـْـسِـيّـا"},{"t":"الخنّاس","m":"المُـتـَوَاري المُـخْـتـَفي"}]}]},{"ayah":6,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"مِنَ الْجِنَّةِ وَالنَّاسِ","m":"المُوَسْوِسُ يَكُونُ جَنِّيًّا وَإِنْسِيًّا، أَوِ المُوَسْوَسُ فِيهِمْ مِنَ الجِنَّةِ وَالنَّاسِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْجِنَّةِ","m":"أي الجنّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الجنة","m":"الجن والمعنى من شر الوسواس الذي هو من الجن ثم عطف الناس على الوسواس فالمعنى من شر الوسواس ومن شر الناس كأنه أمر بالاستعاذة من الإنس والجن"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"الجـِنّة","m":"الجـِـنّ"}]}]}]