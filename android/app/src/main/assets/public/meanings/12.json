","words":[{"t":"مَثْوَاهُ","m":"مَقَامَهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"مَثْواهُ","m":"مقامه  ."},{"t":"نَتَّخِذَهُ وَلَداً","m":"نتبنّاه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"الذي اشتراه من مصر","m":"قطفير وكان خازن الملك وكان مؤمنا"},{"t":"لامرأته","m":"زليخا"},{"t":"مثواه","m":"مقامه عندك"},{"t":"عسى أن ينفعنا","m":"يكفينا امورنا اذا بلغ"},{"t":"والله غالب على أمره","m":"حتى يبلغه ما اراده له"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أكرمي مثواه","m":"اجعلي محلّ إقامته كريما مرضيّا"},{"t":"غالب على أمره","m":"لا يقهره شيء ، و لا يدفعه عنه أحد"}]}]},{"ayah":22,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَشُدَّهُ","m":"مُنْتَهَى قُوَّتِهِ فِي شَبَابِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَشُدَّهُ","m":"منتهى شبابه. وقوّته وسبق الخلاف في إفراده وجمعه وفي واحده  . وعن مجاهد قال: ثلاثا وثلاثين سنة   ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"يا بشرى","m":"المعنى ابشروا"},{"t":"أشده","m":"ثماني عشر سنة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"بلغ أشدّه","m":"مُنتهى شدّة جسمه و قوّته"}]}]},{"ayah":23,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَرَاوَدَتْهُ","m":"دَعَتْهُ إِلَى نَفْسِهَا بِرِفْقٍ وَلِينٍ."},{"t":"هَيْتَ لَكَ","m":"هَلُمَّ إِلَيَّ."},{"t":"مَعَاذَ اللهِ","m":"أَعْتَصِمُ بِاللهِ."},{"t":"رَبِّي","m":"سَيِّدِي."},{"t":"مَثْوَايَ","m":"مَنْزِلِي وَمُقَامِي."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَراوَدَتْهُ","m":"أي طلبته أن يواقعها. وأصله من راد يرود: إذا جاء وذهب، ومنه: الرائد إذا جال في الصحراء لطلب الماء."},{"t":"هَيْتَ لَكَ","m":"هلمّ، أي أقبل إلى ما أدعوك إليه  وقيل:هَيْتَ لَكَ: أي إرادتي بهذا لك وقرئت هَيْتَ لَكَ  : أي تهيّأت لك."},{"t":"مَعاذَ اللَّهِ","m":"ومعاذة الله وعوذ الله وعياذ الله بمعنى واحد: أي أستجير بالله."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وراودته","m":"أي ارادته على ما تريد"},{"t":"هيت لك","m":"أي"},{"t":"معاذ الله","m":"أي اعود بالله ان افعل هذا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"راودته","m":"تمحّنت لمُواقعته إياها"},{"t":"هيت لك","m":"أقبِل ، أسرع – إرادتي لك"},{"t":"معاذ الله","m":"أعوذ بالله معاذا مما دعوتني إليه"}]}]},{"ayah":24,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"هَمَّتْ بِهِ","m":"مَالَتْ نَفْسُهَا لِفِعْلِ الفَاحِشَةِ."},{"t":"وَهَمَّ بِهَا","m":"خَطَرَ بِقَلْبِهِ إِجَابَتُهَا."},{"t":"بُرْهَانَ رَبِّهِ","m":"آيَةً مِنَ اللهِ زَجَرَتْهُ عَنْ ذَلِكَ الخَاطِرِ."},{"t":"الْمُخْلَصِينَ","m":"الَّذِينَ أَخْلَصُوا فِي عِبَادَةِ اللهِ؛ فَأَخْلَصَهُمْ، وَاخْتَصَّهُمْ بِرَحْمَتِهِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"لولا أن رأى برهان ربه","m":"المعنى لامضى ما هم به والبرهان حجة الله عليه"},{"t":"كذلك","m":"اريناه البرهان"},{"t":"لنصرف عنه السوء","m":"وهي خيانة صاحبه"},{"t":"والفحشاء","m":"ركوب الفاحشة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"همّ بها","m":"همّ الطّباع البشرية مع العصمة"},{"t":"المُخلصين","m":"المُختارين لطاعته أو لرسالته"}]}]},{"ayah":25,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَاسُتَبَقَا الْبَابَ","m":"أَسْرَعَا إِلَى البَابِ يُرِيدُ الخُرُوجَ وَهِيَ تَمْنَعُهُ."},{"t":"وَقَدَّتْ","m":"شَقَّتْ."},{"t":"وَأَلْفَيَا","m":"وَجَدَا."},{"t":"سَيِّدَهَا","m":"زَوْجَهَا."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَأَلْفَيا سَيِّدَها","m":"يعني وجدا زوجها. والسّيّد: الرئيس أيضا، والذي تفوّق في الخير قومه، والمالك."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"استبقا الباب","m":"تسابقا إليه يريد الخروج و هي تمنعه"},{"t":"قدّت قميصه","m":"قطعته و شقّته"},{"t":"ألفيا سيّدها","m":"وجدا زوجها"}]}]},{"ayah":26,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"قُدَّ مِن قُبُلٍ","m":"شُقَّ مِنَ الأَمَامِ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"وشهد شاهد من أهلها","m":"وهو صبي في المهد"}]}]},{"ayah":29,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الْخَاطِئِينَ","m":"الآثِمِينَ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"الْخاطِئِينَ","m":"قال أبو عبيدة: خطئ وأخطأ واحد  ، وقال غيره:خطئ في الدين وأخطأ في كلّ شيء، إذا سلك  سبيل خطأ عامدا أو غير عامد."}]}]},{"ayah":30,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"شَغَفَهَا حُبًّا","m":"بَلَغَ حُبُّهَا لَهُ شَغَافَ قَلْبِهَا وَهُوَ غِلَافُهُ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَتاها","m":"مملوكها  ، والعرب تسمي المملوك فتى ولو كان شيخا."},{"t":"شَغَفَها حُبًّا","m":"أي أصاب حبّه شغاف قلبها كما تقول كبده، إذا أصاب كبده، ورأسه، إذا أصاب رأسه. والشّغاف: غلاف القلب، ويقال: حبّة القلب، وهي علقة سوداء في صميمه.وشعفها حبّا  : ارتفع حبّه إلى أعلى موضع من قلبها، مشتق من شعاف الجبال أي رؤوسهن. وقولهم: فلان مشعوف بفلان: أي ذهب به الحبّ أقصى المذاهب"}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"أنه","m":"فيه قولان احدهما انه عنى الله عز وجل والثاني العزيز"},{"t":"شغفها","m":"أي بلغ حبه شغاف قلبها"}]}]},{"ayah":31,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"وَأَعْتَدَتْ","m":"هَيَّأَتْ."},{"t":"مُتَّكَأً","m":"مَا يَتَّكِئْنَ عَلَيْهِ مِنَ الوَسَائِدِ."},{"t":"وَقَطَّعْنَ","m":"جَرَحْنَ."},{"t":"حَاشَ لِلّهِ","m":"تَنْزِيهًا لِله."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"وَأَعْتَدَتْ","m":"أي وأعدّت من العتيد وهو المعدّ لهن."},{"t":"مُتَّكَأً","m":"نمرقا يتّكا عليه، وقيل: مجلسا يتّكأ فيه، وقيل:طعاما. وقرئت مُتَّكَأً  وهو الأترجّ. والمتكأ: الأترجّ بلغة توافق لغة القبط  .وقيل البزماورد. والبزماورد أعجمي، وقد يعرّب فيقال فيه إذا عرّب الزّماورد «7» ."},{"t":"أَكْبَرْنَهُ","m":"أعظمنه."},{"t":"حاشى لله و حاشَ لِلَّهِ","m":"قال المفسّرون: معاذ الله. وقال اللغويون في حاشَ لِلَّهِ له معنيان: التّنزيه والاستثناء واشتقاقه من قولك كنت في حشى فلان، أي في ناحيته، ولا أدري أيّ الحشى آخذ، أي أيّ الناحية آخذ، قال الشاعر:يقول الذي أمسى إلى الحزن أهله بأيّ الحشى أمسى الخليط المباين  وقولهم: حاشى فلانا معناه: أعزل فلانا من وصف القوم بالحشى ولا أدخله فيهم وفي جملتهم  يعني من نحو قولك: قام القوم حاشى فلانا، ويقال: حاشى لفلان وحاشى فلانا وحاشى فلان، فمن نصب [فلانا]  أضمر في حاشى مرفوعا، والتّقدير: حاشى فعلهم فلانا، ومن خفض [فلانا]  فبإضمار اللّام لطول صحبتها حاشى. وجواب آخر: لمّا خلت «حاشى» من الصاحب أشبهت الاسم فأضيفت إلى ما بعدها. والتّحقيق أنّ «حاشا» إن نصبت كانت فعلا، وإن خفضت كانت حرف جرّ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"بمكرهن","m":"أي بعيبهم لها"},{"t":"وأعتدت","m":"اعدت والمتكأ الوسائد ومن سكن التء اراد الاترج"},{"t":"وقالت اخرج","m":"واضمرت في نفسها"},{"t":"أكبرنه","m":"اعظمنه"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"شهد شاهد","m":"صبيّ في المهد أنطقه الله ببراءته"},{"t":"أعتدت لهن مُـتـّكأ","m":"هيّأت لهنّ ما يتّكئن عليه"},{"t":"أكبرنه","m":"دهشن برؤية جماله الرائع"},{"t":"قطّعن أيديهنّ","m":"خدشنها بالسّكاكين لفرط ذهولهنّ و دهشتهنّ"},{"t":"حاش لله","m":"تنزيها لله عن العجز عن خلق مثله"}]}]},{"ayah":32,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"الصَّاغِرِينَ","m":"الأَذِلَّاءِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَاسْتَعْصَمَ","m":"امتنع."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"فاستعصم","m":"فامتنع امتناعا شديدا و أبى"}]}]},{"ayah":33,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَصْبُ إِلَيْهِنَّ","m":"أَمِلْ إِلَيْهِنَّ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"أَصْبُ إِلَيْهِنَّ","m":"أميل إليهن، يقال: أصباني فصبوت  ، أي حملني على الجهل وعلى ما يفعل الصّبيّ ففعلت."}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أصبوا إليهنّ","m":"أمِلْ إلى إجابتهنّ"}]}]},{"ayah":35,"books":[{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"من بعد ما رأوا الآيات","m":"وهي شق القميص وكلام الطفل"}]}]},{"ayah":36,"books":[{"name":"السراج في بيان غريب القرآن","author":"محمد بن عبد العزيز الخضيري","words":[{"t":"أَعْصِرُ خَمْرًا","m":"أَعْصِرُ عِنَبًا؛ لِيَصِيرَ خَمْرًا."},{"t":"بِتَاوِيلِهِ","m":"بِتَفْسِيرِهِ."}]},{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"فَتَيانِ","m":"مملوكان، والعرب تسمّي المملوك شابّا كان أو شيخا فتى، ومنه تُراوِدُ فَتاها عَنْ نَفْسِهِ [30] : أي عبدها."},{"t":"أَعْصِرُ خَمْراً","m":"أي أستخرج الخمر لأنه إذا عصر العنب فإنه يستخرج منه الخمر. ويقال: الخمر: العنب بعينه، حكى الأصمعي عن معتمر  بن سليمان قال: لقيت أعرابيّا ومعه عنب، فقلت له: ما معك؟ فقال: خمر  ."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"خمرا","m":"أي عنبا"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"أعصر خمرا","m":"عنبا يؤول لخمر أسقيه الملك"}]}]},{"ayah":37,"books":[{"name":"التبيان في تفسير غريب القرآن","author":"ابن الهائم","words":[{"t":"تَرَكْتُ مِلَّةَ قَوْمٍ لا يُؤْمِنُونَ بِاللَّهِ","m":"أي رغبت عنها. والتّرك علىضربين: أحدهما: مفارقة ما يكون الإنسان فيه. والآخر: ترك الشيء رغبة عنه من غير ملابسة له ولا دخول كان فيه."}]},{"name":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي","words":[{"t":"طعام ترزقانه","m":"أي في اليقظة"},{"t":"إلا نبأتكما","m":"به قبل ان يصل وقيل ترزقانه في النوم"},{"t":"إلا نبأتكما بتأويله","m":"قبل ان ياتيكما في اليقظة"}]},{"name":"كلمات القرآن","author":"حسنين محمد مخلوف","words":[{"t":"شغفها حُـبّا","m":"شقّ حُبُه سويداء قلبها"},{"t":"ذ لكما","m":"التأويل و الإخبار بما يأتي"}]}]},{"ayah":39,"books":[{"name":"ا